@model IEnumerable<PROTOTIPO.Models.Pago>

@{
    ViewData["Title"] = "Estado de Cuenta";
}

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
        --gac-success: #22c55e;
        --gac-warning: #f59e0b;
        --gac-danger: #ef4444;
    }

    .cuenta-page {
        background: #f4f6fb;
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #fff;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 24px rgba(15, 22, 35, 0.15);
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .page-header p {
            color: rgba(255,255,255,0.65);
            margin-bottom: 0;
        }

    /* ACTION BUTTONS */
    .quick-links {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .btn-gac-primary, .btn-gac-secondary {
        font-weight: 600;
        border-radius: 10px;
        padding: 0.6rem 1.25rem;
        transition: all 0.2s ease;
    }

    .btn-gac-primary {
        background: var(--gac-primary);
        border: none;
        color: #fff;
    }

        .btn-gac-primary:hover {
            background: var(--gac-primary-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 140, 251, 0.35);
        }

    .btn-gac-secondary {
        border: 1.5px solid #e2e8f0;
        color: #64748b;
        background: #fff;
    }

        .btn-gac-secondary:hover {
            border-color: var(--gac-primary);
            color: var(--gac-primary);
            background: #fff;
        }

    /* SUMMARY CARDS */
    .summary-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        padding: 1.5rem;
        text-align: center;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-top: 4px solid var(--gac-primary);
    }

        .summary-card.summary-warning {
            border-top-color: var(--gac-warning);
        }

        .summary-card.summary-danger {
            border-top-color: var(--gac-danger);
        }

        .summary-card.summary-success {
            border-top-color: var(--gac-success);
        }

        .summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15, 22, 35, 0.06);
        }

        .summary-card .summary-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .summary-card .summary-value {
            font-size: 1.85rem;
            font-weight: 800;
        }

        .summary-card.summary-success .summary-value {
            color: var(--gac-success);
        }

        .summary-card.summary-warning .summary-value {
            color: var(--gac-warning);
        }

        .summary-card.summary-danger .summary-value {
            color: var(--gac-danger);
        }

    /* PAYMENT CARDS */
    .pago-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        height: 100%;
        padding: 1.5rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        position: relative;
        overflow: hidden;
    }

        .pago-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
            background: var(--gac-primary);
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .pago-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(15, 22, 35, 0.08);
            border-color: transparent;
        }

            .pago-card:hover::before {
                opacity: 1;
            }

        .pago-card .pago-tipo {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .pago-card .pago-monto {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--gac-navy);
            margin-bottom: 0.75rem;
        }

    .badge-estado {
        font-weight: 600;
        font-size: 0.78rem;
        padding: 0.4rem 0.85rem;
        border-radius: 50px;
        letter-spacing: 0.02em;
    }

    .badge-completado {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
    }

    .badge-pendiente {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .badge-atrasado {
        background: rgba(239, 68, 68, 0.12);
        color: #b91c1c;
    }

    .badge-default {
        background: rgba(15, 22, 35, 0.08);
        color: var(--gac-navy);
    }

    .pago-meta {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid #f1f4f9;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 500;
    }

        .pago-meta span {
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }

    /* EMPTY STATE */
    .empty-state {
        background: #fff;
        border-radius: 16px;
        border: 1px dashed #d8e0ee;
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

        .empty-state i {
            font-size: 2.75rem;
            color: #cbd5e1;
            margin-bottom: 1rem;
        }

        .empty-state h5 {
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0;
        }
</style>

<div class="cuenta-page">
    <div class="container py-4">

        <!-- HEADER -->
        <div class="page-header">
            <h3 class="mb-1">Estado de Cuenta</h3>
            <p>Resumen de tus pagos de alquiler</p>
            <div class="unidad-badge">
                <i class="fa-solid fa-building"></i>
                Unidad: @ViewBag.Unidad
            </div>
        </div>

        <!-- QUICK LINKS -->
        <div class="quick-links">
            <a asp-action="MisDeudas" class="btn btn-gac-primary">
                <i class="fa-solid fa-file-invoice me-2"></i>
                Mis Deudas
            </a>
            <a asp-action="Historial" class="btn btn-gac-secondary">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>
                Historial de Pagos
            </a>
        </div>

        <!-- CARDS RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="summary-card summary-success">
                    <div class="summary-label">Total Pagado</div>
                    <div class="summary-value">RD$ @ViewBag.TotalPagado</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-card summary-warning">
                    <div class="summary-label">Pendiente</div>
                    <div class="summary-value">RD$ @ViewBag.Pendiente</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-card summary-danger">
                    <div class="summary-label">Atrasado</div>
                    <div class="summary-value">RD$ @ViewBag.Atrasado</div>
                </div>
            </div>

        </div>

        <!-- LISTADO -->
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-regular fa-credit-card"></i>
                <h5>No tienes pagos registrados</h5>
            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var item in Model
                    .OrderByDescending(p => p.EstadoPago == "Atrasado")
                    .ThenByDescending(p => p.EstadoPago == "Pendiente")
                    .ThenByDescending(p => p.Fecha))
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="pago-card">

                            <div class="pago-tipo">@item.TipoPago</div>

                            <div class="pago-monto">RD$ @item.Monto?.ToString("N0")</div>

                            @if (item.EstadoPago == "Completado")
                            {
                                <span class="badge-estado badge-completado">Completado</span>
                            }
                            else if (item.EstadoPago == "Pendiente")
                            {
                                <span class="badge-estado badge-pendiente">Pendiente</span>
                            }
                            else if (item.EstadoPago == "Atrasado")
                            {
                                <span class="badge-estado badge-atrasado">Atrasado</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-default">@item.EstadoPago</span>
                            }

                            <div class="pago-meta">
                                <span>
                                    <i class="fa-regular fa-calendar"></i>
                                    @item.Fecha?.ToString("dd/MM/yyyy")
                                </span>
                                <span>
                                    <i class="fa-regular fa-credit-card"></i>
                                    @item.MetodoPago
                                </span>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
</div>
