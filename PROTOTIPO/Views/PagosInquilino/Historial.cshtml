@model IEnumerable<PROTOTIPO.Models.Pago>

@{
    ViewData["Title"] = "Historial de Pagos";
}

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
    }

    .historial-page {
        background: #f4f6fb;
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #fff;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 24px rgba(15, 22, 35, 0.15);
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0;
        }

    /* FILTER CARD */
    .filter-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .filter-card .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 0.4rem;
        }

        .filter-card .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.55rem 0.9rem;
        }

            .filter-card .form-select:focus {
                border-color: var(--gac-primary);
                box-shadow: 0 0 0 3px rgba(37, 140, 251, 0.12);
            }

    .btn-gac-primary {
        background: var(--gac-primary);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.55rem 1.25rem;
        transition: all 0.2s ease;
    }

        .btn-gac-primary:hover {
            background: var(--gac-primary-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 140, 251, 0.35);
        }

    /* TABLE CARD */
    .table-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        overflow: hidden;
    }

        .table-card table {
            margin-bottom: 0;
        }

        .table-card thead {
            background: #f8fafc;
        }

            .table-card thead th {
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #94a3b8;
                font-weight: 700;
                border-bottom: 1px solid #eef1f6;
                padding: 1rem 1.25rem;
            }

        .table-card tbody td {
            padding: 1rem 1.25rem;
            color: #334155;
            vertical-align: middle;
            border-bottom: 1px solid #f1f4f9;
        }

        .table-card tbody tr:last-child td {
            border-bottom: none;
        }

        .table-card tbody tr {
            transition: background 0.15s ease;
        }

            .table-card tbody tr:hover {
                background: #f8fafc;
            }

    .badge-tipo {
        background: rgba(15, 22, 35, 0.06);
        color: var(--gac-navy);
        font-weight: 600;
        font-size: 0.78rem;
        padding: 0.4rem 0.85rem;
        border-radius: 50px;
    }

    .badge-estado {
        font-weight: 600;
        font-size: 0.78rem;
        padding: 0.4rem 0.85rem;
        border-radius: 50px;
        letter-spacing: 0.02em;
    }

    .badge-completado {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
    }

    .badge-pendiente {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .badge-atrasado {
        background: rgba(239, 68, 68, 0.12);
        color: #b91c1c;
    }

    .monto-cell {
        font-weight: 700;
        color: var(--gac-navy);
    }

    /* EMPTY STATE */
    .empty-state {
        background: #fff;
        border-radius: 16px;
        border: 1px dashed #d8e0ee;
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

        .empty-state i {
            font-size: 2.75rem;
            color: #cbd5e1;
            margin-bottom: 1rem;
        }

        .empty-state h5 {
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0;
        }
</style>

<div class="historial-page">
    <div class="container py-4">

        <!-- HEADER -->
        <div class="page-header">
            <h3>Historial de Pagos</h3>
        </div>

        <!-- FILTROS -->
        <div class="filter-card">
            <form method="get" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Tipo de Pago</label>
                    <select name="tipoPago" class="form-select">
                        <option value="">Todos</option>
                        <option value="Alquiler" selected="@(ViewBag.TipoPago == "Alquiler")">Alquiler</option>
                        <option value="Mantenimiento" selected="@(ViewBag.TipoPago == "Mantenimiento")">Mantenimiento</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select name="estadoPago" class="form-select">
                        <option value="">Todos</option>
                        <option value="Completado" selected="@(ViewBag.EstadoPago == "Completado")">Pagado</option>
                        <option value="Pendiente" selected="@(ViewBag.EstadoPago == "Pendiente")">Pendiente</option>
                        <option value="Atrasado" selected="@(ViewBag.EstadoPago == "Atrasado")">Atrasado</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-gac-primary w-100">
                        <i class="fa-solid fa-filter me-2"></i>
                        Filtrar
                    </button>
                </div>

            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-regular fa-rectangle-list"></i>
                <h5>No tienes pagos registrados</h5>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Método</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="badge-tipo">@item.TipoPago</span>
                                    </td>

                                    <td class="monto-cell">
                                        RD$ @item.Monto?.ToString("N0")
                                    </td>

                                    <td>
                                        @if (item.EstadoPago == "Completado")
                                        {
                                            <span class="badge-estado badge-completado">Completado</span>
                                        }
                                        else if (item.EstadoPago == "Pendiente")
                                        {
                                            <span class="badge-estado badge-pendiente">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge-estado badge-atrasado">@item.EstadoPago</span>
                                        }
                                    </td>

                                    <td>
                                        @item.Fecha?.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.MetodoPago
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>
        }

    </div>
</div>
