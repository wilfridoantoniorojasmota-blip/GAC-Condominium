@using PROTOTIPO.Models.ViewModels

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GAC Condominium</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<style>
    :root {
        --gac-blue: #258cfb;
        --gac-blue-dark: #1a6fcf;
        --gac-blue-light: #4dabf7;
        --gac-sidebar-bg: #0f1623;
        --gac-sidebar-surface: #1a2335;
        --gac-sidebar-border: rgba(255,255,255,0.07);
        --gac-sidebar-muted: #7a8ea8;
        --gac-sidebar-text: #cbd5e1;
        --gac-radius: 10px;
        --gac-radius-sm: 7px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #f0f4f9;
        margin: 0;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* ── LAYOUT ── */
    .layout {
        display: flex;
        min-height: 100vh;
    }

    /* ══ SIDEBAR ══ */
    .sidebar {
        width: 250px;
        background: var(--gac-sidebar-bg);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        padding: 0;
    }

    /* Brand */
    .sidebar-brand {
        padding: 1.4rem 1.25rem 1.1rem;
        border-bottom: 1px solid var(--gac-sidebar-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: linear-gradient(135deg, #1a6fcf, #4dabf7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(37,140,251,.35);
    }

    .brand-text .brand-name {
        font-size: .95rem;
        font-weight: 700;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -.2px;
    }

    .brand-text .brand-sub {
        font-size: .68rem;
        color: var(--gac-sidebar-muted);
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    /* Nav section label */
    .nav-label {
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: var(--gac-sidebar-muted);
        padding: 1.2rem 1.25rem .4rem;
    }

    /* Nav */
    .sidebar-nav {
        list-style: none;
        margin: 0;
        padding: 0 .75rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: .6rem .85rem;
            border-radius: var(--gac-radius-sm);
            color: var(--gac-sidebar-text);
            text-decoration: none;
            font-size: .85rem;
            font-weight: 500;
            transition: background .15s, color .15s;
            position: relative;
        }

            .sidebar-nav a:hover {
                background: rgba(255,255,255,.06);
                color: #fff;
            }

            .sidebar-nav a.active {
                background: rgba(37,140,251,.15);
                color: #fff;
            }

                .sidebar-nav a.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    border-radius: 0 3px 3px 0;
                    background: var(--gac-blue);
                }

            .sidebar-nav a .nav-icon {
                width: 30px;
                height: 30px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .85rem;
                flex-shrink: 0;
                transition: background .15s;
            }

            .sidebar-nav a:hover .nav-icon,
            .sidebar-nav a.active .nav-icon {
                background: rgba(37,140,251,.2);
                color: var(--gac-blue-light);
            }

            .sidebar-nav a .nav-icon {
                background: rgba(255,255,255,.05);
                color: var(--gac-sidebar-muted);
            }

    /* User footer */
    .sidebar-footer {
        margin-top: auto;
        padding: 1rem .75rem;
        border-top: 1px solid var(--gac-sidebar-border);
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: .6rem .85rem;
        border-radius: var(--gac-radius-sm);
        background: rgba(255,255,255,.04);
        margin-bottom: .75rem;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #258cfb, #4dabf7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    .user-name {
        font-size: .82rem;
        font-weight: 600;
        color: #fff;
        line-height: 1.1;
    }

    .user-role {
        font-size: .7rem;
        color: var(--gac-sidebar-muted);
    }

    .btn-logout {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: .5rem;
        border-radius: var(--gac-radius-sm);
        background: transparent;
        border: 1px solid rgba(255,255,255,.12);
        color: var(--gac-sidebar-muted);
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
        font-family: inherit;
    }

        .btn-logout:hover {
            background: rgba(239,68,68,.1);
            border-color: rgba(239,68,68,.3);
            color: #fca5a5;
        }

    /* ══ MAIN ══ */
    .main-wrap {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    /* Topbar */
    .topbar {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: .75rem 1.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .topbar-date {
        font-size: .78rem;
        color: #64748b;
        font-weight: 500;
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .topbar-bell {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #f0f4f9;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        cursor: pointer;
        position: relative;
        transition: background .15s;
    }

        .topbar-bell:hover {
            background: #e8f4ff;
            color: #258cfb;
        }

    .bell-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 7px;
        height: 7px;
        background: #ef4444;
        border-radius: 50%;
        border: 1.5px solid #fff;
    }

    /* Page content */
    .page-content {
        padding: 1.75rem;
        flex-grow: 1;
    }
</style>

<body>
    <div class="layout">

        <!-- ══ SIDEBAR ══ -->
        <aside class="sidebar">

            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div class="brand-text">
                    <div class="brand-name">
                        <span style="color:var(--gac-blue-light);">GAC</span> Condo
                    </div>
                    <div class="brand-sub">Residencial</div>
                </div>
            </div>

            <!-- Nav label -->
            <div class="nav-label">Menú principal</div>

            <!-- Nav items -->
            <ul class="sidebar-nav">

                <li>
                    <a class="active" asp-controller="Inquilino" asp-action="Index">
                        <span class="nav-icon">
                            <i class="fa-solid fa-house"></i>
                        </span>
                        Inicio
                    </a>
                </li>

                <li>
                    <a asp-controller="Inquilino" asp-action="MiUnidad">
                        <span class="nav-icon">
                            <i class="fa-solid fa-building"></i>
                        </span>
                        Mi Unidad
                    </a>
                </li>

                <li>
                    <a asp-controller="PagosInquilino" asp-action="Index">
                        <span class="nav-icon">
                            <i class="fa-solid fa-credit-card"></i>
                        </span>
                        Pagos
                    </a>
                </li>

                <li>
                    <a asp-controller="AvisosInquilino" asp-action="Index">
                        <span class="nav-icon">
                            <i class="fa-solid fa-bell"></i>
                        </span>
                        Avisos
                    </a>
                </li>

                <li>
                    <a asp-controller="DocumentoInquilino" asp-action="Index">
                        <span class="nav-icon">
                            <i class="fa-solid fa-file-lines"></i>
                        </span>
                        Documentos
                    </a>
                </li>

            </ul>

            <!-- Footer -->
            <div class="sidebar-footer">

                <div class="user-row">
                    <div class="user-avatar">U</div>
                    <div>
                        <div class="user-name">Usuario</div>
                        <div class="user-role">Inquilino</div>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Cerrar sesión
                    </button>
                </form>

            </div>

        </aside>

        <!-- ══ MAIN ══ -->
        <div class="main-wrap">

            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-date">
                    <i class="fa-regular fa-calendar me-1"></i>
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </div>
                <div class="topbar-actions">
                    <div class="topbar-bell">
                        <i class="fa-solid fa-bell fa-sm"></i>
                        <span class="bell-badge"></span>
                    </div>
                </div>
            </header>

            <!-- Contenido -->
            <main class="page-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>