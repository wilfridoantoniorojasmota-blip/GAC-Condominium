@model PROTOTIPO.Models.UnidadHabitacional

@{
    ViewData["Title"] = "Historial de Alquileres";

    var contratos = Model.ContratoAlquilers?
        .OrderByDescending(c => c.IdContrato)
        .ToList() ?? new List<PROTOTIPO.Models.ContratoAlquiler>();

    var totalAlquileres = contratos.Count;
    var contratoActivo = contratos.FirstOrDefault(c => c.Estado?.ToLower() == "activo");
    var finalizados = contratos.Count(c => c.Estado?.ToLower() != "activo");
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --teal: #0fd4b0;
        --teal-light: #e6fdf9;
        --success: #15803d;
        --success-soft: #f0fdf6;
        --success-bdr: #bbf7d0;
        --danger: #b91c1c;
        --danger-soft: #fff1f0;
        --danger-bdr: #fecaca;
        --warn: #d97706;
        --warn-soft: #fffbeb;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 26px;
        --r-pill: 999px;
        --shadow-xs: 0 1px 3px rgba(12,18,32,.05);
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07);
        --shadow-md: 0 8px 24px rgba(12,18,32,.09);
        --ease: .22s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    .ht-page {
        max-width: 1200px;
        margin: 36px auto;
        padding: 0 24px 72px;
    }

    /* ── Breadcrumb ── */
    .ht-bc {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
        font-weight: 500;
        color: var(--ink-muted);
        margin-bottom: 26px;
    }

        .ht-bc a {
            color: var(--ink-muted);
            text-decoration: none;
            transition: color var(--ease);
        }

            .ht-bc a:hover {
                color: var(--accent);
            }

    /* ── Hero card ── */
    .ht-hero {
        background: var(--ink);
        border-radius: var(--r-2xl);
        padding: 30px 32px 0;
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
    }

        .ht-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }

        .ht-hero::after {
            content: '';
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.15) 0%, transparent 68%);
            top: -90px;
            right: -60px;
            pointer-events: none;
        }

    .ht-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-bottom: 28px;
    }

    .ht-hero-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .ht-hero-ico {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: rgba(26,86,232,.28);
        border: 1px solid rgba(26,86,232,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #93c5fd;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .ht-hero-eyebrow {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--teal);
        margin-bottom: 5px;
    }

    .ht-hero-title {
        font-family: var(--font-d);
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -.035em;
        color: #fff;
        margin: 0 0 5px;
    }

    .ht-hero-sub {
        font-size: .8rem;
        color: rgba(255,255,255,.5);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .ht-hero-sub i {
            font-size: .8rem;
        }

    .ht-hero-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-b);
        font-size: .82rem;
        font-weight: 700;
        padding: 9px 18px;
        border-radius: var(--r-lg);
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.75);
        text-decoration: none;
        transition: var(--ease);
        position: relative;
        z-index: 1;
    }

        .ht-hero-back:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    /* KPI strip inside hero (bottom) */
    .ht-kpi-strip {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border-top: 1px solid rgba(255,255,255,.08);
        margin: 0 -32px;
    }

    .ht-kpi {
        padding: 16px 24px;
        border-right: 1px solid rgba(255,255,255,.08);
        transition: background var(--ease);
    }

        .ht-kpi:last-child {
            border-right: none;
        }

        .ht-kpi:hover {
            background: rgba(255,255,255,.04);
        }

    .ht-kpi-label {
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .09em;
        color: rgba(255,255,255,.35);
        margin-bottom: 5px;
    }

    .ht-kpi-value {
        font-family: var(--font-d);
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.04em;
        line-height: 1;
    }

        .ht-kpi-value.kv--green {
            color: #86efac;
        }

        .ht-kpi-value.kv--muted {
            color: rgba(255,255,255,.45);
            font-size: 1rem;
            font-weight: 500;
            font-family: var(--font-b);
        }

    /* ── Stat row ── */
    .ht-stat-row {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .ht-stat {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--shadow-xs);
        transition: var(--ease);
    }

        .ht-stat:hover {
            box-shadow: var(--shadow-sm);
            transform: translateY(-2px);
        }

    .ht-stat-ico {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .hsi--blue {
        background: var(--accent-light);
        color: var(--accent);
    }

    .hsi--green {
        background: var(--success-soft);
        color: var(--success);
    }

    .hsi--muted {
        background: var(--surface);
        color: var(--ink-muted);
    }

    .ht-stat-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 2px;
    }

    .ht-stat-value {
        font-family: var(--font-d);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -.04em;
        line-height: 1;
    }

    /* ── Section header ── */
    .ht-section-hd {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .ht-section-hd-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .ht-section-hd-label span {
            width: 24px;
            height: 24px;
            border-radius: 7px;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .72rem;
        }

    .ht-section-line {
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    /* ── TIMELINE ── */
    .ht-timeline {
        position: relative;
        padding-left: 32px;
    }

        /* Vertical line */
        .ht-timeline::before {
            content: '';
            position: absolute;
            left: 11px;
            top: 8px;
            bottom: 8px;
            width: 2px;
            background: linear-gradient(to bottom, var(--accent) 0%, var(--border) 100%);
            border-radius: var(--r-pill);
        }

    /* Each entry */
    .ht-entry {
        position: relative;
        margin-bottom: 20px;
    }

        .ht-entry:last-child {
            margin-bottom: 0;
        }

    /* Timeline dot */
    .ht-dot {
        position: absolute;
        left: -32px;
        top: 20px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 3px solid var(--surface-2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .6rem;
        font-weight: 800;
        flex-shrink: 0;
        z-index: 1;
        box-shadow: 0 0 0 2px var(--border);
        transition: var(--ease);
    }

    .ht-dot--active {
        background: var(--success);
        color: #fff;
        box-shadow: 0 0 0 3px rgba(21,128,61,.2);
    }

    .ht-dot--finished {
        background: var(--ink-muted);
        color: #fff;
    }

    /* Entry card */
    .ht-entry-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        overflow: hidden;
        transition: var(--ease);
        box-shadow: var(--shadow-xs);
    }

        .ht-entry-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
            border-color: rgba(26,86,232,.18);
        }
        /* active card has accent left border */
        .ht-entry-card.active-card {
            border-color: rgba(21,128,61,.3);
            box-shadow: 0 0 0 1px rgba(21,128,61,.15), var(--shadow-sm);
        }

    /* Card header */
    .ht-entry-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--border);
    }

    .ht-entry-user {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ht-entry-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-d);
        font-size: .9rem;
        font-weight: 800;
        flex-shrink: 0;
        letter-spacing: -.02em;
    }

        .ht-entry-avatar.av--active {
            background: var(--success-soft);
            color: var(--success);
        }

    .ht-entry-name {
        font-family: var(--font-d);
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.02em;
        margin-bottom: 3px;
    }

    /* Estado badge */
    .ht-estado {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 700;
        padding: 5px 13px;
        border-radius: var(--r-pill);
        letter-spacing: .03em;
    }

        .ht-estado .pulse-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            animation: htPulse 1.6s ease-in-out infinite;
        }

    .he--active {
        background: var(--success-soft);
        color: var(--success);
        border: 1px solid var(--success-bdr);
    }

    .he--finished {
        background: var(--surface);
        color: var(--ink-muted);
        border: 1px solid var(--border);
    }

    .he--active .pulse-dot {
        background: var(--success);
    }

    .he--finished .pulse-dot {
        background: var(--ink-muted);
        animation: none;
    }

    @@keyframes htPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .5;
            transform: scale(.7);
        }
    }

    /* Card data chips */
    .ht-entry-data {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding: 16px 22px;
        gap: 0;
    }

    .ht-data-item {
        padding: 10px 12px;
        border-radius: var(--r-lg);
        transition: background var(--ease);
    }

        .ht-data-item:hover {
            background: var(--surface);
        }

    .ht-data-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .ht-data-label i {
            color: var(--accent);
            font-size: .72rem;
        }

    .ht-data-value {
        font-family: var(--font-d);
        font-size: .9rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.015em;
    }

        .ht-data-value.dv--money {
            color: var(--success);
        }

        .ht-data-value.dv--muted {
            color: var(--ink-muted);
            font-weight: 500;
            font-family: var(--font-b);
            font-style: italic;
        }

    /* Card footer (active only) */
    .ht-entry-footer {
        padding: 14px 22px;
        border-top: 1px solid var(--border);
        background: var(--success-soft);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ht-entry-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        color: var(--success);
        font-weight: 600;
    }

    .btn-finalizar {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-b);
        font-size: .82rem;
        font-weight: 700;
        padding: 9px 18px;
        border-radius: var(--r-lg);
        background: var(--danger-soft);
        color: var(--danger);
        border: 1.5px solid var(--danger-bdr);
        cursor: pointer;
        transition: var(--ease);
    }

        .btn-finalizar:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
            box-shadow: 0 4px 14px rgba(185,28,28,.3);
            transform: translateY(-1px);
        }

        .btn-finalizar:active {
            transform: translateY(0);
        }

        .btn-finalizar .fin-spin {
            display: none;
            width: 13px;
            height: 13px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: fin-rot .7s linear infinite;
        }

        .btn-finalizar.loading .fin-lbl,
        .btn-finalizar.loading i {
            display: none;
        }

        .btn-finalizar.loading .fin-spin {
            display: block;
        }

    @@keyframes fin-rot {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Empty state ── */
    .ht-empty {
        background: var(--surface-2);
        border: 1.5px dashed var(--border);
        border-radius: var(--r-2xl);
        padding: 64px 32px;
        text-align: center;
    }

    .ht-empty-ico {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: var(--ink-muted);
        opacity: .45;
        margin: 0 auto 14px;
    }

    .ht-empty p {
        font-size: .9rem;
        color: var(--ink-muted);
        margin: 0;
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .ht-page {
            padding: 0 16px 56px;
        }

        .ht-hero {
            padding: 24px 20px 0;
        }

        .ht-kpi-strip {
            margin: 0 -20px;
        }

        .ht-kpi {
            padding: 14px 16px;
        }

        .ht-stat-row {
            grid-template-columns: 1fr 1fr;
        }

        .ht-entry-data {
            grid-template-columns: 1fr;
        }

        .ht-timeline {
            padding-left: 24px;
        }

            .ht-timeline::before {
                left: 7px;
            }

        .ht-dot {
            left: -24px;
        }
    }

    @@media (max-width: 400px) {
        .ht-stat-row {
            grid-template-columns: 1fr;
        }

        .ht-kpi-strip {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ht-page">

    <!-- Breadcrumb -->
    <div class="ht-bc">
        <a asp-action="Index"><i class="bi bi-houses-fill"></i> Unidades</a>
        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
        <span>Unidad @Model.Numero</span>
        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
        <span>Historial de alquileres</span>
    </div>

    <!-- Hero -->
    <div class="ht-hero">
        <div class="ht-hero-inner">
            <div class="ht-hero-left">
                <div class="ht-hero-ico"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="ht-hero-eyebrow">Unidad Habitacional</div>
                    <div class="ht-hero-title">Historial de Alquileres</div>
                    <div class="ht-hero-sub">
                        <i class="bi bi-building"></i>
                        Unidad @Model.Numero
                        @if (!string.IsNullOrEmpty(Model.IdCondominioNavigation?.Nombre))
                        {
                            <span>·</span>
                            <span>@Model.IdCondominioNavigation.Nombre</span>
                        }
                    </div>
                </div>
            </div>
            <a asp-action="Index" asp-route-id="@Model.IdUnidad" class="ht-hero-back">
                <i class="bi bi-arrow-left"></i> Volver a unidad
            </a>
        </div>

        <!-- KPI strip -->
        <div class="ht-kpi-strip">
            <div class="ht-kpi">
                <div class="ht-kpi-label">Total alquileres</div>
                <div class="ht-kpi-value">@totalAlquileres</div>
            </div>
            <div class="ht-kpi">
                <div class="ht-kpi-label">Finalizados</div>
                <div class="ht-kpi-value">@finalizados</div>
            </div>
            <div class="ht-kpi">
                <div class="ht-kpi-label">Inquilino actual</div>
                @if (contratoActivo != null)
                {
                    <div class="ht-kpi-value kv--green" style="font-size:.85rem;">
                        @contratoActivo.IdUsuarioNavigation?.Nombre @contratoActivo.IdUsuarioNavigation?.Apellido
                    </div>
                }
                else
                {
                    <div class="ht-kpi-value kv--muted">Sin inquilino</div>
                }
            </div>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="ht-stat-row">
        <div class="ht-stat">
            <div class="ht-stat-ico hsi--blue"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <div class="ht-stat-label">Contratos totales</div>
                <div class="ht-stat-value">@totalAlquileres</div>
            </div>
        </div>
        <div class="ht-stat">
            <div class="ht-stat-ico hsi--green"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="ht-stat-label">Activo</div>
                <div class="ht-stat-value">@(contratoActivo != null ? "1" : "0")</div>
            </div>
        </div>
        <div class="ht-stat">
            <div class="ht-stat-ico hsi--muted"><i class="bi bi-archive-fill"></i></div>
            <div>
                <div class="ht-stat-label">Finalizados</div>
                <div class="ht-stat-value">@finalizados</div>
            </div>
        </div>
    </div>

    <!-- Timeline header -->
    <div class="ht-section-hd">
        <div class="ht-section-hd-label">
            <span><i class="bi bi-clock-history"></i></span>
            Historial registrado
        </div>
        <div class="ht-section-line"></div>
    </div>

    <!-- Timeline -->
    @if (!contratos.Any())
    {
        <div class="ht-empty">
            <div class="ht-empty-ico"><i class="bi bi-folder2-open"></i></div>
            <p>Esta unidad todavía no tiene alquileres registrados.</p>
        </div>
    }
    else
    {
        <div class="ht-timeline">
            @{
                int idx = 0;
            }
            @foreach (var contrato in contratos)
            {
                idx++;
                var activo = contrato.Estado?.ToLower() == "activo";
                var nombre = $"{contrato.IdUsuarioNavigation?.Nombre} {contrato.IdUsuarioNavigation?.Apellido}".Trim();
                var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                var inis = partes.Length >= 2
                    ? $"{partes[0][0]}{partes[1][0]}"
                    : (partes.Length == 1 ? $"{partes[0][0]}" : "?");
                inis = inis.ToUpper();

                <div class="ht-entry">

                    <!-- Dot -->
                    <div class="ht-dot @(activo ? "ht-dot--active" : "ht-dot--finished")">
                        @if (activo)
                        {
                            <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                        }
                        else
                        {
                            <i class="bi bi-check" style="font-size:.6rem;"></i>
                        }
                    </div>

                    <!-- Card -->
                    <div class="ht-entry-card @(activo ? "active-card" : "")">

                        <!-- Header -->
                        <div class="ht-entry-header">
                            <div class="ht-entry-user">
                                <div class="ht-entry-avatar @(activo ? "av--active" : "")">@inis</div>
                                <div>
                                    <div class="ht-entry-name">
                                        @(string.IsNullOrWhiteSpace(nombre) ? "Inquilino desconocido" : nombre)
                                    </div>
                                    <span class="ht-estado @(activo ? "he--active" : "he--finished")">
                                        <span class="pulse-dot"></span>
                                        @(activo ? "Activo" : "Finalizado")
                                    </span>
                                </div>
                            </div>
                            <span style="font-size:.7rem;font-weight:700;color:var(--ink-muted);letter-spacing:.06em;">
                                #@idx
                            </span>
                        </div>

                        <!-- Data -->
                        <div class="ht-entry-data">
                            <div class="ht-data-item">
                                <div class="ht-data-label"><i class="bi bi-calendar-event"></i> Fecha inicio</div>
                                <div class="ht-data-value">
                                    @(contrato.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")
                                </div>
                            </div>
                            <div class="ht-data-item">
                                <div class="ht-data-label"><i class="bi bi-calendar-check"></i> Fecha fin</div>
                                <div class="ht-data-value @(contrato.FechaFin == null && activo ? "dv--muted" : "")">
                                    @(contrato.FechaFin?.ToString("dd/MM/yyyy") ?? (activo ? "En curso" : "—"))
                                </div>
                            </div>
                            <div class="ht-data-item">
                                <div class="ht-data-label"><i class="bi bi-cash-coin"></i> Renta mensual</div>
                                <div class="ht-data-value dv--money">
                                    @(contrato.MontoRenta.HasValue ? "RD$ " + contrato.MontoRenta.Value.ToString("N2") : "—")
                                </div>
                            </div>
                        </div>

                        <!-- Footer (solo si activo) -->
                        @if (activo)
                        {
                            <div class="ht-entry-footer">
                                <div class="ht-entry-footer-note">
                                    <i class="bi bi-person-check-fill"></i>
                                    Contrato vigente
                                </div>
                                <form asp-action="FinalizarContrato" method="post"
                                      onsubmit="this.querySelector('.btn-finalizar').classList.add('loading');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.IdUnidad" />
                                    <button type="submit" class="btn-finalizar">
                                        <i class="bi bi-person-slash"></i>
                                        <span class="fin-lbl">Finalizar contrato</span>
                                        <div class="fin-spin"></div>
                                    </button>
                                </form>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

</div>
