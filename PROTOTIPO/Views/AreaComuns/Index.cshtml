@model IEnumerable<PROTOTIPO.Models.AreaComun>

@{
    ViewData["Title"] = "Áreas Comunes";
}

<style>
    /* VARIABLES Y TIPOGRAFÍA */
    :root {
        --primary-soft: #e7f1ff;
        --success-soft: #d1e7dd;
        --danger-soft: #f8d7da;
    }

    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #2b3452;
    }

    /* TARJETAS DE ESTADÍSTICAS */
    .stat-card {
        border: none;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    /* TARJETAS DE ÁREAS */
    .area-card {
        border: none;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .area-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    /* IMAGEN Y BADGE FLOTANTE */
    .area-img-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

    .area-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .area-card:hover .area-img {
        transform: scale(1.05);
    }

    .floating-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 30px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        z-index: 2;
    }

    .badge-ocupada {
        background-color: rgba(220, 53, 69, 0.9);
        color: white;
    }

    .badge-disponible {
        background-color: rgba(25, 135, 84, 0.9);
        color: white;
    }

    /* TEXTOS */
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .condominio-pill {
        background-color: #f8f9fa;
        color: #6c757d;
        font-size: 0.8rem;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        display: inline-block;
        font-weight: 500;
    }

    /* BOTONES */
    .btn-action {
        border-radius: 12px;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        transition: all 0.2s;
    }

    .btn-icon {
        width: 38px;
        height: 38px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }
</style>

<div class="container py-4">

    <div class="row mb-5 align-items-center">
        <div class="col-md-6 text-center text-md-start">
            <h2 class="page-title mb-1">
                <i class="bi bi-buildings text-primary me-2"></i>Áreas Comunes
            </h2>
            <p class="text-muted mb-0 fs-6">
                Gestión inteligente de espacios compartidos
            </p>
        </div>

        <div class="col-md-6 mt-4 mt-md-0 d-flex flex-column flex-sm-row justify-content-center justify-content-md-end gap-3">

            <a asp-controller="ReservaAreaComuns" asp-action="Index"
               class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                <i class="bi bi-calendar-check fs-5 me-2"></i> Mis Reservas
            </a>

            <a asp-action="Create"
               class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                <i class="bi bi-plus-lg fs-5 me-2"></i> Nueva Área
            </a>

        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="stat-card p-4 h-100 d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-grid-fill"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0 fw-semibold">Total Áreas</p>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalAreas</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card p-4 h-100 d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0 fw-semibold">Reservas</p>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalReservas</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card p-4 h-100 d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-door-open-fill"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0 fw-semibold">Disponibles Hoy</p>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.DisponiblesHoy</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card p-4 h-100 d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-door-closed-fill"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0 fw-semibold">Ocupadas Hoy</p>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.ReservadasHoy</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            var imagen = item.ImagenAreas.FirstOrDefault();
            var reservaHoy = item.ReservaAreaComuns?
                .Where(r => r.Fecha == DateOnly.FromDateTime(DateTime.Today))
                .OrderBy(r => r.HoraInicio)
                .FirstOrDefault();

            <div class="col-md-6 col-lg-4">
                <div class="card area-card h-100">

                    <div class="area-img-wrapper">
                        @if (reservaHoy != null)
                        {
                            <div class="floating-badge badge-ocupada">
                                <i class="bi bi-lock-fill me-1"></i> Ocupada (@reservaHoy.HoraInicio - @reservaHoy.HoraFin)
                            </div>
                        }
                        else
                        {
                            <div class="floating-badge badge-disponible">
                                <i class="bi bi-unlock-fill me-1"></i> Disponible
                            </div>
                        }

                        @if (imagen != null && !string.IsNullOrEmpty(imagen.Url))
                        {
                            <img src="@imagen.Url" class="area-img" alt="@item.Nombre" />
                        }
                        else
                        {
                            <img src="https://placehold.co/600x400/f8f9fa/a3a3a3?text=Sin+Imagen" class="area-img" alt="Placeholder" />
                        }
                    </div>

                    <div class="card-body d-flex flex-column p-4">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0 text-dark">@item.Nombre</h5>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">
                                <i class="bi bi-calendar-event me-1"></i> @item.ReservaAreaComuns.Count
                            </span>
                        </div>

                        <div class="mb-3">
                            <span class="condominio-pill">
                                <i class="bi bi-building me-1"></i> @(item.IdCondominioNavigation?.Nombre ?? "Sin asignar")
                            </span>
                        </div>

                        <p class="text-muted small mb-4 text-truncate-2">
                            @item.Descripcion
                        </p>

                        <div class="mt-auto d-flex gap-2 align-items-center">

                            <a asp-controller="ReservaAreaComuns" asp-action="Create" asp-route-idArea="@item.IdArea"
                               class="btn btn-success btn-action flex-grow-1">
                                Reservar
                            </a>

                            <a asp-action="Details" asp-route-id="@item.IdArea"
                               class="btn btn-light border btn-icon text-primary" title="Ver Detalles">
                                <i class="bi bi-eye"></i>
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.IdArea"
                                   class="btn btn-light border btn-icon text-warning" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.IdArea"
                                   class="btn btn-light border btn-icon text-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

</div>