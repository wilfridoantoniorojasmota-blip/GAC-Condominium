@model PROTOTIPO.Models.AreaComun

@{
    ViewData["Title"] = "Nueva Área Común";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f5f7fa;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-2: #0fd4b0;
        --accent-soft: #eff6ff;
        --no-bg: #fff1f0;
        --no-ink: #b91c1c;
        --no-bdr: #fecaca;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --tr: .2s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    .ac-shell {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 44px 20px 80px;
    }

    .ac-panel {
        width: 100%;
        max-width: 780px;
    }

    /* ── Back ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 26px;
        transition: color var(--tr);
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* ── Card ── */
    .ac-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ── Dark header ── */
    .ac-head {
        position: relative;
        padding: 30px 36px 26px;
        background: var(--ink);
        overflow: hidden;
    }

        .ac-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .ac-head::after {
            content: '';
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.18) 0%, transparent 70%);
            right: -50px;
            top: -60px;
            pointer-events: none;
        }

    .ac-head-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .ac-head-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        flex-shrink: 0;
    }

    .ac-head-title {
        font-family: var(--font-d);
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.03em;
        margin: 0;
    }

    .ac-head-sub {
        font-size: .78rem;
        color: rgba(255,255,255,.5);
        margin: 3px 0 0;
    }

    /* ── Body ── */
    .ac-body {
        padding: 32px 36px 36px;
    }

    /* ── Validation summary ── */
    .val-summary {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--no-bg);
        border: 1px solid var(--no-bdr);
        border-radius: var(--r-lg);
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: .855rem;
        color: var(--no-ink);
    }

        .val-summary i {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .val-summary:empty {
            display: none;
        }

    /* ── Section heading ── */
    .sec-hd {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-muted);
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 20px;
    }

        .sec-hd i {
            font-size: .8rem;
            color: var(--accent);
        }

    /* ── Field label ── */
    .f-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 8px;
    }

        .f-label i {
            font-size: .78rem;
            color: var(--accent);
        }

    .f-optional {
        font-size: .62rem;
        font-weight: 600;
        color: var(--accent-2);
        letter-spacing: .04em;
        margin-left: 4px;
    }

    /* ── Inputs ── */
    .f-control {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        font-family: var(--font-b);
        font-size: .9rem;
        color: var(--ink);
        transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
        outline: none;
        appearance: none;
        -webkit-appearance: none;
    }

        .f-control:focus {
            border-color: var(--accent);
            background: var(--surface-2);
            box-shadow: 0 0 0 3px rgba(26,86,232,.1);
        }

        .f-control::placeholder {
            color: #c0cad6;
        }

    textarea.f-control {
        resize: vertical;
        min-height: 110px;
        line-height: 1.65;
    }

    /* Select with custom arrow */
    .select-wrap {
        position: relative;
    }

        .select-wrap::after {
            content: '\F282';
            font-family: 'bootstrap-icons';
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-size: .88rem;
            color: var(--ink-muted);
            pointer-events: none;
        }

        .select-wrap .f-control {
            padding-right: 36px;
            cursor: pointer;
        }

    /* Char counter */
    .char-hint {
        font-size: .72rem;
        color: var(--ink-muted);
        text-align: right;
        margin-top: 5px;
        transition: color var(--tr);
    }

        .char-hint.warn {
            color: #f59e0b;
        }

        .char-hint.limit {
            color: var(--no-ink);
            font-weight: 600;
        }

    /* Validation errors — hidden by default, shown only when ASP.NET injects text */
    .f-error {
        font-size: .77rem;
        color: var(--no-ink);
        font-weight: 600;
        margin-top: 6px;
        display: none;
        align-items: center;
        gap: 5px;
    }

        .f-error:not(:empty) {
            display: flex;
        }

            .f-error:not(:empty)::before {
                content: "\F333";
                font-family: 'bootstrap-icons';
                font-size: .82rem;
                flex-shrink: 0;
            }

    /* ── Upload zone ── */
    .upload-zone {
        position: relative;
        border: 1.5px dashed var(--border);
        border-radius: var(--r-xl);
        padding: 28px 20px;
        text-align: center;
        background: var(--surface);
        cursor: pointer;
        transition: var(--tr);
    }

        .upload-zone:hover, .upload-zone.dragover {
            border-color: var(--accent);
            background: var(--accent-soft);
        }

        .upload-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

    .upload-icon-wrap {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--ink-muted);
        margin: 0 auto 11px;
        transition: var(--tr);
    }

    .upload-zone:hover .upload-icon-wrap,
    .upload-zone.dragover .upload-icon-wrap {
        background: #fff;
        border-color: #bfdbfe;
        color: var(--accent);
    }

    .upload-title {
        font-size: .875rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 3px;
    }

    .upload-sub {
        font-size: .77rem;
        color: var(--ink-muted);
    }

    /* Image preview */
    .img-preview-wrap {
        display: none;
        align-items: center;
        gap: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 12px 16px;
        margin-top: 10px;
    }

        .img-preview-wrap.show {
            display: flex;
        }

        .img-preview-wrap img {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--border);
        }

    .img-preview-info {
        flex: 1;
        min-width: 0;
    }

    .img-preview-name {
        font-size: .83rem;
        font-weight: 600;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .img-preview-size {
        font-size: .75rem;
        color: var(--ink-muted);
        margin-top: 1px;
    }

    .img-remove {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--tr);
        font-size: .8rem;
        flex-shrink: 0;
    }

        .img-remove:hover {
            background: var(--no-bg);
            color: var(--no-ink);
            border-color: var(--no-bdr);
        }

    /* ── Divider ── */
    .ac-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 26px;
    }

    /* ── Actions ── */
    .action-row {
        display: flex;
        gap: 10px;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 20px;
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--font-b);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        transition: var(--tr);
        white-space: nowrap;
    }

        .btn-cancel:hover {
            background: var(--surface-2);
            border-color: #c8d0dc;
            color: var(--ink);
        }

    .btn-submit {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 24px;
        border-radius: var(--r-lg);
        border: none;
        background: linear-gradient(135deg, var(--accent) 0%, #1647cc 100%);
        color: #fff;
        font-family: var(--font-b);
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: var(--tr);
        box-shadow: 0 4px 16px rgba(26,86,232,.3);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(26,86,232,.38);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit.loading {
            opacity: .75;
            pointer-events: none;
        }

        .btn-submit .spinner {
            display: none;
            width: 15px;
            height: 15px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .btn-submit.loading .spinner {
            display: block;
        }

        .btn-submit.loading .btn-icon {
            display: none;
        }
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 480px) {
        .ac-head {
            padding: 22px 20px 18px;
        }

        .ac-body {
            padding: 24px 20px 28px;
        }

        .action-row {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="ac-shell">
    <div class="ac-panel">

        <!-- Back -->
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Volver a áreas comunes
        </a>

        <div class="ac-card">

            <!-- Header -->
            <div class="ac-head">
                <div class="ac-head-inner">
                    <div class="ac-head-icon">
                        <i class="bi bi-tree-fill"></i>
                    </div>
                    <div>
                        <h1 class="ac-head-title">Nueva Área Común</h1>
                        <p class="ac-head-sub">Registra un espacio compartido del condominio</p>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="ac-body">

                <form asp-action="Create" enctype="multipart/form-data" id="acForm" novalidate>

                    @Html.AntiForgeryToken()

                    <!-- Validation summary -->
                    <div asp-validation-summary="ModelOnly" class="val-summary">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div></div>
                    </div>

                    <!-- ══ Sección 1: Información del área ══ -->
                    <div class="sec-hd">
                        <i class="bi bi-info-circle-fill"></i>
                        Información del área
                    </div>

                    <!-- Nombre -->
                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-tag"></i>
                            Nombre del área
                        </div>
                        <input asp-for="Nombre"
                               class="f-control"
                               placeholder="Ej. Piscina, Gazebo, Salón de Eventos…"
                               autocomplete="off" />
                        <span asp-validation-for="Nombre" class="f-error">
                        </span>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-chat-left-text"></i>
                            Descripción
                            <span class="f-optional">Opcional</span>
                        </div>
                        <textarea asp-for="Descripcion"
                                  class="f-control"
                                  rows="4"
                                  id="descArea"
                                  maxlength="500"
                                  placeholder="Describe el área: capacidad, horarios, normas de uso…"></textarea>
                        <div class="char-hint" id="charHint">0 / 500 caracteres</div>
                        <span asp-validation-for="Descripcion" class="f-error">
                        </span>
                    </div>

                    <!-- Condominio -->
                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-buildings"></i>
                            Condominio
                        </div>
                        <div class="select-wrap">
                            <select asp-for="IdCondominio"
                                    class="f-control"
                                    asp-items="ViewBag.IdCondominio">
                                <option value="">Selecciona un condominio…</option>
                            </select>
                        </div>
                        <span asp-validation-for="IdCondominio" class="f-error">
                        </span>
                    </div>

                    <!-- ══ Sección 2: Imagen ══ -->
                    <div class="sec-hd">
                        <i class="bi bi-image-fill"></i>
                        Fotografía del área
                    </div>

                    <div class="mb-2">
                        <div class="upload-zone" id="uploadZone">
                            <input type="file"
                                   name="imagenFile"
                                   id="imgInput"
                                   accept="image/png,image/jpeg,image/webp">
                            <div class="upload-icon-wrap">
                                <i class="bi bi-image-fill"></i>
                            </div>
                            <div class="upload-title">Arrastra una imagen o haz clic aquí</div>
                            <div class="upload-sub">PNG, JPG o WEBP · Máximo 5 MB</div>
                        </div>

                        <div class="img-preview-wrap" id="imgPreview">
                            <img id="imgThumb" src="#" alt="Vista previa">
                            <div class="img-preview-info">
                                <div class="img-preview-name" id="imgName">—</div>
                                <div class="img-preview-size" id="imgSize">—</div>
                            </div>
                            <button type="button" class="img-remove" id="imgRemove" title="Quitar imagen">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>

                    <hr class="ac-divider" style="margin-top:28px;">

                    <!-- Actions -->
                    <div class="action-row">
                        <a asp-action="Index" class="btn-cancel">
                            <i class="bi bi-x"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn-submit" id="submitBtn">
                            <span class="spinner"></span>
                            <i class="bi bi-floppy-fill btn-icon"></i>
                            Guardar área
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            /* ── Char counter ── */
            const desc    = document.getElementById('descArea');
            const hint    = document.getElementById('charHint');
            const MAX     = 500;

            desc?.addEventListener('input', function () {
                const n = this.value.length;
                hint.textContent = `${n} / ${MAX} caracteres`;
                hint.className = 'char-hint' +
                    (n >= MAX ? ' limit' : n >= MAX * .85 ? ' warn' : '');
            });

            /* ── Image upload ── */
            const zone    = document.getElementById('uploadZone');
            const input   = document.getElementById('imgInput');
            const preview = document.getElementById('imgPreview');
            const thumb   = document.getElementById('imgThumb');
            const name    = document.getElementById('imgName');
            const size    = document.getElementById('imgSize');
            const remove  = document.getElementById('imgRemove');

            zone?.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
            zone?.addEventListener('dragleave', () => zone.classList.remove('dragover'));
            zone?.addEventListener('drop', e => {
                e.preventDefault();
                zone.classList.remove('dragover');
                if (e.dataTransfer.files[0]) setFile(e.dataTransfer.files[0]);
            });

            input?.addEventListener('change', function () {
                if (this.files[0]) setFile(this.files[0]);
            });

            function setFile(file) {
                const reader = new FileReader();
                reader.onload = e => { thumb.src = e.target.result; };
                reader.readAsDataURL(file);
                name.textContent = file.name;
                size.textContent = fmt(file.size);
                preview.classList.add('show');
                zone.style.display = 'none';
            }

            remove?.addEventListener('click', () => {
                input.value = '';
                preview.classList.remove('show');
                zone.style.display = '';
                thumb.src = '#';
            });

            function fmt(b) {
                if (b < 1024) return b + ' B';
                if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
                return (b / 1048576).toFixed(1) + ' MB';
            }

            /* ── Submit loading ── */
            document.getElementById('acForm')?.addEventListener('submit', function () {
                const btn = document.getElementById('submitBtn');
                btn.classList.add('loading');
            });
        })();
    </script>
}
