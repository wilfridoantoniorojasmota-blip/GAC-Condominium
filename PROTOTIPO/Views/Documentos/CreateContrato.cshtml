@model PROTOTIPO.Models.ContratoAlquiler

@{
    ViewData["Title"] = "Crear Contrato de Alquiler";
}

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --teal: #0fd4b0;
        --teal-light: #e6fdf9;
        --success: #15803d;
        --success-soft: #f0fdf6;
        --success-bdr: #bbf7d0;
        --danger: #b91c1c;
        --danger-soft: #fff1f0;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 26px;
        --r-pill: 999px;
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07);
        --ease: .22s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    .ct-page {
        max-width: 720px;
        margin: 36px auto;
        padding: 0 24px 64px;
    }

    /* ── Breadcrumb ── */
    .ct-bc {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
        font-weight: 500;
        color: var(--ink-muted);
        margin-bottom: 26px;
    }

        .ct-bc a {
            color: var(--ink-muted);
            text-decoration: none;
            transition: color var(--ease);
        }

            .ct-bc a:hover {
                color: var(--accent);
            }

    /* ── Header ── */
    .ct-hd {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .ct-hd-ico {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.35rem;
        flex-shrink: 0;
        box-shadow: 0 6px 20px rgba(26,86,232,.32);
    }

    .ct-hd-title {
        font-family: var(--font-d);
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -.035em;
        color: var(--ink);
        margin: 0 0 3px;
    }

    .ct-hd-sub {
        font-size: .84rem;
        color: var(--ink-muted);
        margin: 0;
    }

    /* ── Card ── */
    .ct-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    /* ── Band ── */
    .ct-band {
        background: var(--ink);
        padding: 20px 28px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        overflow: hidden;
    }

        .ct-band::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .ct-band::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(26,86,232,.22) 0%, transparent 68%);
            top: -70px;
            right: -40px;
            pointer-events: none;
        }

    .ct-band-ico {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(26,86,232,.25);
        border: 1px solid rgba(26,86,232,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #93c5fd;
        font-size: 1rem;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .ct-band-title {
        font-family: var(--font-d);
        font-size: .95rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .ct-band-sub {
        font-size: .72rem;
        color: rgba(255,255,255,.4);
        margin: 0;
        position: relative;
        z-index: 1;
    }

    /* ── Section ── */
    .ct-section {
        padding: 26px 28px 8px;
    }

        .ct-section + .ct-section {
            border-top: 1px solid var(--border);
            padding-top: 22px;
        }

    .ct-section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 18px;
    }

        .ct-section-label span {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
        }

    /* ── Grids ── */
    .ct-g2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .ct-g1 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    /* ── Fields ── */
    .cf-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink-soft);
        margin-bottom: 8px;
    }

        .cf-label i {
            color: var(--accent);
            font-size: .82rem;
        }

        .cf-label .req {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #ef4444;
            display: inline-block;
            margin-left: 2px;
        }

        .cf-label .opt {
            font-size: .68rem;
            font-weight: 500;
            color: var(--ink-muted);
            margin-left: 3px;
        }

    .cf-wrap {
        position: relative;
    }

    .cf-input, .cf-select {
        width: 100%;
        padding: 11px 14px 11px 40px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        font-family: var(--font-b);
        font-size: .875rem;
        color: var(--ink);
        background: var(--surface);
        outline: none;
        -webkit-appearance: none;
        appearance: none;
        transition: border-color var(--ease), box-shadow var(--ease), background var(--ease);
    }

        .cf-input:focus, .cf-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(26,86,232,.11);
            background: #fff;
        }

        .cf-input::placeholder {
            color: #b8c4d0;
        }

    .cf-ico {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #c0cad6;
        font-size: .88rem;
        pointer-events: none;
        transition: color var(--ease);
    }

    .cf-wrap:focus-within .cf-ico {
        color: var(--accent);
    }

    .cf-sel-wrap {
        position: relative;
    }

        .cf-sel-wrap::after {
            content: '\F282';
            font-family: 'bootstrap-icons';
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-muted);
            pointer-events: none;
            font-size: .82rem;
        }

    .cf-select {
        padding-right: 36px;
        cursor: pointer;
    }

    .cf-hint {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: .72rem;
        color: var(--ink-muted);
        margin-top: 6px;
    }

        .cf-hint i {
            color: var(--teal);
        }

    /* ── Duration preview ── */
    .ct-duration {
        display: none;
        background: var(--teal-light);
        border: 1px solid rgba(15,212,176,.3);
        border-radius: var(--r-lg);
        padding: 12px 16px;
        margin-top: 10px;
        align-items: center;
        gap: 10px;
        font-size: .82rem;
        font-weight: 600;
        color: #0aaa8c;
    }

        .ct-duration.visible {
            display: flex;
        }

        .ct-duration i {
            font-size: 1rem;
        }

    /* ── Status select colors ── */
    #Estado option[value="Activo"] {
        color: var(--success);
    }

    #Estado option[value="Pendiente"] {
        color: var(--warn, #d97706);
    }

    /* ── PDF upload zone ── */
    .ct-upload-zone {
        border: 2px dashed var(--border);
        border-radius: var(--r-xl);
        background: var(--surface);
        padding: 32px 24px;
        text-align: center;
        cursor: pointer;
        transition: var(--ease);
        position: relative;
    }

        .ct-upload-zone:hover,
        .ct-upload-zone.dragover {
            border-color: var(--accent);
            background: var(--accent-light);
        }

        .ct-upload-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

    .ct-upload-ico {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: var(--danger-soft);
        color: var(--danger);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 14px;
        transition: var(--ease);
        border: 1px solid var(--danger-bdr);
    }

    .ct-upload-zone:hover .ct-upload-ico,
    .ct-upload-zone.dragover .ct-upload-ico {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .ct-upload-title {
        font-family: var(--font-d);
        font-size: .95rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .ct-upload-sub {
        font-size: .78rem;
        color: var(--ink-muted);
        line-height: 1.5;
    }

    /* Selected file feedback */
    .ct-file-selected {
        display: none;
        margin-top: 12px;
        background: var(--success-soft);
        border: 1px solid var(--success-bdr);
        border-radius: var(--r-lg);
        padding: 10px 14px;
        align-items: center;
        gap: 9px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--success);
    }

        .ct-file-selected.show {
            display: flex;
        }

        .ct-file-selected i {
            font-size: 1rem;
            flex-shrink: 0;
        }

    .ct-file-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    /* ── Footer ── */
    .ct-footer {
        background: #f8fafc;
        border-top: 1px solid var(--border);
        padding: 18px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-ct-cancel {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: var(--r-lg);
        border: 1.5px solid var(--border);
        background: transparent;
        color: var(--ink-soft);
        text-decoration: none;
        transition: var(--ease);
    }

        .btn-ct-cancel:hover {
            background: var(--surface-2);
            border-color: #c8d2de;
            color: var(--ink);
        }

    .btn-ct-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 700;
        padding: 10px 26px;
        border-radius: var(--r-lg);
        border: none;
        background: var(--accent);
        color: #fff;
        cursor: pointer;
        transition: var(--ease);
        box-shadow: 0 4px 14px rgba(26,86,232,.35);
    }

        .btn-ct-save:hover {
            background: #1447d0;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,86,232,.45);
        }

        .btn-ct-save:active {
            transform: translateY(0);
        }

        .btn-ct-save .ct-spin {
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: ct-rot .7s linear infinite;
        }

        .btn-ct-save.loading .ct-lbl,
        .btn-ct-save.loading .ct-ico {
            display: none;
        }

        .btn-ct-save.loading .ct-spin {
            display: block;
        }

    @@keyframes ct-rot {
        to {
            transform: rotate(360deg);
        }
    }

    span[data-valmsg-for],
    .field-validation-error,
    .field-validation-valid,
    .text-danger {
        display: none !important;
    }

    @@media (max-width: 575px) {
        .ct-page {
            padding: 0 16px 48px;
        }

        .ct-band, .ct-section {
            padding-left: 20px;
            padding-right: 20px;
        }

        .ct-footer {
            padding: 16px 20px;
            flex-direction: column;
            align-items: stretch;
        }

        .btn-ct-cancel, .btn-ct-save {
            width: 100%;
            justify-content: center;
        }

        .ct-g2 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ct-page">

    <!-- Breadcrumb -->
    <div class="ct-bc">
        <a asp-action="Index"><i class="bi bi-file-earmark-person-fill"></i> Contratos</a>
        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
        <span>Nuevo contrato</span>
    </div>

    <!-- Header -->
    <div class="ct-hd">
        <div class="ct-hd-ico"><i class="bi bi-file-earmark-plus-fill"></i></div>
        <div>
            <h1 class="ct-hd-title">Crear Contrato de Alquiler</h1>
            <p class="ct-hd-sub">Registra un nuevo contrato y adjunta el documento PDF correspondiente.</p>
        </div>
    </div>

    <!-- Card -->
    <div class="ct-card">

        <!-- Band -->
        <div class="ct-band">
            <div class="ct-band-ico"><i class="bi bi-file-earmark-person-fill"></i></div>
            <div>
                <div class="ct-band-title">Datos del contrato</div>
                <div class="ct-band-sub">Completa todos los campos requeridos</div>
            </div>
        </div>

        <form asp-action="CreateContrato" method="post"
              enctype="multipart/form-data" id="ctForm">
            @Html.AntiForgeryToken()

            <!-- ── Sección 1: Partes del contrato ── -->
            <div class="ct-section">
                <div class="ct-section-label">
                    <span><i class="bi bi-people-fill"></i></span>
                    Partes del contrato
                </div>

                <div class="ct-g1">
                    <div>
                        <label class="cf-label">
                            <i class="bi bi-person-fill"></i>
                            Inquilino <span class="req"></span>
                        </label>
                        <div class="cf-sel-wrap cf-wrap">
                            <select asp-for="IdUsuario" asp-items="ViewBag.Inquilinos"
                                    class="cf-select" style="padding-left:40px;">
                                <option value="">— Seleccionar inquilino —</option>
                            </select>
                            <i class="bi bi-person cf-ico"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Sección 2: Vigencia y condiciones ── -->
            <div class="ct-section">
                <div class="ct-section-label">
                    <span><i class="bi bi-calendar-range-fill"></i></span>
                    Vigencia y condiciones
                </div>

                <div class="ct-g2">
                    <div>
                        <label class="cf-label">
                            <i class="bi bi-calendar-event-fill"></i>
                            Fecha de inicio <span class="req"></span>
                        </label>
                        <div class="cf-wrap">
                            <input asp-for="FechaInicio" type="date"
                                   class="cf-input" id="fechaInicio">
                            <i class="bi bi-calendar-event cf-ico"></i>
                        </div>
                    </div>
                    <div>
                        <label class="cf-label">
                            <i class="bi bi-calendar-check-fill"></i>
                            Fecha de fin <span class="opt">(opcional)</span>
                        </label>
                        <div class="cf-wrap">
                            <input asp-for="FechaFin" type="date"
                                   class="cf-input" id="fechaFin">
                            <i class="bi bi-calendar-check cf-ico"></i>
                        </div>
                    </div>
                </div>

                <!-- Duration preview -->
                <div class="ct-duration" id="ctDuration">
                    <i class="bi bi-clock-history"></i>
                    <span id="ctDurationText">—</span>
                </div>

                <div class="ct-g2" style="margin-top:16px;">
                    <div>
                        <label class="cf-label">
                            <i class="bi bi-cash-coin"></i>
                            Mensualidad (RD$) <span class="req"></span>
                        </label>
                        <div class="cf-wrap">
                            <input asp-for="MontoRenta" type="number"
                                   step="0.01" min="0"
                                   class="cf-input" id="montoRenta"
                                   placeholder="Ej. 15000">
                            <i class="bi bi-currency-dollar cf-ico"></i>
                        </div>
                        <div class="cf-hint">
                            <i class="bi bi-info-circle-fill"></i>
                            Monto mensual del alquiler.
                        </div>
                    </div>
                    <div>
                        <label class="cf-label">
                            <i class="bi bi-toggle-on"></i>
                            Estado del contrato <span class="req"></span>
                        </label>
                        <div class="cf-sel-wrap cf-wrap">
                            <select asp-for="Estado" class="cf-select"
                                    id="estadoSel" style="padding-left:40px;">
                                <option value="Activo">Activo</option>
                                <option value="Pendiente">Pendiente</option>
                            </select>
                            <i class="bi bi-circle-half cf-ico" id="estadoIco"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Sección 3: Documento PDF ── -->
            <div class="ct-section" style="padding-bottom:20px;">
                <div class="ct-section-label">
                    <span><i class="bi bi-file-earmark-pdf-fill"></i></span>
                    Documento PDF <span style="color:var(--ink-muted);font-weight:500;text-transform:none;letter-spacing:0;">(opcional)</span>
                </div>

                <div class="ct-upload-zone" id="ctUploadZone">
                    <input type="file" name="archivoSubido"
                           id="ctFileInput" accept=".pdf">
                    <div class="ct-upload-ico"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                    <div class="ct-upload-title">Arrastra el PDF o haz clic para seleccionar</div>
                    <div class="ct-upload-sub">
                        Solo formato PDF · Máx. 10 MB<br>
                        Si no adjuntas un archivo, el contrato se creará sin documento.
                    </div>
                </div>

                <div class="ct-file-selected" id="ctFileSelected">
                    <i class="bi bi-check-circle-fill"></i>
                    <span class="ct-file-name" id="ctFileName">archivo.pdf</span>
                    <button type="button" id="ctFileRemove"
                            style="background:none;border:none;color:var(--success);cursor:pointer;font-size:.9rem;padding:0 4px;"
                            title="Quitar archivo">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </div>
            </div>

            <!-- Footer -->
            <div class="ct-footer">
                <a asp-action="Index" class="btn-ct-cancel">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn-ct-save" id="btnCtSave">
                    <i class="ct-ico bi bi-floppy-fill"></i>
                    <span class="ct-lbl">Guardar contrato</span>
                    <div class="ct-spin"></div>
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            /* ── Estado icon color ── */
            var estadoSel = document.getElementById('estadoSel');
            var estadoIco = document.getElementById('estadoIco');
            function actualizarEstado() {
                if (!estadoSel || !estadoIco) return;
                estadoIco.style.color = estadoSel.value === 'Activo' ? '#15803d' : '#d97706';
            }
            estadoSel?.addEventListener('change', actualizarEstado);
            actualizarEstado();

            /* ── Duration preview ── */
            var fechaIni = document.getElementById('fechaInicio');
            var fechaFin = document.getElementById('fechaFin');
            var durEl = document.getElementById('ctDuration');
            var durTx = document.getElementById('ctDurationText');

            function calcDuration() {
                if (!fechaIni?.value || !fechaFin?.value) {
                    durEl.classList.remove('visible'); return;
                }
                var d1 = new Date(fechaIni.value);
                var d2 = new Date(fechaFin.value);
                if (d2 <= d1) { durEl.classList.remove('visible'); return; }
                var meses = (d2.getFullYear() - d1.getFullYear()) * 12 + (d2.getMonth() - d1.getMonth());
                var dias = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                durTx.textContent = 'Duración: ' + (meses > 0 ? meses + ' mes' + (meses !== 1 ? 'es' : '') + ' (' + dias + ' días)' : dias + ' días');
                durEl.classList.add('visible');
            }
            fechaIni?.addEventListener('change', calcDuration);
            fechaFin?.addEventListener('change', calcDuration);

            /* ── File upload ── */
            var fileInput = document.getElementById('ctFileInput');
            var zone = document.getElementById('ctUploadZone');
            var selected = document.getElementById('ctFileSelected');
            var fileNameEl = document.getElementById('ctFileName');
            var removeBtn = document.getElementById('ctFileRemove');

            function showFile(name) {
                if (fileNameEl) fileNameEl.textContent = name;
                if (selected) selected.classList.add('show');
            }
            function clearFile() {
                if (fileInput) fileInput.value = '';
                if (selected) selected.classList.remove('show');
            }

            fileInput?.addEventListener('change', function() {
                if (this.files && this.files[0]) showFile(this.files[0].name);
                else clearFile();
            });
            removeBtn?.addEventListener('click', clearFile);

            zone?.addEventListener('dragover', function(e) {
                e.preventDefault(); this.classList.add('dragover');
            });
            zone?.addEventListener('dragleave', function() {
                this.classList.remove('dragover');
            });
            zone?.addEventListener('drop', function(e) {
                e.preventDefault(); this.classList.remove('dragover');
                var f = e.dataTransfer?.files[0];
                if (f && f.type === 'application/pdf') {
                    fileInput.files = e.dataTransfer.files;
                    showFile(f.name);
                }
            });

            /* ── Submit loader ── */
            document.getElementById('ctForm')?.addEventListener('submit', function() {
                setTimeout(function() {
                    var btn = document.getElementById('btnCtSave');
                    btn.classList.add('loading');
                    btn.disabled = true;
                }, 0);
            });
        })();
    </script>
}
