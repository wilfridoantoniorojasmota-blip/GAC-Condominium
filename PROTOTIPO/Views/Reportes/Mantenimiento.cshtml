
@model IEnumerable<PROTOTIPO.Models.IncidenciaMantenimiento>

@{
    ViewData["Title"] = "Reporte de Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<div class="mnt-page">
    <div class="container-fluid py-4 px-3 px-md-4">

        <!-- HEADER -->
        <div class="page-header mb-4">
            <div>
                <h3><i class="bi bi-tools me-2"></i>Reporte de Mantenimiento</h3>
                <p>Seguimiento de incidencias, análisis y estado de reparaciones del condominio</p>
            </div>

            <a asp-controller="Reportes" asp-action="Index" class="btn-gac btn-gac-secondary-header">
                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>
        </div>

        <!-- TARJETAS ESTADISTICAS -->
        <div class="row g-3 mb-4">

            <!-- Total Incidencias -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-info">
                    <div class="sc-icon ic-blue">
                        <i class="bi bi-wrench-adjustable"></i>
                    </div>
                    <div class="sc-label">Total incidencias</div>
                    <div class="sc-value">@ViewBag.Total</div>
                </div>
            </div>

            <!-- Pendientes -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-danger">
                    <div class="sc-icon ic-red">
                        <i class="bi bi-exclamation-circle-fill"></i>
                    </div>
                    <div class="sc-label">Pendientes</div>
                    <div class="sc-value text-danger-val">@ViewBag.Pendientes</div>
                </div>
            </div>

            <!-- En Proceso -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-warning">
                    <div class="sc-icon ic-amber">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>
                    <div class="sc-label">En proceso</div>
                    <div class="sc-value text-warning-val">@ViewBag.EnProceso</div>
                </div>
            </div>

            <!-- Finalizadas -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-success">
                    <div class="sc-icon ic-green">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="sc-label">Finalizadas</div>
                    <div class="sc-value text-success-val">@ViewBag.Finalizadas</div>
                </div>
            </div>

        </div>

        <!-- SECCION GRAFICOS -->
        <div class="row g-4 mb-4">

            <!-- Incidencias por Estado -->
            <div class="col-lg-5">
                <div class="form-container h-100" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-pie-chart me-2"></i>Incidencias por estado</h5>
                    <div style="height: 250px; position: relative;" class="mt-3">
                        <canvas id="estadoChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tendencia Mensual -->
            <div class="col-lg-7">
                <div class="form-container h-100" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-graph-up me-2"></i>Tendencia mensual</h5>
                    <div style="height: 250px; position: relative;" class="mt-3">
                        <canvas id="mesChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- UNIDADES CON MAS PROBLEMAS Y TABLA -->
        <div class="row g-4">

            <!-- Ranking Unidades -->
            <div class="col-lg-4">
                <div class="form-container h-100" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-building me-2"></i>Unidades más afectadas</h5>

                    <ul class="problems-list mt-3">
                        @foreach (var item in ViewBag.UnidadesProblema)
                        {
                            <li class="problem-item">
                                <span class="unit-badge">
                                    <i class="bi bi-door-open-fill"></i>
                                    Unidad @item.Unidad
                                </span>
                                <span class="badge-estado badge-otro font-weight-bold">
                                    @item.Cantidad reportes
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Ultimas Incidencias -->
            <div class="col-lg-8">
                <div class="table-card">

                    <div class="table-card-head">
                        <p class="tc-title">
                            <i class="bi bi-list-ul"></i>
                            Últimas incidencias reportadas
                        </p>
                    </div>

                    <div class="table-responsive">
                        <table class="inc-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Unidad</th>
                                    <th>Residente</th>
                                    <th>Estado</th>
                                    <th>Técnico</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var nombreResidente = item.IdUsuarioNavigation != null
                                        ? $"{item.IdUsuarioNavigation.Nombre} {item.IdUsuarioNavigation.Apellido}".Trim()
                                        : "Sin residente";

                                    <tr>
                                        <!-- Fecha -->
                                        <td>
                                            <span class="date-cell">
                                                <i class="bi bi-calendar me-1"></i>@(item.FechaSolicitud?.ToString("dd/MM/yyyy"))
                                            </span>
                                        </td>

                                        <!-- Unidad -->
                                        <td>
                                            <span class="unit-pill">
                                                @(item.IdUnidadNavigation?.Numero ?? "—")
                                            </span>
                                        </td>

                                        <!-- Residente -->
                                        <td>
                                            <span class="date-cell font-weight-semibold">@nombreResidente</span>
                                        </td>

                                        <!-- Estado -->
                                        <td>
                                            @if (string.Equals(item.Estado, "Pendiente", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge-estado badge-pendiente">
                                                    <span class="dot"></span> Pendiente
                                                </span>
                                            }
                                            else if (string.Equals(item.Estado, "En proceso", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge-estado badge-proceso">
                                                    <span class="dot"></span> En proceso
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-estado badge-resuelta">
                                                    <span class="dot"></span> @item.Estado
                                                </span>
                                            }
                                        </td>

                                        <!-- Técnico -->
                                        <td>
                                            <span class="date-cell font-weight-medium">
                                                <i class="bi bi-person-badge me-1"></i>@(item.TecnicoAsignado ?? "Sin asignar")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
        --gac-success: #22c55e;
        --gac-warning: #f59e0b;
        --gac-danger: #ef4444;
        --gac-border: #eef1f6;
        --gac-surface: #f4f6fb;
    }

    .mnt-page {
        background: var(--gac-surface);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* ── HEADER ── */
    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 1.75rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: 0 8px 24px rgba(15,22,35,.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -.02em;
            margin: 0;
            font-family: 'Sora', sans-serif;
        }

        .page-header p {
            color: rgba(255,255,255,.6);
            margin: 0;
            font-size: .875rem;
        }

    /* ── BUTTONS ── */
    .btn-gac {
        font-weight: 600;
        border-radius: 10px;
        padding: .65rem 1.4rem;
        font-size: .875rem;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .btn-gac-secondary-header {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        color: #fff;
    }

        .btn-gac-secondary-header:hover {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

    /* ── FORM CONTAINER ── */
    .form-container {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        box-shadow: 0 10px 30px rgba(15,22,35,.03);
    }

    .section-title-gac {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

    /* ── STAT CARDS ── */
    .stat-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        padding: 1.4rem;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 16px 16px 0 0;
        }

        .stat-card.sc-info::after {
            background: var(--gac-primary);
        }

        .stat-card.sc-warning::after {
            background: var(--gac-warning);
        }

        .stat-card.sc-success::after {
            background: var(--gac-success);
        }

        .stat-card.sc-danger::after {
            background: var(--gac-danger);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15,22,35,.07);
        }

    .sc-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: .85rem;
    }

    .ic-blue {
        background: rgba(37,140,251,.1);
        color: var(--gac-primary);
    }

    .ic-amber {
        background: rgba(245,158,11,.1);
        color: #d97706;
    }

    .ic-green {
        background: rgba(34,197,94,.1);
        color: #16a34a;
    }

    .ic-red {
        background: rgba(239,68,68,.1);
        color: var(--gac-danger);
    }

    .sc-label {
        font-size: .77rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: .25rem;
    }

    .sc-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--gac-navy);
        line-height: 1.1;
        font-family: 'Sora', sans-serif;
    }

    .text-danger-val {
        color: var(--gac-danger);
    }

    .text-warning-val {
        color: #d97706;
    }

    .text-success-val {
        color: #16a34a;
    }

    /* ── PROBLEMS LIST ── */
    .problems-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .problem-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1rem;
        background: var(--gac-surface);
        border: 1px solid var(--gac-border);
        border-radius: 10px;
        font-size: .88rem;
        transition: all .2s ease;
    }

        .problem-item:hover {
            border-color: var(--gac-primary);
            background: #fff;
        }

    .unit-badge {
        font-weight: 600;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .unit-badge i {
            color: var(--gac-primary);
        }

    /* ── TABLE CARD ── */
    .table-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        overflow: hidden;
    }

    .table-card-head {
        padding: 1rem 1.4rem;
        border-bottom: 1px solid var(--gac-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tc-title {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

        .tc-title i {
            color: var(--gac-primary);
        }

    .inc-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .inc-table thead {
            background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        }

            .inc-table thead th {
                font-size: .73rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: rgba(255,255,255,.7);
                font-weight: 700;
                padding: .9rem 1.1rem;
                border: none;
                white-space: nowrap;
                text-align: left;
            }

        .inc-table tbody td {
            padding: .85rem 1.1rem;
            color: #334155;
            vertical-align: middle;
            border-bottom: 1px solid #f1f4f9;
            font-size: .9rem;
        }

        .inc-table tbody tr:last-child td {
            border-bottom: none;
        }

        .inc-table tbody tr {
            transition: background .15s ease;
        }

            .inc-table tbody tr:hover {
                background: #fafcff;
            }

    .unit-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(15,22,35,.05);
        border-radius: 50px;
        padding: .3rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        color: var(--gac-navy);
        white-space: nowrap;
    }

    .date-cell {
        font-size: .83rem;
        color: #64748b;
        white-space: nowrap;
    }

    .font-weight-semibold {
        font-weight: 600;
    }

    .font-weight-medium {
        font-weight: 500;
    }

    /* ── BADGES ── */
    .badge-estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
        font-size: .73rem;
        padding: .35rem .85rem;
        border-radius: 50px;
        letter-spacing: .02em;
        white-space: nowrap;
    }

        .badge-estado .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-resuelta {
        background: rgba(34,197,94,.12);
        color: #15803d;
    }

        .badge-resuelta .dot {
            background: var(--gac-success);
        }

    .badge-pendiente {
        background: rgba(245,158,11,.12);
        color: #b45309;
    }

        .badge-pendiente .dot {
            background: var(--gac-warning);
        }

    .badge-proceso {
        background: rgba(37,140,251,.12);
        color: #1c5fb4;
    }

        .badge-proceso .dot {
            background: var(--gac-primary);
        }

    .badge-otro {
        background: rgba(15,22,35,.07);
        color: var(--gac-navy);
    }

        .badge-otro .dot {
            background: #94a3b8;
        }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===============================
        // GRAFICO ESTADOS (DOUGHNUT)
        // ===============================
        const estados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.IncidenciasEstado));

        const getEstadoColor = (estado) => {
            const e = estado.toLowerCase();
            if (e.includes('pendiente')) return '#f59e0b'; // warning
            if (e.includes('proceso')) return '#258cfb'; // info / primary
            if (e.includes('finalizada') || e.includes('resuelta') || e.includes('completada')) return '#22c55e'; // success
            return '#94a3b8'; // slate / muted
        };

        new Chart(
            document.getElementById('estadoChart'),
            {
                type: 'doughnut',
                data: {
                    labels: estados.map(x => x.Estado),
                    datasets: [{
                        data: estados.map(x => x.Cantidad),
                        backgroundColor: estados.map(x => getEstadoColor(x.Estado)),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Inter', size: 12, weight: 500 },
                                color: '#64748b',
                                padding: 15
                            }
                        }
                    },
                    cutout: '72%'
                }
            }
        );

        // ===============================
        // GRAFICO MENSUAL (LINE)
        // ===============================
        const meses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.IncidenciasMes));

        new Chart(
            document.getElementById('mesChart'),
            {
                type: 'line',
                data: {
                    labels: meses.map(x => x.Mes + "/" + x.Año),
                    datasets: [{
                        label: "Incidencias",
                        data: meses.map(x => x.Cantidad),
                        borderColor: '#258cfb',
                        backgroundColor: 'rgba(37,140,251,0.06)',
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true,
                        pointBackgroundColor: '#258cfb',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            grid: { color: '#f1f4f9' },
                            ticks: { font: { family: 'Inter' }, color: '#64748b' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter' }, color: '#64748b' }
                        }
                    }
                }
            }
        );
    </script>
}
