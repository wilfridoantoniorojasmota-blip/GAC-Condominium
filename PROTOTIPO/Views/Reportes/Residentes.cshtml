
@model IEnumerable<PROTOTIPO.Models.Usuario>

@{
    ViewData["Title"] = "Reporte de Residentes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<div class="mnt-page">
    <div class="container-fluid py-4 px-3 px-md-4">

        <!-- HEADER -->
        <div class="page-header mb-4">
            <div>
                <h3><i class="bi bi-people-fill me-2"></i>Reporte de Residentes</h3>
                <p>Información general sobre usuarios, distribución de roles y contratos vigentes</p>
            </div>

            <a asp-controller="Reportes" asp-action="Index" class="btn-gac btn-gac-secondary-header">
                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>
        </div>

        <!-- TARJETAS ESTADISTICAS (3 Columnas) -->
        <div class="row g-3 mb-4">

            <!-- Total Residentes -->
            <div class="col-12 col-md-4">
                <div class="stat-card sc-info">
                    <div class="sc-icon ic-blue">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="sc-label">Total residentes</div>
                    <div class="sc-value">@ViewBag.Total</div>
                </div>
            </div>

            <!-- Con Contrato Activo -->
            <div class="col-6 col-md-4">
                <div class="stat-card sc-success">
                    <div class="sc-icon ic-green">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="sc-label">Con contrato activo</div>
                    <div class="sc-value text-success-val">@ViewBag.ConContrato</div>
                </div>
            </div>

            <!-- Sin Contrato -->
            <div class="col-6 col-md-4">
                <div class="stat-card sc-warning">
                    <div class="sc-icon ic-amber">
                        <i class="bi bi-shield-slash"></i>
                    </div>
                    <div class="sc-label">Sin contrato</div>
                    <div class="sc-value text-warning-val">@ViewBag.SinContrato</div>
                </div>
            </div>

        </div>

        <!-- SECCION GRAFICOS / ULTIMOS REGISTROS -->
        <div class="row g-4 mb-4">

            <!-- Distribución por Rol -->
            <div class="col-md-6">
                <div class="form-container h-100" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-pie-chart me-2"></i>Residentes por rol</h5>
                    <div style="height: 250px; position: relative;" class="mt-3">
                        <canvas id="rolChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Últimos Registrados -->
            <div class="col-md-6">
                <div class="form-container h-100" style="padding: 1.5rem 2rem; overflow: hidden;">
                    <h5 class="section-title-gac"><i class="bi bi-person-plus me-2"></i>Últimos residentes registrados</h5>

                    <div class="table-responsive mt-3">
                        <table class="inc-table">
                            <thead>
                                <tr>
                                    <th>Nombre completo</th>
                                    <th>Rol asignado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in ViewBag.UltimosResidentes)
                                {
                                    var fullName = $"{r.Nombre} {r.Apellido}".Trim();
                                    <tr>
                                        <td>
                                            <span class="date-cell font-weight-semibold">@fullName</span>
                                        </td>
                                        <td>
                                            <span class="unit-pill text-uppercase">
                                                @(r.IdRolNavigation?.Nombre ?? "N/A")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <!-- TABLA GENERAL DE RESIDENTES -->
        <div class="table-card">

            <div class="table-card-head">
                <p class="tc-title">
                    <i class="bi bi-list-ul"></i>
                    Listado general de residentes
                </p>
                <span class="tc-count">@Model.Count() usuarios</span>
            </div>

            <div class="table-responsive">
                <table class="inc-table">
                    <thead>
                        <tr>
                            <th>Nombre completo</th>
                            <th>Cédula</th>
                            <th>Teléfono / Contacto</th>
                            <th>Rol</th>
                            <th>Unidad</th>
                            <th>Estado Contrato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var contrato = item.ContratoAlquilers
                                .FirstOrDefault(c => c.Estado != null && string.Equals(c.Estado, "activo", StringComparison.OrdinalIgnoreCase));

                            var fullName = $"{item.Nombre} {item.Apellido}".Trim();

                            <tr>
                                <!-- Nombre -->
                                <td>
                                    <span class="date-cell font-weight-semibold">@fullName</span>
                                </td>

                                <!-- Cédula -->
                                <td>
                                    <span class="date-cell text-monospace">@(item.Cedula ?? "—")</span>
                                </td>

                                <!-- Teléfono -->
                                <td>
                                    <span class="date-cell">
                                        <i class="bi bi-telephone me-1"></i>@(item.Telefono ?? "—")
                                    </span>
                                </td>

                                <!-- Rol -->
                                <td>
                                    <span class="unit-pill text-uppercase">
                                        @(item.IdRolNavigation?.Nombre ?? "N/A")
                                    </span>
                                </td>

                                <!-- Unidad -->
                                <td>
                                    <span class="unit-pill">
                                        <i class="bi bi-door-open-fill me-1"></i>
                                        @(contrato?.IdUnidadNavigation?.Numero ?? "Sin unidad")
                                    </span>
                                </td>

                                <!-- Estado -->
                                <td>
                                    @if (contrato != null)
                                    {
                                        <span class="badge-estado badge-resuelta">
                                            <span class="dot"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-estado badge-otro">
                                            <span class="dot"></span> Sin contrato
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</div>

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
        --gac-success: #22c55e;
        --gac-warning: #f59e0b;
        --gac-danger: #ef4444;
        --gac-border: #eef1f6;
        --gac-surface: #f4f6fb;
    }

    .mnt-page {
        background: var(--gac-surface);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* ── HEADER ── */
    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 1.75rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: 0 8px 24px rgba(15,22,35,.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -.02em;
            margin: 0;
            font-family: 'Sora', sans-serif;
        }

        .page-header p {
            color: rgba(255,255,255,.6);
            margin: 0;
            font-size: .875rem;
        }

    /* ── BUTTONS ── */
    .btn-gac {
        font-weight: 600;
        border-radius: 10px;
        padding: .65rem 1.4rem;
        font-size: .875rem;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .btn-gac-secondary-header {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        color: #fff;
    }

        .btn-gac-secondary-header:hover {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

    /* ── CONTAINER ── */
    .form-container {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        box-shadow: 0 10px 30px rgba(15,22,35,.03);
    }

    .section-title-gac {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

    /* ── STAT CARDS ── */
    .stat-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        padding: 1.4rem;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 16px 16px 0 0;
        }

        .stat-card.sc-info::after {
            background: var(--gac-primary);
        }

        .stat-card.sc-warning::after {
            background: var(--gac-warning);
        }

        .stat-card.sc-success::after {
            background: var(--gac-success);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15,22,35,.07);
        }

    .sc-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: .85rem;
    }

    .ic-blue {
        background: rgba(37,140,251,.1);
        color: var(--gac-primary);
    }

    .ic-amber {
        background: rgba(245,158,11,.1);
        color: #d97706;
    }

    .ic-green {
        background: rgba(34,197,94,.1);
        color: #16a34a;
    }

    .sc-label {
        font-size: .77rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: .25rem;
    }

    .sc-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--gac-navy);
        line-height: 1.1;
        font-family: 'Sora', sans-serif;
    }

    .text-success-val {
        color: #16a34a;
    }

    .text-warning-val {
        color: #d97706;
    }

    /* ── TABLE CARD ── */
    .table-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        overflow: hidden;
    }

    .table-card-head {
        padding: 1rem 1.4rem;
        border-bottom: 1px solid var(--gac-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tc-title {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

        .tc-title i {
            color: var(--gac-primary);
        }

    .tc-count {
        font-size: .75rem;
        font-weight: 600;
        color: #64748b;
        background: var(--gac-surface);
        border: 1px solid var(--gac-border);
        border-radius: 20px;
        padding: 3px 11px;
    }

    .inc-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .inc-table thead {
            background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        }

            .inc-table thead th {
                font-size: .73rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: rgba(255,255,255,.7);
                font-weight: 700;
                padding: .9rem 1.1rem;
                border: none;
                white-space: nowrap;
                text-align: left;
            }

        .inc-table tbody td {
            padding: .85rem 1.1rem;
            color: #334155;
            vertical-align: middle;
            border-bottom: 1px solid #f1f4f9;
            font-size: .9rem;
        }

        .inc-table tbody tr:last-child td {
            border-bottom: none;
        }

        .inc-table tbody tr {
            transition: background .15s ease;
        }

            .inc-table tbody tr:hover {
                background: #fafcff;
            }

    .unit-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(15,22,35,.05);
        border-radius: 50px;
        padding: .3rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        color: var(--gac-navy);
        white-space: nowrap;
    }

    .date-cell {
        font-size: .83rem;
        color: #64748b;
        white-space: nowrap;
    }

    .text-monospace {
        font-family: var(--bs-font-monospace);
        font-size: .82rem;
        color: var(--gac-navy);
    }

    .font-weight-semibold {
        font-weight: 600;
    }

    /* ── BADGES ── */
    .badge-estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
        font-size: .73rem;
        padding: .35rem .85rem;
        border-radius: 50px;
        letter-spacing: .02em;
        white-space: nowrap;
    }

        .badge-estado .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-resuelta {
        background: rgba(34,197,94,.12);
        color: #15803d;
    }

        .badge-resuelta .dot {
            background: var(--gac-success);
        }

    .badge-pendiente {
        background: rgba(245,158,11,.12);
        color: #b45309;
    }

        .badge-pendiente .dot {
            background: var(--gac-warning);
        }

    .badge-otro {
        background: rgba(15,22,35,.07);
        color: var(--gac-navy);
    }

        .badge-otro .dot {
            background: #94a3b8;
        }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ==========================
        // ROLES CHART (DOUGHNUT)
        // ==========================
        const roles = @Html.Raw(Json.Serialize(ViewBag.ResidentesRol));

        const colors = ['#258cfb', '#a855f7', '#22c55e', '#f59e0b', '#ef4444', '#94a3b8', '#06b6d4'];

        new Chart(
            document.getElementById("rolChart"),
            {
                type: "doughnut",
                data: {
                    labels: roles.map(x => x.rol),
                    datasets: [{
                        data: roles.map(x => x.cantidad),
                        backgroundColor: colors.slice(0, roles.length),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Inter', size: 12, weight: 500 },
                                color: '#64748b',
                                padding: 15
                            }
                        }
                    },
                    cutout: '72%'
                }
            }
        );
    </script>
}
