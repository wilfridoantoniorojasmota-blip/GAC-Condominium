
@model IEnumerable<PROTOTIPO.Models.ContratoAlquiler>

@{
    ViewData["Title"] = "Reporte de Contratos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<div class="mnt-page">
    <div class="container-fluid py-4 px-3 px-md-4">

        <!-- HEADER -->
        <div class="page-header mb-4">
            <div>
                <h3><i class="bi bi-file-earmark-check-fill me-2"></i>Reporte de Contratos</h3>
                <p>Resumen general, análisis de vigencia e ingresos mensuales por contratos</p>
            </div>

            <a asp-controller="Reportes" asp-action="Index" class="btn-gac btn-gac-secondary-header">
                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>
        </div>

        <!-- TARJETAS ESTADISTICAS -->
        <div class="row g-3 mb-4">

            <!-- Total Contratos -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-info">
                    <div class="sc-icon ic-blue">
                        <i class="bi bi-files"></i>
                    </div>
                    <div class="sc-label">Total contratos</div>
                    <div class="sc-value">@ViewBag.Total</div>
                </div>
            </div>

            <!-- Contratos Activos -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-success">
                    <div class="sc-icon ic-green">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="sc-label">Contratos activos</div>
                    <div class="sc-value text-success-val">@ViewBag.Activos</div>
                </div>
            </div>

            <!-- Finalizados -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-slate">
                    <div class="sc-icon ic-slate">
                        <i class="bi bi-archive-fill"></i>
                    </div>
                    <div class="sc-label">Finalizados</div>
                    <div class="sc-value text-muted-val">@ViewBag.Finalizados</div>
                </div>
            </div>

            <!-- Ingresos Mensuales -->
            <div class="col-6 col-md-3">
                <div class="stat-card sc-warning">
                    <div class="sc-icon ic-amber">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="sc-label">Ingresos mensuales</div>
                    <div class="sc-value-currency">RD$ @String.Format("{0:N2}", ViewBag.IngresosMensuales)</div>
                </div>
            </div>

        </div>

        <!-- SECCION GRAFICOS -->
        <div class="row g-4 mb-4">

            <!-- Contratos por Estado -->
            <div class="col-md-6">
                <div class="form-container" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-pie-chart me-2"></i>Contratos por estado</h5>
                    <div style="height: 250px; position: relative;" class="mt-3">
                        <canvas id="estadoChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Contratos Creados -->
            <div class="col-md-6">
                <div class="form-container" style="padding: 1.5rem 2rem;">
                    <h5 class="section-title-gac"><i class="bi bi-bar-chart-steps me-2"></i>Contratos creados</h5>
                    <div style="height: 250px; position: relative;" class="mt-3">
                        <canvas id="mesChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- PROXIMOS A VENCER -->
        <div class="table-card mb-4">

            <div class="table-card-head header-warning-gac">
                <p class="tc-title">
                    <i class="bi bi-exclamation-triangle-fill" style="color: var(--gac-warning);"></i>
                    Contratos próximos a vencer
                </p>
                <span class="tc-count">Por expirar</span>
            </div>

            <div class="table-responsive">
                <table class="inc-table">
                    <thead>
                        <tr>
                            <th>Inquilino</th>
                            <th>Unidad</th>
                            <th>Fecha vencimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProximosVencer != null)
                        {
                            foreach (var contrato in ViewBag.ProximosVencer)
                            {
                                var inquilinoName = contrato.IdUsuarioNavigation != null
                                    ? $"{contrato.IdUsuarioNavigation.Nombre} {contrato.IdUsuarioNavigation.Apellido}".Trim()
                                    : "Sin inquilino";

                                <tr>
                                    <!-- Inquilino -->
                                    <td>
                                        <span class="date-cell font-weight-semibold">@inquilinoName</span>
                                    </td>

                                    <!-- Unidad -->
                                    <td>
                                        <span class="unit-pill">
                                            <i class="bi bi-door-open-fill me-1"></i>
                                            @(contrato.IdUnidadNavigation?.Numero ?? "—")
                                        </span>
                                    </td>

                                    <!-- Vencimiento -->
                                    <td>
                                        <span class="date-cell text-danger-val">
                                            <i class="bi bi-calendar-x me-1"></i>@contrato.FechaFin.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        <span class="badge-estado badge-pendiente">
                                            <span class="dot"></span> Próximo
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
               
            </div>

        </div>

        <!-- TABLA GENERAL -->
        <div class="table-card">

            <div class="table-card-head">
                <p class="tc-title">
                    <i class="bi bi-list-ul"></i>
                    Lista general de contratos
                </p>
                <span class="tc-count">@Model.Count() total</span>
            </div>

            <div class="table-responsive">
                <table class="inc-table">
                    <thead>
                        <tr>
                            <th>Inquilino</th>
                            <th>Unidad</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Renta mensual</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var inquilinoName = item.IdUsuarioNavigation != null
                                ? $"{item.IdUsuarioNavigation.Nombre} {item.IdUsuarioNavigation.Apellido}".Trim()
                                : "Sin inquilino";

                            var esActivo = string.Equals(item.Estado, "activo", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <!-- Inquilino -->
                                <td>
                                    <span class="date-cell font-weight-semibold">@inquilinoName</span>
                                </td>

                                <!-- Unidad -->
                                <td>
                                    <span class="unit-pill">
                                        <i class="bi bi-door-open-fill me-1"></i>
                                        @(item.IdUnidadNavigation?.Numero ?? "—")
                                    </span>
                                </td>

                                <!-- Inicio -->
                                <td>
                                    <span class="date-cell">
                                        <i class="bi bi-calendar me-1"></i>@(item.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")
                                    </span>
                                </td>

                                <!-- Fin -->
                                <td>
                                    <span class="date-cell">
                                        <i class="bi bi-calendar-event me-1"></i>@(item.FechaFin?.ToString("dd/MM/yyyy") ?? "—")
                                    </span>
                                </td>

                                <!-- Renta -->
                                <td>
                                    <span class="monto-cell">
                                        RD$ @String.Format("{0:N2}", item.MontoRenta)
                                    </span>
                                </td>

                                <!-- Estado -->
                                <td>
                                    @if (esActivo)
                                    {
                                        <span class="badge-estado badge-resuelta">
                                            <span class="dot"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-estado badge-otro">
                                            <span class="dot"></span> Finalizado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav>
                    <ul class="pagination justify-content-center">

                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Contratos"
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>

        </div>

    </div>
</div>

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
        --gac-success: #22c55e;
        --gac-warning: #f59e0b;
        --gac-danger: #ef4444;
        --gac-border: #eef1f6;
        --gac-surface: #f4f6fb;
    }

    .mnt-page {
        background: var(--gac-surface);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* ── HEADER ── */
    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 1.75rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: 0 8px 24px rgba(15,22,35,.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -.02em;
            margin: 0;
            font-family: 'Sora', sans-serif;
        }

        .page-header p {
            color: rgba(255,255,255,.6);
            margin: 0;
            font-size: .875rem;
        }

    /* ── BUTTONS ── */
    .btn-gac {
        font-weight: 600;
        border-radius: 10px;
        padding: .65rem 1.4rem;
        font-size: .875rem;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .btn-gac-secondary-header {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        color: #fff;
    }

        .btn-gac-secondary-header:hover {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

    /* ── CONTAINER ── */
    .form-container {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        box-shadow: 0 10px 30px rgba(15,22,35,.03);
    }

    .section-title-gac {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

    /* ── STAT CARDS ── */
    .stat-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        padding: 1.4rem;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 16px 16px 0 0;
        }

        .stat-card.sc-info::after {
            background: var(--gac-primary);
        }

        .stat-card.sc-warning::after {
            background: var(--gac-warning);
        }

        .stat-card.sc-success::after {
            background: var(--gac-success);
        }

        .stat-card.sc-slate::after {
            background: #94a3b8;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15,22,35,.07);
        }

    .sc-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: .85rem;
    }

    .ic-blue {
        background: rgba(37,140,251,.1);
        color: var(--gac-primary);
    }

    .ic-amber {
        background: rgba(245,158,11,.1);
        color: #d97706;
    }

    .ic-green {
        background: rgba(34,197,94,.1);
        color: #16a34a;
    }

    .ic-slate {
        background: rgba(148, 163, 184, 0.1);
        color: #64748b;
    }

    .sc-label {
        font-size: .77rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: .25rem;
    }

    .sc-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--gac-navy);
        line-height: 1.1;
        font-family: 'Sora', sans-serif;
    }

    .sc-value-currency {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--gac-navy);
        line-height: 1.4;
        font-family: 'Sora', sans-serif;
    }

    .text-success-val {
        color: #16a34a;
    }

    .text-danger-val {
        color: var(--gac-danger);
    }

    .text-muted-val {
        color: #64748b;
    }

    /* ── TABLE CARD ── */
    .table-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--gac-border);
        overflow: hidden;
    }

    .table-card-head {
        padding: 1rem 1.4rem;
        border-bottom: 1px solid var(--gac-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-warning-gac {
        background: #fffbef;
        border-bottom-color: rgba(245,158,11,.15);
    }

    .tc-title {
        font-weight: 700;
        font-size: .95rem;
        color: var(--gac-navy);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        font-family: 'Sora', sans-serif;
    }

        .tc-title i {
            color: var(--gac-primary);
        }

    .tc-count {
        font-size: .75rem;
        font-weight: 600;
        color: #64748b;
        background: var(--gac-surface);
        border: 1px solid var(--gac-border);
        border-radius: 20px;
        padding: 3px 11px;
    }

    .inc-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .inc-table thead {
            background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        }

            .inc-table thead th {
                font-size: .73rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: rgba(255,255,255,.7);
                font-weight: 700;
                padding: .9rem 1.1rem;
                border: none;
                white-space: nowrap;
                text-align: left;
            }

        .inc-table tbody td {
            padding: .85rem 1.1rem;
            color: #334155;
            vertical-align: middle;
            border-bottom: 1px solid #f1f4f9;
            font-size: .9rem;
        }

        .inc-table tbody tr:last-child td {
            border-bottom: none;
        }

        .inc-table tbody tr {
            transition: background .15s ease;
        }

            .inc-table tbody tr:hover {
                background: #fafcff;
            }

    .unit-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(15,22,35,.05);
        border-radius: 50px;
        padding: .3rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        color: var(--gac-navy);
        white-space: nowrap;
    }

    .date-cell {
        font-size: .83rem;
        color: #64748b;
        white-space: nowrap;
    }

    .monto-cell {
        font-weight: 700;
        font-size: .9rem;
        color: var(--gac-navy);
        white-space: nowrap;
    }

    .font-weight-semibold {
        font-weight: 600;
    }

    /* ── BADGES ── */
    .badge-estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
        font-size: .73rem;
        padding: .35rem .85rem;
        border-radius: 50px;
        letter-spacing: .02em;
        white-space: nowrap;
    }

        .badge-estado .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-resuelta {
        background: rgba(34,197,94,.12);
        color: #15803d;
    }

        .badge-resuelta .dot {
            background: var(--gac-success);
        }

    .badge-pendiente {
        background: rgba(245,158,11,.12);
        color: #b45309;
    }

        .badge-pendiente .dot {
            background: var(--gac-warning);
        }

    .badge-otro {
        background: rgba(15,22,35,.07);
        color: var(--gac-navy);
    }

        .badge-otro .dot {
            background: #94a3b8;
        }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // =======================
        // ESTADOS (DOUGHNUT)
        // =======================
        const estados = @Html.Raw(Json.Serialize(ViewBag.ContratosEstado));

        const getEstadoColor = (estado) => {
            const e = estado.toLowerCase();
            if (e.includes('activo')) return '#22c55e'; // success (green)
            if (e.includes('finalizado')) return '#94a3b8'; // slate / muted
            return '#258cfb'; // blue
        };

        new Chart(
            document.getElementById('estadoChart'),
            {
                type: 'doughnut',
                data: {
                    labels: estados.map(x => x.estado),
                    datasets: [{
                        data: estados.map(x => x.cantidad),
                        backgroundColor: estados.map(x => getEstadoColor(x.estado)),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Inter', size: 12, weight: 500 },
                                color: '#64748b',
                                padding: 15
                            }
                        }
                    },
                    cutout: '72%'
                }
            }
        );

        // =======================
        // MESES (BAR CHART)
        // =======================
        const meses = @Html.Raw(Json.Serialize(ViewBag.ContratosMes));

        new Chart(
            document.getElementById('mesChart'),
            {
                type: 'bar',
                data: {
                    labels: meses.map(x => x.mes + '/' + x.año),
                    datasets: [{
                        label: 'Contratos creados',
                        data: meses.map(x => x.cantidad),
                        backgroundColor: '#258cfb',
                        hoverBackgroundColor: '#1a6fd1',
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            grid: { color: '#f1f4f9' },
                            ticks: { font: { family: 'Inter' }, color: '#64748b' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter' }, color: '#64748b' }
                        }
                    }
                }
            }
        );
    </script>
}
