@model PROTOTIPO.Models.Usuario

@{
    ViewData["Title"] = "Detalles Usuario";

    var iniciales = "";
    if (!string.IsNullOrEmpty(Model.Nombre)) iniciales += Model.Nombre[0];
    if (!string.IsNullOrEmpty(Model.Apellido)) iniciales += Model.Apellido[0];
    iniciales = iniciales.ToUpper();

    var rolNombre = Model.IdRolNavigation?.Nombre ?? "Sin rol";
    var esAdmin = rolNombre.ToLower().Contains("admin");
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --teal: #0fd4b0;
        --teal-light: #e6fdf9;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 26px;
        --r-pill: 999px;
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07);
        --shadow-md: 0 8px 28px rgba(12,18,32,.09);
        --ease: .22s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Page ───────────────────────────────────────── */
    .det-page {
        max-width: 820px;
        margin: 40px auto;
        padding: 0 24px 64px;
    }

    /* ── Breadcrumb ─────────────────────────────────── */
    .det-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
        font-weight: 500;
        color: var(--ink-muted);
        margin-bottom: 28px;
    }

        .det-breadcrumb a {
            color: var(--ink-muted);
            text-decoration: none;
            transition: color var(--ease);
        }

            .det-breadcrumb a:hover {
                color: var(--accent);
            }

        .det-breadcrumb i.sep {
            font-size: .65rem;
        }

    /* ── Profile hero card ──────────────────────────── */
    .profile-hero {
        background: var(--ink);
        border-radius: var(--r-2xl);
        padding: 36px 36px 0;
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
    }

        /* dot grid */
        .profile-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }
        /* teal glow */
        .profile-hero::after {
            content: '';
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.16) 0%, transparent 68%);
            top: -80px;
            right: -60px;
            pointer-events: none;
        }

    .profile-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        gap: 28px;
        padding-bottom: 32px;
    }

    /* Avatar */
    .profile-avatar {
        width: 88px;
        height: 88px;
        border-radius: 22px;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-d);
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 8px 28px rgba(26,86,232,.45);
        letter-spacing: -.04em;
        border: 3px solid rgba(255,255,255,.15);
    }

    .profile-hero-text {
        flex: 1;
    }

    .profile-name {
        font-family: var(--font-d);
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #fff;
        margin: 0 0 6px;
        line-height: 1.1;
    }

    .profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .profile-rol-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        font-weight: 700;
        padding: 5px 13px;
        border-radius: var(--r-pill);
        letter-spacing: .03em;
        text-transform: capitalize;
    }

    .prb--admin {
        background: rgba(26,86,232,.25);
        border: 1px solid rgba(26,86,232,.4);
        color: #93c5fd;
    }

    .prb--default {
        background: rgba(15,212,176,.18);
        border: 1px solid rgba(15,212,176,.3);
        color: #5eead4;
    }

    .profile-condo {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .8rem;
        color: rgba(255,255,255,.5);
        font-weight: 500;
    }

        .profile-condo i {
            font-size: .85rem;
        }

    /* Floating actions inside hero (top right) */
    .profile-hero-actions {
        position: absolute;
        top: 24px;
        right: 28px;
        z-index: 2;
        display: flex;
        gap: 8px;
    }

    .btn-hero-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-b);
        font-size: .82rem;
        font-weight: 700;
        padding: 9px 18px;
        border-radius: var(--r-lg);
        text-decoration: none;
        transition: var(--ease);
        cursor: pointer;
        border: none;
    }

    .bha--ghost {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.75);
    }

        .bha--ghost:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    .bha--primary {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 4px 14px rgba(26,86,232,.4);
    }

        .bha--primary:hover {
            background: #1447d0;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,86,232,.5);
        }

    /* ── Info card ──────────────────────────────────── */
    .info-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    /* ── Info section ───────────────────────────────── */
    .info-section {
        padding: 28px 32px;
    }

        .info-section + .info-section {
            border-top: 1px solid var(--border);
        }

    .info-section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 22px;
    }

        .info-section-label span {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
        }

    /* ── Info grid ──────────────────────────────────── */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

        .info-grid .ig-item {
            padding: 16px 20px;
            border-radius: var(--r-lg);
            transition: background var(--ease);
        }

            .info-grid .ig-item:hover {
                background: var(--surface);
            }

    .ig-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .09em;
        color: var(--ink-muted);
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .ig-label i {
            font-size: .78rem;
            color: var(--accent);
        }

    .ig-value {
        font-family: var(--font-d);
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.015em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ig-value--muted {
        font-family: var(--font-b);
        font-size: .9rem;
        font-weight: 500;
        color: var(--ink-soft);
        letter-spacing: 0;
    }

    .ig-value--pwd {
        letter-spacing: .2em;
        color: var(--ink-muted);
        font-family: var(--font-b);
        font-size: 1rem;
        font-weight: 400;
    }

    /* copy button */
    .ig-copy {
        background: none;
        border: none;
        color: var(--ink-muted);
        cursor: pointer;
        font-size: .8rem;
        padding: 3px 6px;
        border-radius: 6px;
        transition: var(--ease);
        opacity: 0;
    }

    .ig-item:hover .ig-copy {
        opacity: 1;
    }

    .ig-copy:hover {
        background: var(--accent-light);
        color: var(--accent);
    }

    /* ── Footer bar ─────────────────────────────────── */
    .info-footer {
        background: #f8fafc;
        border-top: 1px solid var(--border);
        padding: 18px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .info-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        color: var(--ink-muted);
    }

        .info-footer-note i {
            color: var(--teal);
        }

    .btn-footer-edit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: var(--r-lg);
        border: none;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        transition: var(--ease);
        box-shadow: 0 4px 14px rgba(26,86,232,.32);
    }

        .btn-footer-edit:hover {
            background: #1447d0;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,86,232,.42);
        }

    /* ── Responsive ─────────────────────────────────── */
    @@media (max-width: 640px) {
        .det-page {
            padding: 0 16px 48px;
        }

        .profile-hero {
            padding: 28px 22px 0;
        }

        .profile-hero-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .profile-hero-actions {
            position: static;
            margin-bottom: 16px;
            justify-content: flex-end;
        }

        .profile-avatar {
            width: 68px;
            height: 68px;
            font-size: 1.5rem;
            border-radius: 16px;
        }

        .profile-name {
            font-size: 1.35rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .info-section {
            padding: 22px 20px;
        }

        .info-footer {
            padding: 16px 20px;
        }
    }
</style>





<div class="det-page">

    <!-- Breadcrumb -->
    <div class="det-breadcrumb">
        <a asp-action="Index">
            <i class="bi bi-people-fill"></i> Usuarios
        </a>

        <i class="bi bi-chevron-right sep"></i>

        <span>Detalles</span>

        <i class="bi bi-chevron-right sep"></i>

        <span>@Model.Nombre @Model.Apellido</span>
    </div>


    <!-- Profile hero -->
    <div class="profile-hero">

        <!-- Actions top-right -->
        <div class="profile-hero-actions">

            <a asp-action="Index"
               class="btn-hero-action bha--ghost">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdUsuario"
               class="btn-hero-action bha--primary">
                <i class="bi bi-pencil-fill"></i>
                Editar
            </a>

        </div>


        <div class="profile-hero-inner">

            <div class="profile-avatar">
                @iniciales
            </div>

            <div class="profile-hero-text">

                <h1 class="profile-name">
                    @Model.Nombre @Model.Apellido
                </h1>

                <div class="profile-meta">

                    <span class="profile-rol-badge @(esAdmin ? "prb--admin" : "prb--default")">

                        <i class="bi @(esAdmin ? "bi-shield-fill" : "bi-person-fill")"></i>

                        @rolNombre

                    </span>


                    @if (Model.IdCondominioNavigation != null)
                    {
                        <span class="profile-condo">

                            <i class="bi bi-buildings-fill"></i>

                            @Model.IdCondominioNavigation.Nombre

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Info card -->
    <div class="info-card">


        <!-- =========================================================
     DATOS PERSONALES
========================================================== -->

        <div class="info-section">

            <div class="info-section-label">
                <span>
                    <i class="bi bi-person-fill"></i>
                </span>
                Datos personales
            </div>

            <div class="info-grid">

                <!-- Tipo de cliente -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-people"></i>
                        Tipo de cliente
                    </div>

                    <div class="ig-value">

                        @if (Model.TipoCliente == "Dominicano")
                        {
                            <span class="profile-rol-badge prb--default"
                                  style="font-size:.72rem; padding:4px 11px;">

                                <i class="bi bi-person-fill"></i>
                                Dominicano

                            </span>
                        }
                        else if (Model.TipoCliente == "Extranjero")
                        {
                            <span class="profile-rol-badge prb--default"
                                  style="font-size:.72rem; padding:4px 11px;">

                                <i class="bi bi-globe"></i>
                                Extranjero

                            </span>
                        }
                        else if (Model.TipoCliente == "Juridico")
                        {
                            <span class="profile-rol-badge prb--default"
                                  style="font-size:.72rem; padding:4px 11px;">

                                <i class="bi bi-building"></i>
                                Jurídico

                            </span>
                        }
                        else
                        {
                            <span class="ig-value--muted">
                                No especificado
                            </span>
                        }

                    </div>

                </div>


                <!-- Nombre -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-person"></i>
                        Nombre
                    </div>

                    <div class="ig-value">
                        @(string.IsNullOrEmpty(Model.Nombre)
                            ? "—"
                            : Model.Nombre)
                    </div>

                </div>


                <!-- Apellido -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-person"></i>
                        Apellido
                    </div>

                    <div class="ig-value">
                        @(string.IsNullOrEmpty(Model.Apellido)
                            ? "—"
                            : Model.Apellido)
                    </div>

                </div>


                <!-- =====================================================
             DOMINICANO
        ====================================================== -->
                @if (Model.TipoCliente == "Dominicano")
                {
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-credit-card-2-front"></i>
                            Cédula
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.Cedula)
                                ? "—"
                                : Model.Cedula)

                            @if (!string.IsNullOrEmpty(Model.Cedula))
                            {
                                <button type="button"
                                        class="ig-copy"
                                        onclick="copiar('@Model.Cedula', this)"
                                        title="Copiar">

                                    <i class="bi bi-copy"></i>

                                </button>
                            }

                        </div>

                    </div>
                }


                <!-- =====================================================
             EXTRANJERO
        ====================================================== -->
                @if (Model.TipoCliente == "Extranjero")
                {
                    <!-- Pasaporte -->
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-passport"></i>
                            Pasaporte
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.Pasaporte)
                                ? "—"
                                : Model.Pasaporte)

                            @if (!string.IsNullOrEmpty(Model.Pasaporte))
                            {
                                <button type="button"
                                        class="ig-copy"
                                        onclick="copiar('@Model.Pasaporte', this)"
                                        title="Copiar">

                                    <i class="bi bi-copy"></i>

                                </button>
                            }

                        </div>

                    </div>


                    <!-- Nacionalidad -->
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-globe"></i>
                            Nacionalidad
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.Nacionalidad)
                                ? "—"
                                : Model.Nacionalidad)

                        </div>

                    </div>
                }


                <!-- =====================================================
             JURÍDICO
        ====================================================== -->
                @if (Model.TipoCliente == "Juridico")
                {
                    <!-- RNC -->
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-building"></i>
                            RNC
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.RNC)
                                ? "—"
                                : Model.RNC)

                            @if (!string.IsNullOrEmpty(Model.RNC))
                            {
                                <button type="button"
                                        class="ig-copy"
                                        onclick="copiar('@Model.RNC', this)"
                                        title="Copiar">

                                    <i class="bi bi-copy"></i>

                                </button>
                            }

                        </div>

                    </div>


                    <!-- Nombre de empresa -->
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-buildings"></i>
                            Nombre de empresa
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.NombreEmpresa)
                                ? "—"
                                : Model.NombreEmpresa)

                        </div>

                    </div>


                    <!-- Persona de contacto -->
                    <div class="ig-item">

                        <div class="ig-label">
                            <i class="bi bi-person-badge"></i>
                            Persona alojada
                        </div>

                        <div class="ig-value ig-value--muted">

                            @(string.IsNullOrEmpty(Model.PersonaAlojada)
                                ? "—"
                                : Model.PersonaAlojada)

                        </div>

                    </div>
                }


                <!-- =====================================================
             TELÉFONO
        ====================================================== -->

                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-telephone"></i>
                        Teléfono
                    </div>

                    <div class="ig-value ig-value--muted">

                        @(string.IsNullOrEmpty(Model.Telefono)
                            ? "—"
                            : Model.Telefono)

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             CONTACTO Y ACCESO
        ========================================================== -->

        <div class="info-section">

            <div class="info-section-label">

                <span>
                    <i class="bi bi-shield-lock-fill"></i>
                </span>

                Contacto y credenciales

            </div>


            <div class="info-grid">

                <!-- Email -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-envelope"></i>
                        Correo electrónico
                    </div>

                    <div class="ig-value ig-value--muted">

                        @(string.IsNullOrEmpty(Model.Email)
                            ? "—"
                            : Model.Email)

                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <button class="ig-copy"
                                    onclick="copiar('@Model.Email', this)"
                                    title="Copiar">

                                <i class="bi bi-copy"></i>

                            </button>
                        }

                    </div>

                </div>


                <!-- Contraseña -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-lock"></i>
                        Contraseña
                    </div>

                    <div class="ig-value ig-value--pwd">
                        ••••••••
                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             SISTEMA
        ========================================================== -->

        <div class="info-section">

            <div class="info-section-label">

                <span>
                    <i class="bi bi-sliders"></i>
                </span>

                Configuración del sistema

            </div>


            <div class="info-grid">

                <!-- Rol -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-person-badge"></i>
                        Rol
                    </div>

                    <div class="ig-value">

                        <span class="profile-rol-badge @(esAdmin ? "prb--admin" : "prb--default")"
                              style="font-size:.72rem; padding:4px 11px;">

                            <i class="bi @(esAdmin ? "bi-shield-fill" : "bi-person-fill")"></i>

                            @rolNombre

                        </span>

                    </div>

                </div>


                <!-- Condominio -->
                <div class="ig-item">

                    <div class="ig-label">
                        <i class="bi bi-buildings"></i>
                        Condominio
                    </div>

                    <div class="ig-value ig-value--muted">

                        @(Model.IdCondominioNavigation?.Nombre ?? "—")

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             FOOTER
        ========================================================== -->

        <div class="info-footer">

            <div class="info-footer-note">

                <i class="bi bi-shield-check-fill"></i>

                Información protegida del sistema

            </div>


            <a asp-action="Edit"
               asp-route-id="@Model.IdUsuario"
               class="btn-footer-edit">

                <i class="bi bi-pencil-fill"></i>

                Editar usuario

            </a>

        </div>

    </div>

</div>


<script>

    function copiar(texto, btn) {

        navigator.clipboard.writeText(texto).then(() => {

            const ico = btn.querySelector('i');

            ico.className = 'bi bi-check-lg';

            btn.style.color = '#15803d';

            setTimeout(() => {

                ico.className = 'bi bi-copy';

                btn.style.color = '';

            }, 1800);

        });

    }

</script>