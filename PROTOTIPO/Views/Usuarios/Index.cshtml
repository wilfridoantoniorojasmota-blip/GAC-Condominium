<!--
    MODAL DE ERROR — CORREGIDO
    Antes tenía el mensaje "tiene un contrato activo" escrito fijo en el HTML,
    así que se mostraba para CUALQUIER error (token CSRF inválido, excepción,
    fallo de red, etc.), no solo cuando el backend rechazaba por contrato activo.
    Ahora el texto se llena dinámicamente vía JS con el mensaje real del servidor
    (id="errorUserMessage"), y el título/ícono quedan genéricos.
-->
<div class="modal fade" id="errorUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.15);">
            <div class="modal-body" style="padding: 32px; background: #ffffff;">
                <div style="background: #fef2f2; border: 2px solid #fecaca; border-radius: 12px; padding: 20px; text-align: center;">
                    <i class="fa-solid fa-circle-exclamation" style="color: #ef4444; font-size: 32px; display: block; margin-bottom: 12px;"></i>
                    <p id="errorUserMessage" style="margin: 0; font-weight: 600; font-size: 16px; color: #dc2626; line-height: 1.5;">
                        No se pudo eliminar el usuario.
                    </p>
                </div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid #e5e7eb; padding: 16px 32px; background: #ffffff;">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" style="width: 100%; border-radius: 8px;">
                    Entendido
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        /* ── Reopen offcanvas on validation error ── */
        (function() {
            var show = '@(ViewBag.ShowResidentModal ?? false)'.toLowerCase();
            if (show === 'true') {
                bootstrap.Offcanvas.getOrCreateInstance(
                    document.getElementById('residentModal')
                ).show();
            }
        })();

        /* ── Live search ── */
        const searchInput = document.getElementById('searchInput');
        const rows = document.querySelectorAll('#residentesTable .gac-row');
        const countLabel = document.getElementById('countLabel');
        const emptyState = document.getElementById('emptyState');

        searchInput.addEventListener('input', function() {
            const q = this.value.toLowerCase().trim();
            let visible = 0;
            rows.forEach(row => {
                const match = !q || row.dataset.search.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            countLabel.textContent = visible;
            emptyState.style.display = visible === 0 ? 'flex' : 'none';
        });

        /* ── Toast auto-dismiss ── */
        const toast = document.getElementById('gacToast');
        if (toast) setTimeout(() => toast.classList.remove('show'), 4000);

        /* ── Password toggle ── */
        document.querySelectorAll('.pwd-toggle').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const input = this.parentElement.querySelector('.pwd-input');
                const icon = this.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                    this.classList.add('active');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                    this.classList.remove('active');
                }
            });
        });

        /* ── Eliminar usuario ── */
        let usuarioIdToDelete = null;
        let usuarioNombreToDelete = null;

        function eliminarUsuario(id, nombre) {
            usuarioIdToDelete = id;
            usuarioNombreToDelete = nombre;

            // Mostrar modal de confirmación
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
            document.getElementById('deleteMessage').textContent =
                `¿Estás seguro de que deseas eliminar a ${nombre}?`;
            deleteModal.show();
        }

        // Muestra el modal de error con el mensaje REAL recibido
        // (antes el texto estaba fijo en el HTML y aparecía para
        // cualquier tipo de fallo, incluyendo errores de red o de CSRF)
        function mostrarErrorEliminar(mensaje) {
            const errorMsgEl = document.getElementById('errorUserMessage');
            if (errorMsgEl) errorMsgEl.textContent = mensaje;

            const errorModal = new bootstrap.Modal(document.getElementById('errorUserModal'));
            errorModal.show();
        }

        // Manejar confirmación de eliminación
        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!usuarioIdToDelete) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/Usuarios/Delete/${usuarioIdToDelete}`, {
                    method: 'POST',
                    headers: {
                        // IMPORTANTE: el nombre por defecto que ASP.NET Core espera
                        // para el token antifalsificación enviado por header es
                        // "RequestVerificationToken", NO "X-CSRF-TOKEN".
                        // Si tu Program.cs configura AntiforgeryOptions.HeaderName
                        // con otro nombre, ajusta esto para que coincida.
                        'RequestVerificationToken': token,
                        'Accept': 'application/json'
                    }
                });

                // Cerrar modal de confirmación
                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteUserModal'));
                if (deleteModal) {
                    deleteModal.hide();
                }

                if (!response.ok) {
                    // La petición no llegó a completarse como se esperaba:
                    // token antifalsificación inválido, error 500, etc.
                    // Antes esto caía silenciosamente en el mismo modal
                    // genérico de "contrato activo".
                    console.error('Delete request failed with status', response.status);
                    mostrarErrorEliminar(
                        `No se pudo procesar la solicitud (código ${response.status}). ` +
                        `Verifica el token de seguridad o intenta recargar la página.`
                    );
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    // Mostrar toast de éxito
                    if (toast) {
                        toast.classList.add('show');
                        setTimeout(() => toast.classList.remove('show'), 3000);
                    }

                    // Recargar la página después de 1 segundo
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    // Mostrar el MENSAJE REAL que envía el controlador
                    // (antes se ignoraba data.message por completo)
                    mostrarErrorEliminar(data.message || 'No se pudo eliminar el usuario.');
                }

            } catch (error) {
                console.error('Error:', error);
                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteUserModal'));
                if (deleteModal) {
                    deleteModal.hide();
                }
                mostrarErrorEliminar('Ocurrió un error de red al intentar eliminar el usuario.');
            }
        });

        /* ══════════ CHARTS ══════════ */
        Chart.defaults.font.family = "'Outfit', sans-serif";

        /* Donut — ocupación */
        new Chart(document.getElementById('chartOcupacion'), {
            type: 'doughnut',
            data: {
                labels: ['Con unidad', 'Sin unidad'],
                datasets: [{
                    data: [@conUnidad, @sinUnidad],
                    backgroundColor: ['#258cfb', '#f97316'],
                    hoverBackgroundColor: ['#1a6fd4', '#ea7221'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${ctx.parsed} residente${ctx.parsed !== 1 ? 's' : ''}`
                        }
                    }
                }
            }
        });

        /* Barras horizontales — roles */
        new Chart(document.getElementById('chartRoles'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(roleLabels)],
                datasets: [{
                    data: [@roleData],
                    backgroundColor: [@Html.Raw(roleColors)],
                    borderRadius: 8,
                    borderSkipped: false,
                    barThickness: 22
                }]
            },
            options: {
                indexAxis: 'y',
                plugins: {
                    legend: { display: false }, tooltip: {
                        callbacks: { label: ctx => ` ${ctx.parsed.x} residente${ctx.parsed.x !== 1 ? 's' : ''}` }
                    }
                },
                scales: {
                    x: {
                        grid: { color: '#f1f5f9' },
                        ticks: { color: '#64748b', font: { size: 11 }, stepSize: 1, precision: 0 }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: '#374151', font: { size: 12, weight: '600' } }
                    }
                }
            }
        });
    </script>
}

