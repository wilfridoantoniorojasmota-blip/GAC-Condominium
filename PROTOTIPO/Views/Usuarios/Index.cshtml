@using System.Collections.Generic

@model IEnumerable<PROTOTIPO.Models.Usuario>

@{
    ViewData["Title"] = "Residentes";

    var totalResidentes = ViewBag.TotalResidentes;

    var conUnidad = ViewBag.ConUnidad;

    var sinUnidad = ViewBag.SinUnidad;

    var roleGroups =
        ((IEnumerable<dynamic>)ViewBag.RoleGroups).ToList();

    var roleLabels = string.Join(",",
        roleGroups.Select(r => $"\"{r.Nombre}\""));

    var roleData = string.Join(",",
        roleGroups.Select(r => r.Count));

    var roleColorPalette = new[]
    {
        "#a855f7",
        "#258cfb",
        "#22c55e",
        "#f97316",
        "#ef4444",
        "#0ea5e9"
    };

    var roleColors = string.Join(",",
        roleGroups.Select((r, i) =>
            $"\"{roleColorPalette[i % roleColorPalette.Length]}\""));
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="gac-toast show" id="gacToast">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="gac-page">

    <!-- ══════════════ PAGE HEADER ══════════════ -->
    <div class="gac-header">
        <div class="gac-header-left">
            <div class="gac-header-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <h1 class="gac-title">Residentes</h1>
                <p class="gac-subtitle">Gestión de usuarios del condominio</p>
            </div>
        </div>
        <button class="gac-btn-primary"
                data-bs-toggle="offcanvas"
                data-bs-target="#residentModal">
            <i class="fa-solid fa-plus"></i>
            Nuevo residente
        </button>
    </div>

    <!-- ══════════════ STAT CARDS ══════════════ -->
    <div class="gac-stats">

        <div class="gac-stat-card">
            <div class="gac-stat-icon" style="background:#eff6ff;">
                <i class="fa-solid fa-users" style="color:#3b82f6;"></i>
            </div>
            <div>
                <p class="gac-stat-label">Total residentes</p>
                <p class="gac-stat-value">@totalResidentes</p>
            </div>
        </div>

        <div class="gac-stat-card">
            <div class="gac-stat-icon" style="background:#f0fdf4;">
                <i class="fa-solid fa-house-circle-check" style="color:#22c55e;"></i>
            </div>
            <div>
                <p class="gac-stat-label">Con unidad asignada</p>
                <p class="gac-stat-value">@conUnidad</p>
            </div>
        </div>

        <div class="gac-stat-card">
            <div class="gac-stat-icon" style="background:#fdf4ff;">
                <i class="fa-solid fa-id-badge" style="color:#a855f7;"></i>
            </div>
            <div>
                <p class="gac-stat-label">Roles distintos</p>
                <p class="gac-stat-value">@roleGroups.Count</p>
            </div>
        </div>

        <div class="gac-stat-card">
            <div class="gac-stat-icon" style="background:#fff7ed;">
                <i class="fa-solid fa-user-slash" style="color:#f97316;"></i>
            </div>
            <div>
                <p class="gac-stat-label">Sin unidad</p>
                <p class="gac-stat-value">@sinUnidad</p>
            </div>
        </div>

    </div>

    <!-- ══════════════ MAIN CONTENT (tabla + panel) ══════════════ -->
    <div class="gac-content-grid">

        <!-- ── TABLA ── -->
        <div class="gac-card gac-table-col">

            <div class="gac-table-toolbar">
                <div class="gac-search-wrap">
                    <i class="fa-solid fa-magnifying-glass gac-search-icon"></i>
                    <input type="text"
                           id="searchInput"
                           class="gac-search"
                           placeholder="Buscar residente, email, unidad…" />
                </div>
                <span class="gac-count-pill">
                    <span id="countLabel">@totalResidentes</span> registros
                </span>
            </div>

            <div class="gac-table-wrapper">
                <table class="gac-table" id="residentesTable">
                    <thead>
                        <tr>
                            <th>Residente</th>
                            <th>Contacto</th>
                            <th>Unidad</th>
                            <th>Rol</th>
                            <th style="text-align:right;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var nombreCompleto = $"{item.Nombre} {item.Apellido}".Trim();

                            var initials = string.Concat(
                                nombreCompleto
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(w => w[0].ToString().ToUpper())
                            );

                            var unidad = item.ContratoAlquilers
                                    .Where(c => c.Estado != null &&
                                                c.Estado.ToLower() == "activo" &&
                                                c.IdUnidadNavigation != null)
                                    .Select(c => c.IdUnidadNavigation.Numero)
                                    .FirstOrDefault();

                            var rol = item.IdRolNavigation?.Nombre ?? "Sin rol";

                            <tr class="gac-row"
                                data-search="@(nombreCompleto.ToLower()) @(item.Email?.ToLower()) @(unidad?.ToLower()) @(rol.ToLower())">

                                <td>
                                    <div class="gac-avatar-row">
                                        <div class="gac-avatar">@initials</div>

                                        <div>
                                            <p class="gac-name">@nombreCompleto</p>
                                            <p class="gac-email-sub">@item.Email</p>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="gac-phone">
                                        <i class="fa-solid fa-phone"></i>
                                        @(item.Telefono ?? "—")
                                    </span>
                                </td>

                                <td>
                                    @if (unidad != null)
                                    {
                                        <span class="gac-badge gac-badge-blue">
                                            <i class="fa-solid fa-house"></i>
                                            @unidad
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="gac-badge gac-badge-gray">Sin unidad</span>
                                    }
                                </td>

                                <td>
                                    <span class="gac-badge gac-badge-purple">@rol</span>
                                </td>

                                <td>
                                    <div class="gac-actions">
                                        <a asp-action="Details" asp-route-id="@item.IdUsuario"
                                           class="gac-action-btn gac-btn-view">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.IdUsuario"
                                           class="gac-action-btn gac-btn-edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <button type="button"
                                                class="gac-action-btn gac-btn-delete"
                                                onclick="eliminarUsuario(@item.IdUsuario, '@Html.Raw(item.Nombre) @Html.Raw(item.Apellido)')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>

                @if (ViewBag.TotalPages > 1)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    <nav aria-label="Navegación de residentes" class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-md">

            @* Botón Anterior *@
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" 
                   href="@Url.Action("Index", new { page = currentPage - 1 })" 
                   aria-label="Anterior">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @* Números de Página *@
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" 
                       href="@Url.Action("Index", new { page = i })">
                        @i
                    </a>
                </li>
            }

            @* Botón Siguiente *@
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" 
                   href="@Url.Action("Index", new { page = currentPage + 1 })" 
                   aria-label="Siguiente">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>

        </ul>
    </nav>
}

                <div class="gac-empty" id="emptyState" style="display:none;">
                    <i class="fa-solid fa-user-magnifying-glass"></i>
                    <p>No se encontraron residentes</p>
                </div>
            </div>

        </div>

        <!-- ── PANEL DE GRÁFICOS ── -->
        <div class="gac-panel-col">

            <!-- Gráfico 1: Donut — ocupación -->
            <div class="gac-card gac-chart-card">
                <div class="gac-chart-header">
                    <div class="gac-chart-icon" style="background:#eff6ff; color:#3b82f6;">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <div>
                        <p class="gac-chart-title">Ocupación de unidades</p>
                        <p class="gac-chart-sub">Con y sin unidad asignada</p>
                    </div>
                </div>
                <div class="gac-donut-wrap">
                    <canvas id="chartOcupacion"></canvas>
                    <div class="gac-donut-center">
                        <span class="gac-donut-num">@totalResidentes</span>
                        <span class="gac-donut-lbl">Total</span>
                    </div>
                </div>
                <div class="gac-legend">
                    <div class="gac-legend-item">
                        <span class="gac-legend-dot" style="background:#258cfb;"></span>
                        <span>Con unidad</span>
                        <strong>@conUnidad</strong>
                    </div>
                    <div class="gac-legend-item">
                        <span class="gac-legend-dot" style="background:#f97316;"></span>
                        <span>Sin unidad</span>
                        <strong>@sinUnidad</strong>
                    </div>
                </div>
            </div>

            <!-- Gráfico 2: Barras horizontales — roles -->
            <div class="gac-card gac-chart-card">
                <div class="gac-chart-header">
                    <div class="gac-chart-icon" style="background:#fdf4ff; color:#a855f7;">
                        <i class="fa-solid fa-chart-bar"></i>
                    </div>
                    <div>
                        <p class="gac-chart-title">Distribución por rol</p>
                        <p class="gac-chart-sub">Residentes agrupados por rol</p>
                    </div>
                </div>
                <div class="gac-bar-wrap">
                    <canvas id="chartRoles"></canvas>
                </div>
            </div>

            <!-- Gráfico 3: Progreso visual — resumen -->
            <div class="gac-card gac-chart-card">
                <div class="gac-chart-header">
                    <div class="gac-chart-icon" style="background:#f0fdf4; color:#22c55e;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <p class="gac-chart-title">Resumen general</p>
                        <p class="gac-chart-sub">Indicadores clave</p>
                    </div>
                </div>
                <div class="gac-progress-list">

                    <div class="gac-progress-item">
                        <div class="gac-progress-top">
                            <span>Con unidad</span>
                            <span class="gac-progress-pct" id="pctConUnidad">
                                @(totalResidentes > 0 ? (int)Math.Round(conUnidad * 100.0 / totalResidentes) : 0)%
                            </span>
                        </div>
                        <div class="gac-progress-track">
                            <div class="gac-progress-fill" style="background:#258cfb; width:@(totalResidentes > 0 ? conUnidad * 100 / totalResidentes : 0)%;"></div>
                        </div>
                    </div>

                    <div class="gac-progress-item">
                        <div class="gac-progress-top">
                            <span>Sin unidad</span>
                            <span class="gac-progress-pct">
                                @(totalResidentes > 0 ? (int)Math.Round(sinUnidad * 100.0 / totalResidentes) : 0)%
                            </span>
                        </div>
                        <div class="gac-progress-track">
                            <div class="gac-progress-fill" style="background:#f97316; width:@(totalResidentes > 0 ? sinUnidad * 100 / totalResidentes : 0)%;"></div>
                        </div>
                    </div>

                    @foreach (var rg in roleGroups)
                    {
                        var pct = totalResidentes > 0 ? (int)Math.Round(rg.Count * 100.0 / totalResidentes) : 0;
                        <div class="gac-progress-item">
                            <div class="gac-progress-top">
                                <span>@rg.Nombre</span>
                                <span class="gac-progress-pct">@pct%</span>
                            </div>
                            <div class="gac-progress-track">
                                <div class="gac-progress-fill" style="background:#a855f7; width:@pct%;"></div>
                            </div>
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

</div>

<!-- ══════════════ OFFCANVAS ══════════════ -->
<div class="offcanvas offcanvas-end gac-offcanvas"
     tabindex="-1"
     id="residentModal">

   

    <div class="gac-oc-header">
        <div class="gac-oc-header-icon">
            <i class="fa-solid fa-user-plus"></i>
        </div>
        <div>
            <h2 class="gac-oc-title">Nuevo Residente</h2>
            <p class="gac-oc-sub">Completa la información del residente</p>
        </div>
        <button type="button"
                class="btn-close ms-auto shadow-none"
                data-bs-dismiss="offcanvas">
        </button>
    </div>

    <div class="gac-oc-body">

        <button type="button"
                class="btn btn-outline-primary mb-3"
                id="btnCargarSolicitud">
            <i class="fa-solid fa-file-import"></i>
            Cargar desde solicitud
        </button>
        <form asp-action="Create"
              asp-controller="Usuarios"
              method="post">
            <input type="hidden" id="IdSolicitud" name="IdSolicitud" />

            @Html.AntiForgeryToken()
            <input type="hidden" name="FromIndex" value="true" />

            @await Html.PartialAsync("~/Views/Shared/_UsuarioForm.cshtml", new PROTOTIPO.Models.Usuario())

            <div class="gac-oc-footer">
                <button type="button"
                        class="gac-btn-cancel"
                        data-bs-dismiss="offcanvas">
                    Cancelar
                </button>
                <button type="submit" class="gac-btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar
                </button>
            </div>

        </form>
    </div>

</div>

<!-- OFFCANVAS Nuevo Residente -->
<div class="offcanvas offcanvas-end gac-offcanvas">
    ...
</div>


<!-- MODAL Solicitudes -->
<div class="modal fade" id="solicitudesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1">
                        Seleccionar solicitud aprobada
                    </h5>
                    <small class="text-muted">
                        Seleccione un solicitante para cargar sus datos
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>


            <div class="modal-body p-0">

                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Solicitante</th>
                                <th>Contacto</th>
                                <th>Unidad</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>

                        <tbody id="listaSolicitudes">

                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Cargando solicitudes...
                                </td>
                            </tr>

                        </tbody>

                    </table>
                </div>

            </div>

        </div>
    </div>
</div>


<!-- Scripts -->
<script>
    document.addEventListener("DOMContentLoaded", function() {

        const btn = document.getElementById("btnCargarSolicitud");
        const modalElement = document.getElementById("solicitudesModal");
        const lista = document.getElementById("listaSolicitudes");

        const modal = new bootstrap.Modal(modalElement);

        const tipoCliente = document.getElementById("tipoClienteUsuario");
        const campoCedula = document.getElementById("campoCedula");
        const campoPasaporte = document.getElementById("campoPasaporte");
        const campoRnc = document.getElementById("campoRnc");
        const campoNacionalidad = document.getElementById("campoNacionalidad");
        const campoNombreEmpresa = document.getElementById("campoNombreEmpresa");
        const campoPersonaAlojada = document.getElementById("campoPersonaAlojada");


        // ============================================================
        // MOSTRAR / OCULTAR CAMPOS SEGÚN TIPO DE CLIENTE
        // ============================================================

        function actualizarTipoCliente(tipo) {

            if (tipoCliente)
                tipoCliente.value = tipo ?? "";

            // Ocultar todos
            if (campoCedula)
                campoCedula.style.display = "none";

            if (campoPasaporte)
                campoPasaporte.style.display = "none";

            if (campoRnc)
                campoRnc.style.display = "none";

            if (campoNacionalidad)
                campoNacionalidad.style.display = "none";

            if (campoNombreEmpresa)
                campoNombreEmpresa.style.display = "none";

            if (campoPersonaAlojada)
                campoPersonaAlojada.style.display = "none";


            // DOMINICANO
            if (tipo === "Dominicano") {

                if (campoCedula)
                    campoCedula.style.display = "block";
            }


            // EXTRANJERO
            else if (tipo === "Extranjero") {

                if (campoPasaporte)
                    campoPasaporte.style.display = "block";

                if (campoNacionalidad)
                    campoNacionalidad.style.display = "block";
            }


            // JURÍDICO
            else if (tipo === "Juridico") {

                if (campoRnc)
                    campoRnc.style.display = "block";

                if (campoNombreEmpresa)
                    campoNombreEmpresa.style.display = "block";

                if (campoPersonaAlojada)
                    campoPersonaAlojada.style.display = "block";
            }
        }


        // ============================================================
        // CAMBIO MANUAL DEL TIPO DE CLIENTE
        // ============================================================

        if (tipoCliente) {

            tipoCliente.addEventListener("change", function() {

                actualizarTipoCliente(this.value);

                // Limpiar documentos anteriores
                const cedula = document.querySelector("#Cedula");
                const pasaporte = document.querySelector("#Pasaporte");
                const rnc = document.querySelector("#RNC");
                const nacionalidad = document.querySelector("#Nacionalidad");
                const personaAlojada = document.querySelector("#PersonaAlojada");

                if (cedula)
                    cedula.value = "";

                if (pasaporte)
                    pasaporte.value = "";

                if (rnc)
                    rnc.value = "";

                if (nacionalidad)
                    nacionalidad.value = "";
            });
        }


        // ============================================================
        // CARGAR SOLICITUD
        // ============================================================

        if (btn) {

            btn.addEventListener("click", async function() {

                modal.show();

                lista.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Cargando solicitudes...
                            </td>
                        </tr>
                    `;


                try {

                    const response = await fetch(
                        "/Usuarios/ObtenerSolicitudesPendientes"
                    );

                    if (!response.ok)
                        throw new Error("Error al obtener solicitudes.");

                    const solicitudes = await response.json();


                    // ====================================================
                    // NO HAY SOLICITUDES
                    // ====================================================

                    if (solicitudes.length === 0) {

                        lista.innerHTML = `
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        <div class="text-muted">
                                            No hay solicitudes aprobadas disponibles.
                                        </div>
                                    </td>
                                </tr>
                            `;

                        return;
                    }


                    lista.innerHTML = "";


                    // ====================================================
                    // MOSTRAR SOLICITUDES
                    // ====================================================

                    solicitudes.forEach(s => {

                        lista.innerHTML += `
                                <tr class="solicitud-item"
                                    data-id="${s.id}"
                                    style="cursor:pointer">

                                    <td>
                                        <div class="fw-semibold">
                                            ${s.nombre ?? ""} ${s.apellido ?? ""}
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            ${s.contacto ?? ""}
                                        </div>

                                        <small class="text-muted">
                                            <i class="fa-solid fa-phone"></i>
                                            ${s.telefono ?? ""}
                                        </small>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">
                                            Unidad ${s.unidad}
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary">

                                            <i class="fa-solid fa-check"></i>
                                            Seleccionar

                                        </button>

                                    </td>

                                </tr>
                            `;
                    });


                    // ====================================================
                    // SELECCIONAR SOLICITUD
                    // ====================================================

                    document.querySelectorAll(".solicitud-item")
                        .forEach(row => {

                            row.addEventListener("click", async function() {

                                const id = this.dataset.id;


                                // Guardar ID de solicitud
                                const idSolicitud =
                                    document.querySelector("#IdSolicitud");

                                if (idSolicitud)
                                    idSolicitud.value = id;


                                // Obtener información completa
                                const response = await fetch(
                                    `/Usuarios/ObtenerSolicitud?id=${id}`
                                );

                                if (!response.ok)
                                    throw new Error(
                                        "No se pudo obtener la solicitud."
                                    );

                                const data = await response.json();


                                // =================================================
                                // DATOS GENERALES
                                // =================================================

                                const nombre =
                                    document.querySelector("#Nombre");

                                const apellido =
                                    document.querySelector("#Apellido");

                                const email =
                                    document.querySelector("#Email");

                                const telefono =
                                    document.querySelector("#Telefono");


                                if (nombre)
                                    nombre.value = data.nombre ?? "";

                                if (apellido)
                                    apellido.value = data.apellido ?? "";

                                if (email)
                                    email.value = data.email ?? "";

                                if (telefono)
                                    telefono.value = data.telefono ?? "";


                                const nombreEmpresa =
                                    document.querySelector("#NombreEmpresa");

                                const personaAlojada =
                                    document.querySelector("#PersonaAlojada");

                                if (nombreEmpresa)
                                    nombreEmpresa.value = data.nombreEmpresa ?? "";

                                if (personaAlojada)
                                    personaAlojada.value = data.personaAlojada ?? "";

                                // =================================================
                                // CAMPOS DE DOCUMENTOS
                                // =================================================

                                const cedula =
                                    document.querySelector("#Cedula");

                                const pasaporte =
                                    document.querySelector("#Pasaporte");

                                const rnc =
                                    document.querySelector("#RNC");

                                const nacionalidad =
                                    document.querySelector("#Nacionalidad");


                                // Limpiar primero
                                if (cedula)
                                    cedula.value = "";

                                if (pasaporte)
                                    pasaporte.value = "";

                                if (rnc)
                                    rnc.value = "";

                                if (nacionalidad)
                                    nacionalidad.value = "";


                                // =================================================
                                // TIPO DE CLIENTE
                                // =================================================

                                actualizarTipoCliente(data.tipoCliente);


                                // =================================================
                                // CARGAR DOCUMENTO CORRESPONDIENTE
                                // =================================================

                                if (data.tipoCliente === "Dominicano") {

                                    if (cedula)
                                        cedula.value = data.cedula ?? "";
                                }

                                else if (data.tipoCliente === "Extranjero") {

                                    if (pasaporte)
                                        pasaporte.value =
                                            data.pasaporte ?? "";

                                    if (nacionalidad)
                                        nacionalidad.value =
                                            data.nacionalidad ?? "";
                                }

                                else if (data.tipoCliente === "Juridico") {

                                    if (rnc)
                                        rnc.value = data.rnc ?? "";
                                }


                                // =================================================
                                // CERRAR MODAL
                                // =================================================

                                modal.hide();

                            });

                        });

                }
                catch (error) {

                    console.error(
                        "Error cargando solicitudes:",
                        error
                    );

                    lista.innerHTML = `
                            <tr>
                                <td colspan="4"
                                    class="text-center text-danger py-4">

                                    No se pudieron cargar las solicitudes.

                                </td>
                            </tr>
                        `;
                }

            });
        }


        // ============================================================
        // ESTADO INICIAL
        // ============================================================

        if (tipoCliente)
            actualizarTipoCliente(tipoCliente.value);

    });
</script>
<!-- MODAL DE CONFIRMACIÓN PARA ELIMINAR -->
<div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444;"></i>
                    Confirmar eliminación
