@model PROTOTIPO.Models.CuotaMantenimiento

@{
    ViewData["Title"] = "Eliminar Cuota";

    var esPagado = Model.Estado == "Pagado";
    var montoFmt = Model.Monto?.ToString("N2") ?? "0.00";
}


<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --warn: #d97706;
        --warn-soft: #fffbeb;
        --warn-bdr: #fde68a;
        --success: #15803d;
        --success-soft: #f0fdf6;
        --success-bdr: #bbf7d0;
        --danger: #b91c1c;
        --danger-mid: #dc2626;
        --danger-soft: #fff1f0;
        --danger-bdr: #fecaca;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 26px;
        --r-pill: 999px;
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07);
        --ease: .22s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    .cdel-page {
        max-width: 560px;
        margin: 40px auto;
        padding: 0 24px 64px;
    }

    /* ── Breadcrumb ── */
    .cdel-bc {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
        font-weight: 500;
        color: var(--ink-muted);
        margin-bottom: 26px;
    }

        .cdel-bc a {
            color: var(--ink-muted);
            text-decoration: none;
            transition: color var(--ease);
        }

            .cdel-bc a:hover {
                color: var(--accent);
            }

    /* ── Warning banner ── */
    .cdel-warning {
        background: var(--danger-soft);
        border: 1px solid var(--danger-bdr);
        border-radius: var(--r-xl);
        padding: 16px 20px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 22px;
    }

    .cdel-warning-ico {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #fee2e2;
        color: var(--danger);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .cdel-warning-title {
        font-family: var(--font-d);
        font-size: .9rem;
        font-weight: 700;
        color: var(--danger);
        margin-bottom: 2px;
    }

    .cdel-warning-sub {
        font-size: .78rem;
        color: #b91c1c;
        opacity: .75;
        line-height: 1.5;
    }

    /* ── Card ── */
    .cdel-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    /* ── Card header ── */
    .cdel-header {
        background: var(--ink);
        padding: 24px 28px;
        position: relative;
        overflow: hidden;
    }

        .cdel-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .cdel-header::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(220,38,38,.2) 0%, transparent 68%);
            top: -70px;
            right: -40px;
            pointer-events: none;
        }

    .cdel-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .cdel-header-ico {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: rgba(185,28,28,.3);
        border: 1px solid rgba(252,165,165,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fca5a5;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .cdel-header-title {
        font-family: var(--font-d);
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: -.03em;
        color: #fff;
        margin: 0 0 3px;
    }

    .cdel-header-sub {
        font-size: .75rem;
        color: rgba(255,255,255,.45);
        margin: 0;
    }

    /* ── Info rows ── */
    .cdel-info {
        padding: 6px 0;
    }

    .cdel-row {
        display: flex;
        align-items: center;
        padding: 14px 28px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
        transition: background var(--ease);
    }

        .cdel-row:last-child {
            border-bottom: none;
        }

        .cdel-row:hover {
            background: #fafbfc;
        }

    .cdel-row-ico {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .82rem;
        flex-shrink: 0;
    }

    .cdel-row-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 2px;
    }

    .cdel-row-value {
        font-size: .9rem;
        font-weight: 700;
        color: var(--ink);
        font-family: var(--font-d);
        letter-spacing: -.01em;
    }

        .cdel-row-value.mono {
            font-family: var(--font-b);
            font-weight: 600;
            letter-spacing: 0;
        }

    /* Estado badge inline */
    .cdel-estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .73rem;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: var(--r-pill);
        letter-spacing: .03em;
        text-transform: capitalize;
    }

    .ceb--pendiente {
        background: var(--warn-soft);
        color: var(--warn);
        border: 1px solid var(--warn-bdr);
    }

    .ceb--pagado {
        background: var(--success-soft);
        color: var(--success);
        border: 1px solid var(--success-bdr);
    }

    /* ── Footer ── */
    .cdel-footer {
        background: var(--danger-soft);
        border-top: 1px solid var(--danger-bdr);
        padding: 18px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .cdel-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        color: var(--danger);
        opacity: .8;
        font-weight: 500;
    }

    .btn-cdel-cancel {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: var(--r-lg);
        border: 1.5px solid var(--border);
        background: var(--surface-2);
        color: var(--ink-soft);
        text-decoration: none;
        transition: var(--ease);
    }

        .btn-cdel-cancel:hover {
            background: #fff;
            border-color: #c8d2de;
            color: var(--ink);
        }

    .btn-cdel-confirm {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 700;
        padding: 10px 22px;
        border-radius: var(--r-lg);
        border: none;
        background: var(--danger-mid);
        color: #fff;
        cursor: pointer;
        transition: var(--ease);
        box-shadow: 0 4px 14px rgba(185,28,28,.3);
    }

        .btn-cdel-confirm:hover {
            background: var(--danger);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(185,28,28,.4);
        }

        .btn-cdel-confirm:active {
            transform: translateY(0);
        }

        .btn-cdel-confirm .cdel-spin {
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: cdel-rot .7s linear infinite;
        }

        .btn-cdel-confirm.loading .cdel-lbl,
        .btn-cdel-confirm.loading .cdel-ico {
            display: none;
        }

        .btn-cdel-confirm.loading .cdel-spin {
            display: block;
        }

    @@keyframes cdel-rot {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 575px) {
        .cdel-page {
            padding: 0 16px 48px;
        }

        .cdel-header {
            padding: 20px;
        }

        .cdel-row {
            padding: 13px 20px;
        }

        .cdel-footer {
            padding: 16px 20px;
            flex-direction: column;
            align-items: stretch;
        }

        .btn-cdel-cancel, .btn-cdel-confirm {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="cdel-page">

    <!-- Breadcrumb -->
    <div class="cdel-bc">
        <a asp-action="Index"><i class="bi bi-receipt"></i> Cuotas</a>
        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
        <span>Eliminar cuota</span>
    </div>

    <!-- Warning -->
    <div class="cdel-warning">
        <div class="cdel-warning-ico"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div>
            <div class="cdel-warning-title">Acción irreversible</div>
            <div class="cdel-warning-sub">
                Esta cuota será eliminada permanentemente del sistema. Esta acción no se puede deshacer.
            </div>
        </div>
    </div>

    <!-- Card -->
    <div class="cdel-card">

        <!-- Header -->
        <div class="cdel-header">
            <div class="cdel-header-inner">
                <div class="cdel-header-ico"><i class="bi bi-receipt-cutoff"></i></div>
                <div>
                    <div class="cdel-header-title">Cuota — Unidad @(Model.IdUnidadNavigation?.Numero ?? "—")</div>
                    <div class="cdel-header-sub">Período @Model.Periodo · RD$ @montoFmt</div>
                </div>
            </div>
        </div>

        <!-- Info rows -->
        <div class="cdel-info">

            <div class="cdel-row">
                <div class="cdel-row-ico"><i class="bi bi-buildings"></i></div>
                <div>
                    <div class="cdel-row-label">Unidad</div>
                    <div class="cdel-row-value">@(Model.IdUnidadNavigation?.Numero ?? "—")</div>
                </div>
            </div>

            <div class="cdel-row">
                <div class="cdel-row-ico"><i class="bi bi-calendar3"></i></div>
                <div>
                    <div class="cdel-row-label">Período</div>
                    <div class="cdel-row-value mono">@Model.Periodo</div>
                </div>
            </div>

            <div class="cdel-row">
                <div class="cdel-row-ico"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <div class="cdel-row-label">Monto</div>
                    <div class="cdel-row-value">RD$ @montoFmt</div>
                </div>
            </div>

            <div class="cdel-row">
                <div class="cdel-row-ico"><i class="bi bi-toggle-on"></i></div>
                <div>
                    <div class="cdel-row-label">Estado</div>
                    <div class="cdel-row-value">
                        <span class="cdel-estado-badge @(esPagado ? "ceb--pagado" : "ceb--pendiente")">
                            <i class="bi @(esPagado ? "bi-check-circle-fill" : "bi-hourglass-split")"></i>
                            @Model.Estado
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="cdel-footer">
            <div class="cdel-footer-note">
                <i class="bi bi-trash3-fill"></i>
                Esta operación no se puede revertir
            </div>
            <div style="display:flex;gap:10px;align-items:center;">
                <a asp-action="Index" class="btn-cdel-cancel">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <form asp-action="Delete" style="margin:0;" id="cDelForm">
                    <input type="hidden" asp-for="IdCuota" />
                    <button type="submit" class="btn-cdel-confirm" id="btnCDel">
                        <i class="cdel-ico bi bi-trash3-fill"></i>
                        <span class="cdel-lbl">Sí, eliminar</span>
                        <div class="cdel-spin"></div>
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById('cDelForm')?.addEventListener('submit', function () {
        var btn = document.getElementById('btnCDel');
        setTimeout(function () { btn.classList.add('loading'); btn.disabled = true; }, 0);
    });
</script>
