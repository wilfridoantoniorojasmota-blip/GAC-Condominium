@model PROTOTIPO.Models.Aviso

@{
    ViewData["Title"] = "Eliminar Aviso";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card border-danger shadow">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Eliminar Aviso</h4>
                </div>

                <div class="card-body p-4">

                    <h5 class="fw-bold">@Model.Titulo</h5>

                    <p class="text-muted">@Model.Contenido</p>

                    <p>
                        <strong>Fecha:</strong>
                        @Model.FechaPublicacion?.ToString("dd/MM/yyyy")
                    </p>

                    <p class="text-danger fw-semibold">
                        ¿Seguro que deseas eliminar este aviso?
                    </p>

                </div>

                <div class="card-footer d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="IdAviso" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>

                </div>

            </div>

        </div>
    </div>

</div>