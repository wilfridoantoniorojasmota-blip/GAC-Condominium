@model IEnumerable<PROTOTIPO.Models.Aviso>

@{
    ViewData["Title"] = "Avisos del Condominio";
}

<!-- HEADER -->
<div class="row mb-4 align-items-center">

    <div class="col-md-6">
        <h2 class="fw-bold mb-1">Avisos del Condominio</h2>
        <p class="text-muted mb-0">Información y anuncios importantes</p>
    </div>

    <div class="col-md-6 text-md-end mt-3 mt-md-0">

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
                   class="btn btn-primary px-4 shadow-sm">
                + Nuevo Aviso
            </a>
        }

    </div>

</div>

    <!-- LISTADO -->
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body d-flex flex-column">

                        <!-- TITULO -->
                        <h5 class="fw-bold mb-2">
                            @item.Titulo
                        </h5>

                        <!-- CONTENIDO -->
                        <p class="text-muted flex-grow-1">
                            @(item.Contenido?.Length > 120
                                ? item.Contenido.Substring(0, 120) + "..."
                                : item.Contenido)
                        </p>

                        <!-- FECHA -->
                        <div class="mt-2">
                            <small class="text-muted">
                                @item.FechaPublicacion?.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <!-- BOTONES -->
                        <div class="mt-3 d-flex gap-2">

                            <a asp-action="Details"
                                   asp-route-id="@item.IdAviso"
                                   class="btn btn-outline-primary w-100">
                                Ver
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit"
                                       asp-route-id="@item.IdAviso"
                                       class="btn btn-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.IdAviso"
                                       class="btn btn-danger">
                                    Eliminar
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>