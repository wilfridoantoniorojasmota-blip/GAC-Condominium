@model PROTOTIPO.Models.Condominio

@{
    ViewData["Title"] = "Detalles del Condominio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f5f7fa;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-2: #0fd4b0;
        --accent-soft: #eff6ff;
        --amber-acc: #f59e0b;
        --ok-bg: #f0fdf6;
        --ok-ink: #15803d;
        --ok-bdr: #bbf7d0;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-sm: 0 1px 3px rgba(12,18,32,.06), 0 1px 2px rgba(12,18,32,.04);
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --tr: .2s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    .det-shell {
        max-width:1060px;
        margin: 0 auto;
        padding: 44px 24px 80px;
    }

    /* ── Back ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 26px;
        transition: color var(--tr);
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* ── Main card ── */
    .det-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ── Dark header ── */
    .det-head {
        position: relative;
        padding: 36px 40px 30px;
        background: var(--ink);
        overflow: hidden;
    }

        .det-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .det-head::after {
            content: '';
            position: absolute;
            width: 340px;
            height: 340px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.16) 0%, transparent 70%);
            right: -60px;
            top: -80px;
            pointer-events: none;
        }

    .det-head-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    }

    .det-avatar {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: #fff;
        flex-shrink: 0;
    }

    .det-head-name {
        font-family: var(--font-d);
        font-size: clamp(1.25rem, 3vw, 1.7rem);
        font-weight: 800;
        color: #fff;
        letter-spacing: -.03em;
        margin: 0 0 6px;
    }

    .det-head-address {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .85rem;
        color: rgba(255,255,255,.55);
        margin-bottom: 14px;
    }

        .det-head-address i {
            color: rgba(255,255,255,.4);
            font-size: .9rem;
        }

    /* Quick meta pills */
    .head-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .head-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: var(--r-pill);
        padding: 5px 12px;
        font-size: .75rem;
        font-weight: 600;
        color: rgba(255,255,255,.75);
    }

        .head-pill i {
            font-size: .8rem;
            color: rgba(255,255,255,.5);
        }

    /* ── Body ── */
    .det-body {
        padding: 36px 40px 40px;
    }

    /* ── Section heading ── */
    .sec-hd {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-muted);
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 20px;
    }

        .sec-hd i {
            font-size: .8rem;
            color: var(--accent);
        }

    /* ── Info grid (field cells) ── */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        overflow: hidden;
        margin-bottom: 32px;
    }
    @@media (max-width: 540px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }

    .info-cell {
        padding: 16px 20px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        transition: background var(--tr);
    }

        .info-cell:hover {
            background: #fafbfd;
        }

        .info-cell.full {
            grid-column: 1 / -1;
            border-right: none;
        }

        .info-cell:nth-child(2n) {
            border-right: none;
        }

        .info-cell:nth-last-child(-n+2) {
            border-bottom: none;
        }

        .info-cell.full:last-child {
            border-bottom: none;
        }
    @@media (max-width: 540px) {
        .info-cell {
            border-right: none;
        }

            .info-cell:nth-last-child(-n+2) {
                border-bottom: 1px solid var(--border);
            }

            .info-cell:last-child {
                border-bottom: none;
            }
    }

    .info-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .info-label i {
            font-size: .75rem;
            color: var(--accent);
        }

    .info-value {
        font-size: .9rem;
        font-weight: 600;
        color: var(--ink);
        word-break: break-word;
    }

        .info-value.muted {
            color: var(--ink-muted);
            font-weight: 400;
            font-style: italic;
            font-size: .84rem;
        }

    /* External link style */
    .info-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .875rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        transition: var(--tr);
    }

        .info-link:hover {
            color: #1647cc;
            text-decoration: underline;
        }

        .info-link i {
            font-size: .78rem;
        }

    /* Social row */
    .social-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        border-radius: var(--r-pill);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        transition: var(--tr);
    }

        .social-btn i {
            font-size: .95rem;
        }

        .social-btn.ig:hover {
            background: #fce7f3;
            border-color: #f9a8d4;
            color: #be185d;
        }

        .social-btn.fb:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }

        .social-btn.web:hover {
            background: var(--accent-soft);
            border-color: #bfdbfe;
            color: var(--accent);
        }

    /* Sector chip */
    .sector-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--accent-soft);
        border: 1px solid #bfdbfe;
        border-radius: var(--r-pill);
        padding: 5px 14px;
        font-size: .8rem;
        font-weight: 700;
        color: var(--accent);
    }

    /* Size badge */
    .size-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--ok-bg);
        border: 1px solid var(--ok-bdr);
        border-radius: var(--r-pill);
        padding: 5px 14px;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ok-ink);
    }

    /* ── Divider ── */
    .det-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 28px;
    }

    /* ── Footer actions ── */
    .det-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--font-b);
        font-weight: 600;
        font-size: .875rem;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-back:hover {
            background: var(--surface-2);
            border-color: #c8d0dc;
            color: var(--ink);
        }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 22px;
        border-radius: var(--r-lg);
        border: none;
        background: linear-gradient(135deg, var(--accent) 0%, #1647cc 100%);
        color: #fff;
        font-family: var(--font-b);
        font-weight: 700;
        font-size: .875rem;
        text-decoration: none;
        transition: var(--tr);
        box-shadow: 0 3px 12px rgba(26,86,232,.28);
    }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(26,86,232,.38);
            color: #fff;
        }

  @@media (max-width: 600px) {
        .det-head {
            padding: 24px 20px 20px;
        }

        .det-body {
            padding: 24px 20px 28px;
        }

        .det-footer {
            flex-direction: column-reverse;
        }

        .btn-back, .btn-edit {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="det-shell">

    <!-- Back -->
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i>
        Volver a condominios
    </a>

    <div class="det-card">

        <!-- ── HEADER ── -->
        <div class="det-head">
            <div class="det-head-inner">
                <div class="det-avatar">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <div style="flex:1; min-width:0;">
                    <h1 class="det-head-name">@Model.Nombre</h1>
                    @if (!string.IsNullOrEmpty(Model.Direccion))
                    {
                        <div class="det-head-address">
                            <i class="bi bi-geo-alt-fill"></i>
                            @Model.Direccion
                        </div>
                    }
                    <div class="head-meta">
                        @if (!string.IsNullOrEmpty(Model.Tamano))
                        {
                            <span class="head-pill">
                                <i class="bi bi-aspect-ratio"></i>
                                @Model.Tamano
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Rnc))
                        {
                            <span class="head-pill">
                                <i class="bi bi-card-text"></i>
                                RNC: @Model.Rnc
                            </span>
                        }
                        @if (Model.IdSectorNavigation != null)
                        {
                            <span class="head-pill">
                                <i class="bi bi-map"></i>
                                 #@Model.IdSectorNavigation.Nombre
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── BODY ── -->
        <div class="det-body">

            <!-- Contact info -->
            <div class="sec-hd">
                <i class="bi bi-person-lines-fill"></i>
                Información de contacto
            </div>

            <div class="info-grid" style="margin-bottom:32px;">

                <div class="info-cell">
                    <div class="info-label"><i class="bi bi-telephone"></i>Teléfono</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Telefono))
                        {
                            <a href="tel:@Model.Telefono" class="info-link">
                                @Model.Telefono
                            </a>
                        }
                        else
                        {

                            <span class="muted">No registrado</span>
                        }
                    </div>
                </div>

                <div class="info-cell">
                    <div class="info-label"><i class="bi bi-envelope"></i>Correo electrónico</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <a href="mailto:@Model.Email" class="info-link">
                                @Model.Email
                            </a>
                        }
                        else
                        {

                            <span class="muted">No registrado</span>
                        }
                    </div>
                </div>

                <div class="info-cell full">
                    <div class="info-label"><i class="bi bi-globe"></i>Página web</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.PaginaWeb))
                        {
                            <a href="@Model.PaginaWeb" target="_blank" rel="noopener noreferrer" class="info-link">
                                @Model.PaginaWeb
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        }
                        else
                        {

                            <span class="muted">No registrada</span>
                        }
                    </div>
                </div>

            </div>

            <!-- Legal & size -->
            <div class="sec-hd">
                <i class="bi bi-file-earmark-text-fill"></i>
                Datos legales y dimensión
            </div>

            <div class="info-grid" style="margin-bottom:32px;">

                <div class="info-cell">
                    <div class="info-label"><i class="bi bi-card-text"></i>RNC</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Rnc))
                        {
                            <span>@Model.Rnc</span>
                        }
                        else
                        {

                            <span class="muted">No registrado</span>
                        }
                    </div>
                </div>

                <div class="info-cell">
                    <div class="info-label"><i class="bi bi-aspect-ratio"></i>Tamaño</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Tamano))
                        {
                            <span class="size-badge">
                                <i class="bi bi-check-circle-fill"></i>
                                @Model.Tamano
                            </span>
                        }
                        else
                        {

                            <span class="muted">No especificado</span>
                        }
                    </div>
                </div>

                <div class="info-cell full">
                    <div class="info-label"><i class="bi bi-map"></i>Sector</div>
                    <div class="info-value">
                        @if (Model.IdSectorNavigation != null)
                        {
                            <span class="sector-chip">
                                <i class="bi bi-pin-map-fill"></i>
                                Provincia #@Model.IdSectorNavigation.Nombre
                            </span>
                        }
                        else
                        {

                            <span class="muted">Sin sector asignado</span>
                        }
                    </div>
                </div>

            </div>

            <!-- Social media -->
            <div class="sec-hd">
                <i class="bi bi-share-fill"></i>
                Redes sociales
            </div>

            <div style="margin-bottom:36px;">
                @{
                    bool hasSocial = !string.IsNullOrEmpty(Model.Instagram) || !string.IsNullOrEmpty(Model.Facebook) || !string.IsNullOrEmpty(Model.PaginaWeb);
                }
                @if (hasSocial)
                {
                    <div class="social-row">
                        @if (!string.IsNullOrEmpty(Model.Instagram))
                        {
                            <a href="@Model.Instagram" target="_blank" rel="noopener noreferrer" class="social-btn ig">
                                <i class="bi bi-instagram"></i>
                                Instagram
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Facebook))
                        {
                            <a href="@Model.Facebook" target="_blank" rel="noopener noreferrer" class="social-btn fb">
                                <i class="bi bi-facebook"></i>
                                Facebook
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.PaginaWeb))
                        {
                            <a href="@Model.PaginaWeb" target="_blank" rel="noopener noreferrer" class="social-btn web">
                                <i class="bi bi-globe"></i>
                                Sitio web
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);color:var(--ink-muted);font-size:.875rem;">
                        <i class="bi bi-share" style="font-size:1.1rem;opacity:.5;"></i>
                        Sin redes sociales registradas.
                    </div>
                }
            </div>

            <hr class="det-divider">

            <!-- Actions -->
            <div class="det-footer">
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.IdCondominio" class="btn-edit">
                    <i class="bi bi-pencil-fill"></i>
                    Editar condominio
                </a>
            </div>

        </div>
    </div>

</div>
