<section class="lp-section lp-section--surface" id="areas">
    <div class="lp-container">
        <div style="max-width:520px;">
            <span class="section-eyebrow"><i class="bi bi-tree-fill"></i> Instalaciones</span>
            <h2 class="section-title">Áreas Comunes</h2>
            <p class="section-sub">Espacios pensados para el bienestar de todos los residentes del complejo.</p>
        </div>
        <div class="row g-4" style="margin-top:8px;">
            @if (areas != null && areas.Any())
            {
                foreach (var a in areas)
                {
                    var imgUrl = a.ImagenAreas?.FirstOrDefault()?.Url
                                 ?? "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=800&q=80";
                    <div class="col-xl-4 col-md-6">
                        <div class="area-card">
                            <div class="area-img-wrap">
                                <img src="@imgUrl" alt="@a.Nombre" loading="lazy">
