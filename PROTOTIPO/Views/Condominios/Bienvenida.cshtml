@model PROTOTIPO.Models.ViewModel.CondominioLandingVM

@{
    ViewData["Title"] = "Bienvenida al Condominio";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    var condominio = Model.Condominio;
    var unidades = Model.Unidades;
    var areas = Model.Areas;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">




<style>
    /* ============================================================
       DESIGN TOKENS
       ============================================================ */
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --teal: #0fd4b0;
        --teal-light: #e6fdf9;
        --danger-soft: #fff1f0;
        --danger-text: #b91c1c;
        --danger-bdr: #fecaca;
        --success-soft: #f0fdf6;
        --success-text: #15803d;
        --success-bdr: #bbf7d0;
        --r-md: 12px;
        --r-lg: 16px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-xs: 0 1px 3px rgba(12,18,32,.06);
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07), 0 1px 3px rgba(12,18,32,.04);
        --shadow-md: 0 8px 24px rgba(12,18,32,.09), 0 2px 8px rgba(12,18,32,.05);
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --font-display: 'Sora', system-ui, sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
        --ease: .25s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--font-body);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    /* ============================================================
       GLOBAL SECTION WRAPPER
       ============================================================ */
    .lp-section {
        padding: 96px 0;
    }

    .lp-section--alt {
        background: var(--surface-2);
    }

    .lp-section--dark {
        background: var(--ink);
    }

    .lp-section--surface {
        background: var(--surface);
    }

    .lp-container {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 32px;
    }

    /* ============================================================
       SECTION EYEBROW / HEADER
       ============================================================ */
    .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-light);
        padding: 6px 14px;
        border-radius: var(--r-pill);
        margin-bottom: 16px;
    }

    .section-eyebrow--teal {
        color: #0aaa8c;
        background: var(--teal-light);
    }

    .section-title {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.15;
        color: var(--ink);
        margin-bottom: 12px;
    }

    .section-title--white {
        color: #fff;
    }

    .section-sub {
        font-size: .95rem;
        color: var(--ink-muted);
        line-height: 1.7;
        max-width: 540px;
    }

    .section-sub--white {
        color: rgba(255,255,255,.6);
    }

    /* ============================================================
       HERO
       ============================================================ */
    .hero {
        position: relative;
        height: 100vh;
        min-height: 640px;
        overflow: hidden;
    }

        /* Carousel fills full hero */
        .hero .carousel,
        .hero .carousel-inner,
        .hero .carousel-item {
            height: 100%;
        }

    .hero-slide-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(.38) saturate(1.2);
        transform: scale(1.06);
        transition: transform 8s ease;
    }

    .carousel-item.active .hero-slide-img {
        transform: scale(1.12);
    }

    /* Dark-to-transparent gradient — stronger on left */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 110deg, rgba(12,18,32,.65) 0%, rgba(12,18,32,.30) 50%, rgba(12,18,32,.05) 100% );
        z-index: 2;
        display: flex;
        align-items: center;
    }

    .hero-content {
        width: 100%;
        padding: 0 32px;
        max-width: 1320px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 48px;
    }

    /* Left: main headline */
    .hero-left {
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        background: rgba(26,86,232,.2);
        border: 1px solid rgba(26,86,232,.35);
        color: #93c5fd;
        padding: 6px 14px;
        border-radius: var(--r-pill);
        margin-bottom: 24px;
    }

    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.08;
        letter-spacing: -.04em;
        margin-bottom: 20px;
    }

        .hero-title .accent-text {
            background: linear-gradient(90deg, #38bdf8, var(--teal));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .hero-address {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .875rem;
        color: rgba(255,255,255,.55);
        margin-bottom: 16px;
        font-weight: 500;
    }

        .hero-address i {
            color: #f87171;
            font-size: 1rem;
        }

    .hero-desc {
        font-size: 1rem;
        color: rgba(255,255,255,.65);
        line-height: 1.7;
        max-width: 480px;
        margin-bottom: 36px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: var(--accent);
        color: #fff;
        font-weight: 700;
        font-size: .9rem;
        padding: 15px 30px;
        border-radius: var(--r-lg);
        border: none;
        text-decoration: none;
        transition: var(--ease);
        box-shadow: 0 6px 24px rgba(26,86,232,.4);
        letter-spacing: .01em;
    }

        .btn-hero-primary:hover {
            background: #1447d0;
            transform: translateY(-2px);
            box-shadow: 0 10px 32px rgba(26,86,232,.5);
            color: #fff;
        }

    .btn-hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        color: rgba(255,255,255,.85);
        font-weight: 600;
        font-size: .9rem;
        padding: 15px 26px;
        border-radius: var(--r-lg);
        text-decoration: none;
        transition: var(--ease);
        backdrop-filter: blur(8px);
    }

        .btn-hero-secondary:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    /* Right: glass card with quick stats */
    .hero-card {
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
        border: 1px solid rgba(255,255,255,.13);
        border-radius: var(--r-2xl);
        padding: 36px 32px;
        max-width: 400px;
        margin-left: auto;
    }

    .hero-card-title {
        font-family: var(--font-display);
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: rgba(255,255,255,.45);
        margin-bottom: 24px;
    }

    .hero-stat-row {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-bottom: 28px;
    }

    .hero-stat {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: var(--r-lg);
    }

    .hero-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .hsi--blue {
        background: rgba(26,86,232,.25);
        color: #93c5fd;
    }

    .hsi--green {
        background: rgba(21,128,61,.25);
        color: #86efac;
    }

    .hsi--red {
        background: rgba(185,28,28,.25);
        color: #fca5a5;
    }

    .hero-stat-label {
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: rgba(255,255,255,.45);
        margin-bottom: 2px;
    }

    .hero-stat-value {
        font-family: var(--font-display);
        font-size: 1.7rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
        letter-spacing: -.04em;
    }

    .hero-card-divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,.1);
        margin-bottom: 20px;
    }

    .hero-card-note {
        font-size: .78rem;
        color: rgba(255,255,255,.4);
        line-height: 1.6;
        text-align: center;
    }

    /* Carousel indicators */
    .carousel-indicators [data-bs-target] {
        width: 6px;
        height: 6px;
        border-radius: var(--r-pill);
        background: rgba(255,255,255,.30);
        border: none;
        transition: width var(--ease), background var(--ease);
    }

    .carousel-indicators .active {
        width: 24px;
        background: #fff;
    }

    /* Scroll cue */
    .hero-scroll-cue {
        position: absolute;
        bottom: 36px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,.35);
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .scroll-mouse {
        width: 22px;
        height: 34px;
        border: 2px solid rgba(255,255,255,.25);
        border-radius: var(--r-pill);
        display: flex;
        justify-content: center;
        padding-top: 6px;
    }

    .scroll-dot {
        width: 3px;
        height: 7px;
        background: rgba(255,255,255,.5);
        border-radius: var(--r-pill);
        animation: scrollBounce 1.8s ease-in-out infinite;
    }

    @@keyframes scrollBounce {
        0%, 100% {
            transform: translateY(0);
            opacity: 1;
        }

        60% {
            transform: translateY(8px);
            opacity: .3;
        }
    }

    /* ============================================================
       ABOUT SECTION
       ============================================================ */
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: center;
    }

    .about-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
    }

    .about-feat {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 14px 16px;
        font-size: .875rem;
        font-weight: 600;
        color: var(--ink-soft);
        transition: var(--ease);
    }

        .about-feat i {
            color: var(--accent);
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .about-feat:hover {
            border-color: rgba(26,86,232,.3);
            background: var(--accent-light);
            color: var(--accent);
        }

    .about-media {
        position: relative;
    }

    .about-img-wrap {
        border-radius: var(--r-2xl);
        overflow: hidden;
        height: 460px;
        box-shadow: var(--shadow-lg);
    }

        .about-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Floating badge */
    .about-float-badge {
        position: absolute;
        bottom: -20px;
        left: -20px;
        background: var(--surface-2);
        border-radius: var(--r-xl);
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border);
        min-width: 220px;
    }

    .about-float-icon {
        width: 46px;
        height: 46px;
        background: var(--accent-light);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .about-float-label {
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 2px;
    }

    .about-float-value {
        font-family: var(--font-display);
        font-size: .95rem;
        font-weight: 700;
        color: var(--ink);
    }

    /* Teal accent stripe on image */
    .about-img-wrap::after {
        content: '';
        position: absolute;
        top: 28px;
        right: -12px;
        width: 4px;
        height: 80px;
        background: linear-gradient(180deg, var(--accent), var(--teal));
        border-radius: var(--r-pill);
    }

    .about-media {
        position: relative;
    }

    /* ============================================================
       FEATURES / AMENIDADES
       ============================================================ */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 48px;
    }

    .feature-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 32px 28px;
        position: relative;
        overflow: hidden;
        transition: var(--ease);
    }

        .feature-card::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), var(--teal));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .35s var(--ease);
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
            border-color: rgba(26,86,232,.2);
        }

            .feature-card:hover::before {
                transform: scaleX(1);
            }

    .feature-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 20px;
        transition: var(--ease);
    }

    .feature-card:hover .feature-icon {
        background: var(--accent);
        color: #fff;
    }

    .feature-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 8px;
        letter-spacing: -.02em;
    }

    .feature-desc {
        font-size: .875rem;
        color: var(--ink-muted);
        line-height: 1.65;
    }

    /* ============================================================
       UNIT CARDS
       ============================================================ */
    .units-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 36px;
    }

    .filter-pills {
        display: flex;
        gap: 6px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-pill);
        padding: 4px;
    }

    .filter-pill {
        font-size: .8rem;
        font-weight: 600;
        padding: 7px 18px;
        border-radius: var(--r-pill);
        border: none;
        background: transparent;
        color: var(--ink-muted);
        cursor: pointer;
        transition: var(--ease);
    }

        .filter-pill.active,
        .filter-pill:hover {
            background: var(--ink);
            color: #fff;
        }

    .unit-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: var(--ease);
    }

        .unit-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

    .unit-img {
        position: relative;
        height: 196px;
        overflow: hidden;
    }

        .unit-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .55s ease;
        }

    .unit-card:hover .unit-img img {
        transform: scale(1.08);
    }

    .unit-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(12,18,32,.5) 0%, transparent 55%);
    }

    .unit-status-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: var(--r-pill);
    }

    .usb--green {
        background: var(--success-soft);
        color: var(--success-text);
        border: 1px solid var(--success-bdr);
    }

    .usb--red {
        background: var(--danger-soft);
        color: var(--danger-text);
        border: 1px solid var(--danger-bdr);
    }

    .unit-body {
        padding: 22px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .unit-number {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.025em;
        margin-bottom: 8px;
    }

    .unit-desc {
        font-size: .85rem;
        color: var(--ink-soft);
        line-height: 1.65;
        flex: 1;
    }

    /* ============================================================
       AREA CARDS
       ============================================================ */
    .area-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: var(--ease);
    }

        .area-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

    .area-img-wrap {
        position: relative;
        height: 210px;
        overflow: hidden;
    }

        .area-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .55s ease;
        }

    .area-card:hover .area-img-wrap img {
        transform: scale(1.07);
    }

    .area-img-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(12,18,32,.6);
        backdrop-filter: blur(8px);
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: var(--r-pill);
        border: 1px solid rgba(255,255,255,.15);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .area-body {
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .area-name {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.02em;
        margin-bottom: 8px;
    }

    .area-desc {
        font-size: .85rem;
        color: var(--ink-soft);
        line-height: 1.65;
        flex: 1;
        margin-bottom: 16px;
    }

    .area-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid var(--border);
    }

    .area-schedule {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .8rem;
        font-weight: 600;
        color: var(--accent);
    }

    .btn-area {
        font-size: .78rem;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: var(--r-md);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        cursor: pointer;
        transition: var(--ease);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-area:hover {
            background: var(--ink);
            color: #fff;
            border-color: var(--ink);
        }

    /* ============================================================
       LOCATION SECTION
       ============================================================ */
    .location-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 28px;
        margin-top: 48px;
    }

    .location-map {
        height: 440px;
        border-radius: var(--r-2xl);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border);
    }

    .location-cards {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .loc-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 20px 22px;
        display: flex;
        gap: 16px;
        align-items: flex-start;
        transition: var(--ease);
    }

        .loc-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-sm);
        }

    .loc-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .loc-card h3 {
        font-family: var(--font-display);
        font-size: .95rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .loc-card p {
        font-size: .85rem;
        color: var(--ink-soft);
        line-height: 1.55;
    }

    /* ============================================================
       CTA BANNER
       ============================================================ */
    .cta-banner {
        background: var(--ink);
        border-radius: var(--r-2xl);
        padding: 80px 48px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
        /* Subtle dot grid */
        .cta-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 24px 24px;
            pointer-events: none;
        }
        /* Teal glow */
        .cta-banner::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.15) 0%, transparent 68%);
            top: -120px;
            right: -80px;
            pointer-events: none;
        }

    .cta-inner {
        position: relative;
        z-index: 1;
    }

    .cta-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--teal);
        background: rgba(15,212,176,.12);
        border: 1px solid rgba(15,212,176,.25);
        padding: 6px 14px;
        border-radius: var(--r-pill);
        margin-bottom: 20px;
    }

    .cta-banner h2 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 3.5vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -.04em;
        color: #fff;
        margin-bottom: 14px;
    }

    .cta-banner p {
        font-size: .98rem;
        color: rgba(255,255,255,.58);
        line-height: 1.7;
        max-width: 500px;
        margin: 0 auto 36px;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        color: var(--ink);
        font-weight: 700;
        font-size: .95rem;
        padding: 16px 36px;
        border-radius: var(--r-lg);
        border: none;
        text-decoration: none;
        transition: var(--ease);
        box-shadow: 0 6px 24px rgba(0,0,0,.22);
    }

        .btn-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 36px rgba(0,0,0,.3);
            color: var(--accent);
        }

        .btn-cta i {
            color: var(--accent);
            font-size: 1.1rem;
            transition: transform var(--ease);
        }

        .btn-cta:hover i {
            transform: translateX(4px);
        }

    /* ============================================================
       FOOTER
       ============================================================ */
    .site-footer {
        background: var(--ink);
        color: rgba(255,255,255,.5);
        padding: 72px 0 0;
        font-size: .875rem;
    }

    .footer-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 14px;
    }

    .footer-logo-box {
        width: 38px;
        height: 38px;
        background: var(--accent);
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.1rem;
    }

    .footer-brand-name {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: -.02em;
    }

    .footer-tagline {
        font-size: .825rem;
        line-height: 1.7;
        max-width: 260px;
        color: rgba(255,255,255,.4);
        margin-bottom: 24px;
    }

    .footer-col-title {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .11em;
        color: rgba(255,255,255,.3);
        margin-bottom: 18px;
    }

    .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .footer-links a {
            color: rgba(255,255,255,.5);
            text-decoration: none;
            font-size: .875rem;
            transition: color var(--ease);
        }

            .footer-links a:hover {
                color: #fff;
            }

    .footer-social {
        display: flex;
        gap: 8px;
        margin-top: 20px;
    }

    .social-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.5);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        text-decoration: none;
        transition: var(--ease);
    }

        .social-btn:hover {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

    .footer-contact-item {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 12px;
    }

        .footer-contact-item i {
            margin-top: 3px;
            flex-shrink: 0;
            font-size: .95rem;
        }

        .footer-contact-item a {
            color: rgba(255,255,255,.5);
            text-decoration: none;
            transition: color var(--ease);
        }

            .footer-contact-item a:hover {
                color: #fff;
            }

        .footer-contact-item span {
            font-size: .875rem;
            line-height: 1.5;
        }

    .footer-bottom {
        border-top: 1px solid rgba(255,255,255,.07);
        margin-top: 56px;
        padding: 22px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

        .footer-bottom p {
            margin: 0;
            font-size: .8rem;
        }

    .footer-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.45);
        font-size: .75rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: var(--r-pill);
    }

        .footer-badge i {
            color: var(--teal);
        }

    /* ============================================================
       EMPTY STATES
       ============================================================ */
    .empty-state {
        background: var(--surface-2);
        border: 1.5px dashed var(--border);
        border-radius: var(--r-xl);
        padding: 64px 32px;
        text-align: center;
    }

        .empty-state i {
            font-size: 2.5rem;
            color: var(--ink-muted);
            opacity: .4;
            display: block;
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: .9rem;
            color: var(--ink-muted);
        }

    /* ============================================================
       UNIT FILTER — animation
       ============================================================ */
    .unit-item {
        transition: opacity .2s ease;
    }

        .unit-item.hidden {
            opacity: 0;
            pointer-events: none;
            display: none;
        }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @@media (max-width: 991px) {
        .hero-content {
            grid-template-columns: 1fr;
        }

        .hero-card {
            max-width: 100%;
            margin: 0;
            display: none;
        }
        /* hide card on mobile for simplicity */
        .about-grid {
            grid-template-columns: 1fr;
        }

        .about-float-badge {
            display: none;
        }

        .about-img-wrap {
            height: 320px;
        }

        .features-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .location-grid {
            grid-template-columns: 1fr;
        }

        .location-map {
            height: 320px;
        }
    }

    @@media (max-width: 767px) {
        .lp-section {
            padding: 64px 0;
        }

        .hero-title {
            font-size: 2.2rem;
        }

        .features-grid {
            grid-template-columns: 1fr;
        }

        .cta-banner {
            padding: 56px 28px;
        }
    }

    @@media (max-width: 575px) {
        .lp-container {
            padding: 0 20px;
        }

        .hero-content {
            padding: 0 20px;
        }
    }

    .unit-specs {
        display: flex;
        justify-content: space-between;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid rgba(0,0,0,0.06);
    }

    .unit-specs {
        display: flex;
        gap: 10px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(15, 23, 42, 0.08);
    }

        .unit-specs .spec {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 10px 6px;
            border-radius: 12px;
            background: linear-gradient(180deg, #ffffff, #f8fafc);
            border: 1px solid rgba(15, 23, 42, 0.06);
            transition: all 0.25s ease;
            cursor: default;
        }

            .unit-specs .spec:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
                border-color: rgba(59, 130, 246, 0.25);
            }

            .unit-specs .spec i {
                font-size: 15px;
                color: #3b82f6;
                margin-bottom: 4px;
            }

            .unit-specs .spec span {
                font-weight: 700;
                font-size: 15px;
                color: #0f172a;
                line-height: 1;
            }

            .unit-specs .spec small {
                font-size: 11px;
                color: #64748b;
                margin-top: 2px;
                letter-spacing: 0.3px;
            }
</style>

<!-- ============================================================
     HERO
============================================================ -->
<section class="hero" id="inicio">
    <!-- Carousel -->
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-inner" style="height:100%;">
            <div class="carousel-item active" style="height:100%;">
                <img class="hero-slide-img"
                     src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=80"
                     alt="Vista principal">
            </div>
            <div class="carousel-item" style="height:100%;">
                <img class="hero-slide-img"
                     src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1600&q=80"
                     alt="Interiores">
            </div>
            <div class="carousel-item" style="height:100%;">
                <img class="hero-slide-img"
                     src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=1600&q=80"
                     alt="Áreas exteriores">
            </div>
        </div>
        <div class="carousel-indicators mb-3">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        </div>
    </div>

    <!-- Overlay -->
    <div class="hero-overlay" style="z-index:2;">
        <div class="hero-content" style="z-index:3;">

            <!-- LEFT: Headline + CTA -->
            <div class="hero-left">
                <div class="hero-eyebrow">
                    <i class="bi bi-patch-check-fill"></i>
                    Residencia Verificada
                </div>
                <h1 class="hero-title">
                    Bienvenido a<br>
                    <span class="accent-text">@(condominio?.Nombre ?? "Condominio Residencial")</span>
                </h1>
                <div class="hero-address">
                    <i class="bi bi-geo-alt-fill"></i>
                    @(condominio?.Direccion ?? "Ubicación disponible al registrarse")
                </div>
                <p class="hero-desc">
                    Un espacio diseñado para quienes exigen calidad. Gestión inteligente, comunidad activa y vida sin compromisos.
                </p>
                <div class="hero-actions">
                    <button type="button" class="btn-cta" data-bs-toggle="modal" data-bs-target="#solicitudModal">
                        Solicitar ingreso
                    </button>
                    <a href="#unidades" class="btn-hero-secondary">
                        <i class="bi bi-buildings"></i>
                        Ver Unidades
                    </a>
                </div>
            </div>

            <!-- RIGHT: Quick stats card -->
            <div class="hero-card">
                <div class="hero-card-title">Resumen del complejo</div>
                <div class="hero-stat-row">
                    <div class="hero-stat">
                        <div class="hero-stat-icon hsi--blue"><i class="bi bi-buildings-fill"></i></div>
                        <div>
                            <div class="hero-stat-label">Total Unidades</div>
                            <div class="hero-stat-value">@Model.TotalUnidades</div>
                        </div>
                    </div>
                    <div class="hero-stat">
                        <div class="hero-stat-icon hsi--green"><i class="bi bi-check-circle-fill"></i></div>
                        <div>
                            <div class="hero-stat-label">Disponibles</div>
                            <div class="hero-stat-value">@Model.Disponibles</div>
                        </div>
                    </div>
                    <div class="hero-stat">
                        <div class="hero-stat-icon hsi--red"><i class="bi bi-house-fill"></i></div>
                        <div>
                            <div class="hero-stat-label">Ocupadas</div>
                            <div class="hero-stat-value">@Model.Ocupadas</div>
                        </div>
                    </div>
                </div>
                <hr class="hero-card-divider">
                <p class="hero-card-note">
                    <i class="bi bi-shield-check" style="color:var(--teal);margin-right:5px;"></i>
                    Información actualizada en tiempo real
                </p>
            </div>

        </div>
    </div>

    <!-- Scroll cue -->
    <div class="hero-scroll-cue" style="z-index:4;">
        <div class="scroll-mouse"><div class="scroll-dot"></div></div>
        Explorar
    </div>
</section>

