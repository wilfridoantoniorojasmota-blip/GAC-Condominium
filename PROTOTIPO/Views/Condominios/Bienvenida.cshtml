<script>
document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('formSolicitud');
    const btn = document.getElementById('btnSubmitSolicitud');
    if (!form) return;

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // mostrar loader
        if (btn) { btn.classList.add('loading'); btn.disabled = true; }

        try {
            const formData = new FormData(form);
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) throw new Error('Network error');
            const data = await res.json();

            if (data.success) {
                // Mostrar modal de éxito centrado con fondo blanco y check verde
                const modalHtml = `
                    <div class="modal fade" id="successSolicitudModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background:#ffffff;border-radius:16px;padding:28px;text-align:center;">
                          <div style="font-size:48px;color:#16a34a;margin-bottom:12px;">&#10003;</div>
                          <h5 style="margin:0 0 8px;font-weight:800;color:#0c1220;">Solicitud Enviada</h5>
                          <p style="margin:0;color:#475569;">Gracias. Hemos recibido tu solicitud y nos pondremos en contacto contigo.</p>
                        </div>
                      </div>
                    </div>`;

                // Añadir al DOM y mostrar
                let existingModal = document.getElementById('successSolicitudModal');
                if (existingModal) existingModal.remove();
                const wrapper = document.createElement('div');
                wrapper.innerHTML = modalHtml;
                document.body.appendChild(wrapper.firstElementChild);

                const modalEl = document.getElementById('successSolicitudModal');
                const bsModal = new bootstrap.Modal(modalEl);
                bsModal.show();

                // Cerrar y limpiar después de 2.5s
                setTimeout(() => {
                    try { bsModal.hide(); } catch (e) {}
                    const el = document.getElementById('successSolicitudModal');
                    if (el) el.remove();
                }, 2500);

                // cerrar modal original y resetear
                const originalModalEl = document.getElementById('solicitudModal');
                const originalModal = bootstrap.Modal.getInstance(originalModalEl) || new bootstrap.Modal(originalModalEl);
                originalModal.hide();
                form.reset();
            } else {
                showErrorModal(data.message || 'No dejar campos vacios');
            }
        } catch (err) {
            console.error(err);
            showErrorModal('Error al enviar la solicitud. Intente nuevamente.');
        } finally {
            if (btn) { btn.classList.remove('loading'); btn.disabled = false; }
        }
    });
});
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // 1. Delegación de eventos (funciona aunque la tabla cambie o sea dinámica)
        document.body.addEventListener("click", async function (e) {

            // Buscamos si el clic vino del botón o de un ícono dentro del botón
            const btn = e.target.closest(".btn-detalles-unidad");
            if (!btn) return;

            e.preventDefault();
            const id = btn.dataset.id;

            if (!id) {
                console.error("El botón no tiene el atributo data-id");
                return;
            }

            try {
                const response = await fetch(`/Condominios/DetallesUnidad?id=${id}`);

                if (!response.ok) {
                    throw new Error("Error en la respuesta del servidor");
                }

                const unidad = await response.json();
                console.log("Datos recibidos del servidor:", unidad); // 👈 Revisa tu consola (F12) con esto

                // 2. Soporte dual para camelCase (JS) y PascalCase (C# .NET)
                const getVal = (min, may) => unidad[min] ?? unidad[may];

                document.getElementById("modalNumero").textContent =
                    "Unidad " + (getVal("numero", "Numero") ?? "");

                document.getElementById("modalTipo").textContent = getVal("tipo", "Tipo") ?? "—";
                document.getElementById("modalEstado").textContent = getVal("estado", "Estado") ?? "—";
                document.getElementById("modalDescripcion").textContent = getVal("descripcion", "Descripcion") ?? "Sin descripción";

                document.getElementById("modalHabitaciones").textContent = getVal("cantidadHabitaciones", "CantidadHabitaciones") ?? 0;
                document.getElementById("modalBanos").textContent = getVal("cantidadBanos", "CantidadBanos") ?? 0;
                document.getElementById("modalMetros").textContent = (getVal("metrosCuadrados", "MetrosCuadrados") ?? 0) + " m²";

                document.getElementById("modalImagen").src = getVal("imagen", "Imagen") ?? "/img/placeholder-unidad.jpg";

                // Llenar características
                const caracteristicas = document.getElementById("modalCaracteristicas");
                caracteristicas.innerHTML = "";

                const lista = [
                    { valor: getVal("salaEstar", "SalaEstar"), texto: "Sala de estar" },
                    { valor: getVal("balcon", "Balcon"), texto: "Balcón" },
                    { valor: getVal("terraza", "Terraza"), texto: "Terraza" },
                    { valor: getVal("jacuzzi", "Jacuzzi"), texto: "Jacuzzi" },
                    { valor: getVal("picuzzi", "Picuzzi"), texto: "Picuzzi" }
                ];

                lista.forEach(c => {
                    if (c.valor) {
                        caracteristicas.innerHTML += `
                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                ${c.texto}
                            </span>`;
                    }
                });

                // 3. Abrir el modal de forma programática con Bootstrap 5
                const modalElement = document.getElementById("unidadModal");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();

            } catch (error) {
                console.error("Error cargando la unidad:", error);
                alert("No se pudieron cargar los detalles de la unidad.");
            }
        });

    });
</script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>