<!-- ============================================================
     UNITS
============================================================ -->
<section class="lp-section lp-section--alt" id="unidades">
    <div class="lp-container">

        <div class="units-header">
            <div>
                <span class="section-eyebrow"><i class="bi bi-houses-fill"></i> Disponibilidad</span>
                <h2 class="section-title" style="margin-bottom:4px;">Unidades Habitacionales</h2>
                <p class="section-sub">Explora los espacios disponibles dentro del complejo residencial.</p>
            </div>
            <div class="filter-pills">
                <button class="filter-pill active" data-filter="all">Todas</button>
                <button class="filter-pill" data-filter="Disponible">Disponibles</button>
                <button class="filter-pill" data-filter="Ocupada">Ocupadas</button>
            </div>
        </div>

        <div class="row g-4">
            @if (unidades != null && unidades.Any())
            {
                foreach (var u in unidades)
                {
                    var esDisponible = u.Estado == "Disponible";
                    var img = string.IsNullOrEmpty(u.Imagen)
                        ? "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80"
                        : u.Imagen;

                    <div class="col-xl-4 col-md-6 unit-item" data-status="@u.Estado">
                        <div class="unit-card">
                            <div class="unit-img">
                                <img src="@img" alt="Unidad @u.Numero" loading="lazy">
                                <div class="unit-img-overlay"></div>
                                @if (esDisponible)
                                {
                                    <span class="unit-status-badge usb--green">
                                        <i class="bi bi-patch-check"></i>Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="unit-status-badge usb--red">
                                        <i class="bi bi-lock-fill"></i>Ocupada
                                    </span>
                                }
                            </div>
                            <div class="unit-body">
                                <div class="unit-number">Unidad @u.Numero</div>
                                <p class="unit-desc">
                                    @(string.IsNullOrEmpty(u.Descripcion)
                                        ? "Sin descripción detallada para esta unidad. Contáctenos para más información."
                                        : u.Descripcion)
                                </p>
                                <div class="unit-specs">
                                    <div class="spec">
                                        <i class="bi bi-door-closed"></i>
                                        <span>@(u.CantidadHabitaciones ?? 0)</span>
                                        <small>Hab</small>
                                    </div>

                                    <div class="spec">
                                        <i class="bi bi-droplet-half"></i>
                                        <span>@(u.CantidadBanos ?? 0)</span>
                                        <small>Baños</small>
                                    </div>

                                    <div class="spec">
                                        <i class="bi bi-arrows-fullscreen"></i>
                                        <span>@(u.MetrosCuadrados ?? 0)</span>
                                        <small>m²</small>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-primary w-100 btn-detalles-unidad"
                                            data-id="@u.IdUnidad"
                                            data-bs-toggle="modal"
                                            data-bs-target="#unidadModal">
                                        <i class="bi bi-eye me-2"></i> Ver detalles
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-building-exclamation"></i>
                        <p>No hay unidades habitacionales configuradas aún.</p>
                    </div>
                </div>
            }
        </div>

    </div>
    @if (ViewBag.TotalPages > 1)
        {
            int currentPage = ViewBag.CurrentPage;
            int totalPages = ViewBag.TotalPages;
            int condominioId = ViewBag.CondominioId;

            <nav aria-label="Navegación de unidades" class="d-flex justify-content-center mt-4">
                <ul class="pagination pagination-md">

                    @* Botón Anterior *@
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" 
                           href="@Url.Action("Bienvenida", new { id = condominioId, page = currentPage - 1 })#unidades" 
                           aria-label="Anterior">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @* Números de Página *@
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" 
                               href="@Url.Action("Bienvenida", new { id = condominioId, page = i })#unidades">
                                @i
                            </a>
                        </li>
                    }

                    @* Botón Siguiente *@
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" 
                           href="@Url.Action("Bienvenida", new { id = condominioId, page = currentPage + 1 })#unidades" 
                           aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</section>

