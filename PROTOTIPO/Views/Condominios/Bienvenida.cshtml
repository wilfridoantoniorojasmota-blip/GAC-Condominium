        else if (valor.length > 3) {
            valor = valor.substring(0, 3) + "-" +
                valor.substring(3);
        }

        this.value = valor;
    });
</script>

//Script para validar cedula

<script>
    document.addEventListener("DOMContentLoaded", function() {

        const cedulaInput = document.getElementById("cedulaInput");
        const errorCedula = document.getElementById("err-cedula");
        const errorCedulaText = document.getElementById("err-cedula-text");
        const cedulaValida = document.getElementById("cedulaValida");
        const form = document.getElementById("formSolicitud");



        // ==========================================
        // FORMATEAR CÉDULA AUTOMÁTICAMENTE
        // ==========================================

        cedulaInput.addEventListener("input", function() {

            let valor = this.value.replace(/\D/g, "");

            // Máximo 11 dígitos
            valor = valor.substring(0, 11);

            let resultado = "";

            if (valor.length <= 3) {

                resultado = valor;

            } else if (valor.length <= 10) {

                resultado =
                    valor.substring(0, 3) +
                    "-" +
                    valor.substring(3);

            } else {

                resultado =
                    valor.substring(0, 3) +
                    "-" +
                    valor.substring(3, 10) +
                    "-" +
                    valor.substring(10, 11);
            }

            this.value = resultado;

            validarCedula();
        });



        // ==========================================
        // VALIDAR CÉDULA
        // ==========================================

        function validarCedula() {

            const valor =
                cedulaInput.value.replace(/\D/g, "");


            // Mientras todavía está escribiendo
            if (valor.length === 0) {

                ocultarEstadoCedula();

                return false;
            }


            // No validar hasta tener 11 dígitos
            if (valor.length < 11) {

                mostrarError(
                    "La cédula debe contener 11 dígitos."
                );

                return false;
            }


            // ==========================================
            // ALGORITMO CÉDULA DOMINICANA
            // ==========================================

            let suma = 0;

            for (let i = 0; i < 10; i++) {

                const digito =
                    parseInt(valor.charAt(i));

                const multiplicador =
                    (i % 2 === 0) ? 1 : 2;

                const resultado =
                    digito * multiplicador;

                if (resultado >= 10) {

                    suma +=
                        Math.floor(resultado / 10) +
                        (resultado % 10);

                } else {

                    suma += resultado;
                }
            }


            const digitoVerificador =
                (10 - (suma % 10)) % 10;

            const ultimoDigito =
                parseInt(valor.charAt(10));


            if (digitoVerificador !== ultimoDigito) {

                mostrarError(
                    "La cédula no es válida. Verifique los números ingresados."
                );

                return false;
            }


            // ==========================================
            // CÉDULA CORRECTA
            // ==========================================

            mostrarCedulaValida();

            return true;
        }



        // ==========================================
        // MOSTRAR ERROR
        // ==========================================

        function mostrarError(mensaje) {

            errorCedula.style.display = "block";

            errorCedulaText.textContent = mensaje;

            cedulaValida.style.display = "none";

            cedulaInput.classList.add("is-invalid");

            cedulaInput.classList.remove("is-valid");
        }



        // ==========================================
        // MOSTRAR VÁLIDA
        // ==========================================

        function mostrarCedulaValida() {

            errorCedula.style.display = "none";

            cedulaValida.style.display = "block";

            cedulaInput.classList.remove("is-invalid");

            cedulaInput.classList.add("is-valid");
        }



        // ==========================================
        // OCULTAR ESTADO
        // ==========================================

        function ocultarEstadoCedula() {

            errorCedula.style.display = "none";

            cedulaValida.style.display = "none";

            cedulaInput.classList.remove("is-invalid");

            cedulaInput.classList.remove("is-valid");
        }



        // ==========================================
        // VALIDAR AL ENVIAR
        // ==========================================

        form.addEventListener("submit", function(event) {

            if (!validarCedula()) {

                event.preventDefault();

                cedulaInput.focus();

            }

        });

    });
</script>






