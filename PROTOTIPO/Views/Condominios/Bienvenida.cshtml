<style>
    /* ===== Tokens ===== */
    #unidadModal {
        --um-ink: #16233D;
        --um-ink-soft: #4B5768;
        --um-muted: #8891A0;
        --um-gold: #1a56e8;
        --um-gold-soft: #1a56e8;
        --um-bg: #FFFFFF;
        --um-bg-alt: #F7F6F3;
        --um-line: #E9E7E2;
        --um-radius: 20px;
        font-family: 'Inter', system-ui, sans-serif;
    }

        #unidadModal .um-content {
            border-radius: var(--um-radius);
            overflow: hidden;
            background: var(--um-bg);
            box-shadow: 0 30px 60px -20px rgba(22, 35, 61, 0.35);
        }

        #unidadModal .um-close {
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 5;
            width: 34px;
            height: 34px;
            background-color: rgba(255, 255, 255, 0.92);
            border-radius: 50%;
            opacity: 1;
            background-size: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        /* ===== Hero ===== */
        #unidadModal .um-hero {
            position: relative;
            width: 100%;
            height: 260px;
            background: linear-gradient(135deg, #1C2B4A, #16233D);
        }

        #unidadModal .um-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        #unidadModal .um-hero-fade {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(22, 35, 61, 0) 55%, rgba(22, 35, 61, 0.55) 100%);
            pointer-events: none;
        }

        #unidadModal .um-estado-pill {
            position: absolute;
            left: 20px;
            bottom: 18px;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .45rem 1rem;
            border-radius: 999px;
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: .8rem;
            letter-spacing: .02em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.95);
            color: var(--um-ink);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        }

            #unidadModal .um-estado-pill::before {
                content: "";
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--um-gold);
                flex-shrink: 0;
            }

            /* Variantes de color según el texto que inyecta el JS */
            #unidadModal .um-estado-pill[data-estado="disponible"]::before {
                background: #2F8F5B;
            }

            #unidadModal .um-estado-pill[data-estado="reservada"]::before {
                background: #B8863F;
            }

            #unidadModal .um-estado-pill[data-estado="vendida"]::before {
                background: #B0432C;
            }

        /* ===== Body ===== */
        #unidadModal .um-body {
            padding: 1.75rem 2rem 2rem;
            background: var(--um-bg);
        }

        #unidadModal .um-eyebrow {
            font-family: 'Manrope', sans-serif;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--um-gold);
            margin-bottom: .35rem;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        #unidadModal .um-titulo {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            color: var(--um-ink);
            font-size: 1.6rem;
            margin-bottom: .4rem;
        }

        #unidadModal .um-descripcion {
            color: var(--um-ink-soft);
            font-size: .95rem;
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* ===== Ficha técnica (specs) ===== */
        #unidadModal .um-specs {
            display: flex;
            margin-top: 1.5rem;
            background: var(--um-bg-alt);
            border: 1px solid var(--um-line);
            border-radius: 14px;
            overflow: hidden;
        }

        #unidadModal .um-spec {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: .25rem;
            padding: 1.1rem .5rem;
            position: relative;
        }

            #unidadModal .um-spec + .um-spec::before {
                content: "";
                position: absolute;
                left: 0;
                top: 18%;
                bottom: 18%;
                width: 1px;
                background: var(--um-line);
            }

        #unidadModal .um-spec-icon {
            font-size: 1.15rem;
            color: var(--um-gold);
            margin-bottom: .15rem;
        }

        #unidadModal .um-spec-valor {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--um-ink);
        }

        #unidadModal .um-spec-label {
            font-size: .72rem;
            color: var(--um-muted);
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        #unidadModal .um-divider {
            height: 1px;
            background: var(--um-line);
            margin: 1.75rem 0 1.1rem;
        }

        #unidadModal .um-subtitulo {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            color: var(--um-ink);
            font-size: .95rem;
            margin-bottom: .9rem;
        }

        /* ===== Características (chips) ===== */
        #unidadModal .um-caracteristicas {
            display: flex;
            flex-wrap: wrap;
            gap: .55rem;
        }

            #unidadModal .um-caracteristicas .badge,
            #unidadModal .um-caracteristicas span {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                padding: .5rem .9rem;
                border-radius: 999px;
                background: var(--um-gold-soft);
                color: #8A6420;
                font-weight: 600;
                font-size: .82rem;
                border: 1px solid #EBD9B8;
            }

    @@media (max-width: 576px) {
        #unidadModal .um-hero {
            height: 190px;
        }

        #unidadModal .um-specs {
            flex-wrap: wrap;
        }

        #unidadModal .um-spec {
            flex: 1 1 50%;
        }

            #unidadModal .um-spec:nth-child(2)::before {
                display: none;
            }
    }
</style>


<style>
    /* ============================================================
       MODAL — Solicitud de Ingreso
       Tokens: ink #0c1220 · accent #1a56e8 · teal #0fd4b0
       Sora (display) + Inter (body)
       ============================================================ */

    /* Backdrop más oscuro y con blur */
    #solicitudModal .modal-backdrop,
    #solicitudModal + .modal-backdrop {
        backdrop-filter: blur(4px);
    }

    /* Dialog */
    #solicitudModal .modal-dialog {
        max-width: 520px;
    }

    /* Content */
    #solicitudModal .modal-content {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(12, 18, 32, .22), 0 8px 24px rgba(12, 18, 32, .1);
        font-family: 'Inter', system-ui, sans-serif;
    }

    /* ── Header ─────────────────────────────────────────────── */
    .sol-header {
        background: linear-gradient(135deg, #0c1220 0%, #1a2540 100%);
        padding: 32px 32px 28px;
        position: relative;
        overflow: hidden;
    }

        /* Dot grid texture */
        .sol-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }

        /* Teal glow */
        .sol-header::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.18) 0%, transparent 68%);
            top: -80px;
            right: -50px;
            pointer-events: none;
        }

    .sol-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .sol-header-icon {
        width: 52px;
        height: 52px;
        background: rgba(26, 86, 232, .25);
        border: 1px solid rgba(26, 86, 232, .35);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #93c5fd;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .sol-header-text {
        flex: 1;
    }

    .sol-header-eyebrow {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #0fd4b0;
        margin-bottom: 6px;
    }

    .sol-header-title {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -.03em;
        line-height: 1.15;
        margin: 0 0 4px;
    }

    .sol-header-sub {
        font-size: .8rem;
        color: rgba(255,255,255,.5);
        margin: 0;
        line-height: 1.5;
    }

    .sol-close-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.15);
        background: rgba(255,255,255,.07);
        color: rgba(255,255,255,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .2s ease;
        flex-shrink: 0;
        font-size: .85rem;
    }

        .sol-close-btn:hover {
            background: rgba(255,255,255,.15);
            color: #fff;
        }

    /* ── Progress steps (visual only) ──────────────────────── */
    .sol-steps {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 32px;
        background: #f8fafc;
        border-bottom: 1px solid #e4e9f0;
        position: relative;
        z-index: 1;
    }

    .sol-step {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 0;
        flex: 1;
        position: relative;
    }

        .sol-step:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: calc(100% - 110px);
            height: 1px;
            background: #e4e9f0;
            left: 110px;
        }

    .sol-step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        font-weight: 700;
        flex-shrink: 0;
        transition: all .3s ease;
    }

    .sol-step-num--done {
        background: #1a56e8;
        color: #fff;
    }

    .sol-step-num--active {
        background: #1a56e8;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(26,86,232,.18);
    }

    .sol-step-num--idle {
        background: #e4e9f0;
        color: #7a8799;
    }

    .sol-step-label {
        font-size: .75rem;
        font-weight: 600;
        color: #7a8799;
        white-space: nowrap;
    }

    .sol-step--active .sol-step-label {
        color: #0c1220;
    }

    /* ── Body ───────────────────────────────────────────────── */
    .sol-body {
        padding: 28px 32px;
        background: #ffffff;
    }

    /* Field group */
    .sol-field {
        margin-bottom: 20px;
    }

        .sol-field:last-child {
            margin-bottom: 0;
        }

    .sol-field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .sol-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .78rem;
        font-weight: 600;
        color: #3d4a5c;
        margin-bottom: 7px;
        letter-spacing: .01em;
    }

        .sol-label i {
            color: #1a56e8;
            font-size: .85rem;
        }

        .sol-label .required-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #ef4444;
            display: inline-block;
            margin-left: 2px;
        }

    /* Input base */
    .sol-input,
    .sol-select,
    .sol-textarea {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid #e4e9f0;
        border-radius: 12px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: .875rem;
        color: #0c1220;
        background: #f8fafc;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
        outline: none;
        -webkit-appearance: none;
        appearance: none;
    }

        .sol-input:focus,
        .sol-select:focus,
        .sol-textarea:focus {
            border-color: #1a56e8;
            box-shadow: 0 0 0 3px rgba(26,86,232,.12);
            background: #ffffff;
        }

        .sol-input::placeholder,
        .sol-textarea::placeholder {
            color: #b0bac7;
        }

    /* Input with icon prefix */
    .sol-input-wrap {
        position: relative;
    }

        .sol-input-wrap .sol-input {
            padding-left: 42px;
        }

        .sol-input-wrap .sol-input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #b0bac7;
            font-size: .95rem;
            pointer-events: none;
            transition: color .2s ease;
        }

        .sol-input-wrap .sol-input:focus + .sol-input-icon,
        .sol-input-wrap:focus-within .sol-input-icon {
            color: #1a56e8;
        }
    /* icon is before input in DOM — use parent trick */
    .sol-input-wrap {
        display: flex;
        align-items: center;
    }

        .sol-input-wrap .sol-input {
            flex: 1;
            padding-left: 42px;
        }

        .sol-input-wrap .sol-input-icon {
            position: absolute;
            left: 14px;
        }

    /* Select custom arrow */
    .sol-select-wrap {
        position: relative;
    }

        .sol-select-wrap .sol-select {
            padding-right: 38px;
            cursor: pointer;
        }

        .sol-select-wrap::after {
            content: '\F282'; /* bi-chevron-down */
            font-family: 'bootstrap-icons';
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a8799;
            pointer-events: none;
            font-size: .85rem;
        }

    /* Textarea */
    .sol-textarea {
        resize: vertical;
        min-height: 90px;
        line-height: 1.6;
    }

    /* Unidades badge select — pill options */
    .sol-unit-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .73rem;
        color: #7a8799;
        margin-top: 6px;
    }

        .sol-unit-hint i {
            color: #0fd4b0;
        }

    /* ── Footer ─────────────────────────────────────────────── */
    .sol-footer {
        padding: 20px 32px 28px;
        background: #f8fafc;
        border-top: 1px solid #e4e9f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .sol-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        color: #7a8799;
        flex: 1;
    }

        .sol-footer-note i {
            color: #0fd4b0;
            font-size: .85rem;
        }

    .sol-footer-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-sol-cancel {
        font-family: 'Inter', system-ui, sans-serif;
        font-size: .875rem;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 12px;
        border: 1.5px solid #e4e9f0;
        background: transparent;
        color: #3d4a5c;
        cursor: pointer;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-sol-cancel:hover {
            background: #ffffff;
            border-color: #c8d2de;
            color: #0c1220;
        }

    .btn-sol-submit {
        font-family: 'Inter', system-ui, sans-serif;
        font-size: .875rem;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 12px;
        border: none;
        background: #1a56e8;
        color: #fff;
        cursor: pointer;
        transition: all .2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(26, 86, 232, .35);
    }

        .btn-sol-submit:hover {
            background: #1447d0;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26, 86, 232, .45);
        }

        .btn-sol-submit:active {
            transform: translateY(0);
        }

        /* Spinner inside submit */
        .btn-sol-submit .spinner {
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .btn-sol-submit.loading .btn-label {
            display: none;
        }

        .btn-sol-submit.loading .spinner {
            display: block;
        }

        .btn-sol-submit.loading i {
            display: none;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Validation styles ──────────────────────────────────── */
    .sol-input.is-invalid,
    .sol-select.is-invalid,
    .sol-textarea.is-invalid {
        border-color: #ef4444;
        box-shadow: 0 0 0 3px rgba(239,68,68,.1);
    }

    .sol-field-error {
        display: none;
        font-size: .73rem;
        color: #ef4444;
        margin-top: 5px;
        font-weight: 500;
        align-items: center;
        gap: 4px;
    }

        .sol-field-error.visible {
            display: flex;
        }

    /* ── Responsive ─────────────────────────────────────────── */
    @@media (max-width: 575px) {
        #solicitudModal .modal-dialog {
            margin: 12px;
        }

        .sol-header, .sol-body, .sol-footer {
            padding-left: 22px;
            padding-right: 22px;
        }

        .sol-field-row {
            grid-template-columns: 1fr;
        }

        .sol-steps {
            display: none;
        }

        .sol-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .sol-footer-actions {
            flex-direction: column;
        }

        .btn-sol-cancel, .btn-sol-submit {
            width: 100%;
            justify-content: center;
        }
    }
</style>

