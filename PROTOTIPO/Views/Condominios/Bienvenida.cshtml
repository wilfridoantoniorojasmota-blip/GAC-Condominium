<script>
    (function() {
        const form = document.getElementById('formSolicitud');
        const btn = document.getElementById('btnSubmitSolicitud');
        const nombre = form?.querySelector('[name="NombreSolicitante"]');
        const contactoInput = form?.querySelector('[name="Contacto"]');
        const apellido = form?.querySelector('[name="Apellido"]');

        if (!form) return;

        /* -------------------------------------------------------------
           1. LISTA VIRTUALIZADA DE UNIDADES (carga por lotes + scroll infinito)
        ------------------------------------------------------------- */
        const listaUnidades = document.getElementById('listaUnidades');
        const unidadesDataEl = document.getElementById('unidadesData');
        const wrapUnidades = document.getElementById('unidadesListWrap');
        const loadingMore = document.getElementById('loadingMore');
        const noUnidadesMsg = document.getElementById('noUnidadesMsg');
        const hiddenIdUnidad = document.getElementById('selectedUnidadId');
        const buscarInput = document.getElementById('buscarUnidad');

        let todasLasUnidades = [];
        try {
            todasLasUnidades = unidadesDataEl ? JSON.parse(unidadesDataEl.textContent) : [];
        } catch (err) {
            console.error('Error al parsear unidades:', err);
        }

        let filtradas = todasLasUnidades;
        let renderizadas = 0;
        const LOTE = 40; // cuántas se pintan por tanda

        function renderLote() {
            if (!listaUnidades) return;
            const siguienteLote = filtradas.slice(renderizadas, renderizadas + LOTE);

            siguienteLote.forEach(u => {
                const item = document.createElement('label');
                item.className = 'list-group-item d-flex align-items-center gap-2 unidad-item';
                item.setAttribute('data-numero', (u.numero || '').toLowerCase());
                item.style.cursor = 'pointer';
                item.innerHTML = `
                        <input type="radio" class="form-check-input mt-0" name="IdUnidadVisual" value="${u.id}">
                        <i class="bi bi-door-closed"></i>
                        <span class="fw-semibold">${u.numero}</span>
                    `;
                listaUnidades.appendChild(item);
            });

            renderizadas += siguienteLote.length;
            noUnidadesMsg?.classList.toggle('d-none', filtradas.length !== 0);
            loadingMore?.classList.toggle('d-none', renderizadas >= filtradas.length);
        }

        function resetYRenderizar(nuevaLista) {
            filtradas = nuevaLista;
            renderizadas = 0;
            if (listaUnidades) listaUnidades.innerHTML = '';
            renderLote();
        }

        // Selección: click en la fila marca el radio y llena el hidden real
        listaUnidades?.addEventListener('click', function(e) {
            const row = e.target.closest('.unidad-item');
            if (!row) return;
            const radio = row.querySelector('input[type="radio"]');
            if (radio) {
                radio.checked = true;
                if (hiddenIdUnidad) hiddenIdUnidad.value = radio.value;
                // resaltar visualmente la fila seleccionada
                listaUnidades.querySelectorAll('.unidad-item').forEach(el => el.classList.remove('active'));
                row.classList.add('active');
            }
        });

        // Scroll infinito: cuando el usuario llega casi al fondo, pinta el siguiente lote
        wrapUnidades?.addEventListener('scroll', function() {
            const cercaDelFondo = wrapUnidades.scrollTop + wrapUnidades.clientHeight >= wrapUnidades.scrollHeight - 40;
            if (cercaDelFondo && renderizadas < filtradas.length) {
                renderLote();
            }
        });

        // Filtro por texto (reinicia la lista virtualizada con el resultado filtrado)
        buscarInput?.addEventListener('input', function(e) {
            const filtro = e.target.value.toLowerCase().trim();
            const resultado = filtro
                ? todasLasUnidades.filter(u => (u.numero || '').toLowerCase().includes(filtro))
                : todasLasUnidades;
            resetYRenderizar(resultado);
        });

        // Primer render al cargar
        resetYRenderizar(todasLasUnidades);

        /* -------------------------------------------------------------
           2. VALIDACIONES INLINE (BLUR / INPUT)
        ------------------------------------------------------------- */
        function validateField(input, errorId, checkFn) {
            const errEl = document.getElementById(errorId);
            input.addEventListener('blur', function() {
                const invalid = !checkFn(this.value);
                this.classList.toggle('is-invalid', invalid);
                errEl?.classList.toggle('visible', invalid);
            });
            input.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && checkFn(this.value)) {
                    this.classList.remove('is-invalid');
                    errEl?.classList.remove('visible');
                }
            });
        }

        if (nombre) validateField(nombre, 'err-nombre', v => v.trim().length > 1);
        if (apellido) validateField(apellido, 'err-apellido', v => v.trim().length > 1);
        if (contactoInput) validateField(contactoInput, 'err-email', v => {
            const at = String.fromCharCode(64);
            return new RegExp('^[^\\s' + at + ']+' + at + '[^\\s' + at + ']+' + '\\.[^\\s' + at + ']+' + '$').test(v);
        });

        /* -------------------------------------------------------------
           3. MODAL DE ERROR
        ------------------------------------------------------------- */
        window.showErrorModal = function(message) {
            const modalHtml = `
                        <div class="modal fade" id="errorSolicitudModal" tabindex="-1" aria-hidden="true">
                          <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content" style="background:#ffffff;border-radius:16px;padding:28px;text-align:center;">
                              <div style="font-size:48px;color:#ef4444;margin-bottom:12px;">&#10005;</div>
                              <h5 style="margin:0 0 8px;font-weight:800;color:#0c1220;">Atención</h5>
                              <p style="margin:0;color:#475569;">${message}</p>
                            </div>
                          </div>
                        </div>`;

            let existing = document.getElementById('errorSolicitudModal');
            if (existing) existing.remove();
            const wrapper = document.createElement('div');
            wrapper.innerHTML = modalHtml;
            document.body.appendChild(wrapper.firstElementChild);
            const modalEl = document.getElementById('errorSolicitudModal');
            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
            setTimeout(() => { try { bsModal.hide(); } catch (e) { }; const el = document.getElementById('errorSolicitudModal'); if (el) el.remove(); }, 2500);
        }

        /* -------------------------------------------------------------
           4. SUBMIT CON VALIDACIÓN DE UNIDAD OBLIGATORIA
        ------------------------------------------------------------- */
        form.addEventListener('submit', function(e) {
            let valid = true;

            if (nombre && nombre.value.trim().length < 2) {
                nombre.classList.add('is-invalid');
                document.getElementById('err-nombre')?.classList.add('visible');
                valid = false;
            }
            if (apellido && apellido.value.trim().length < 2) {
                apellido.classList.add('is-invalid');
                document.getElementById('err-apellido')?.classList.add('visible');
                valid = false;
            }

            if (contactoInput) {
                const at = String.fromCharCode(64);
                const re = new RegExp('^[^\\s' + at + ']+' + at + '[^\\s' + at + ']+' + '\\.[^\\s' + at + ']+' + '$');
                if (!re.test(contactoInput.value)) {
                    contactoInput.classList.add('is-invalid');
                    document.getElementById('err-email')?.classList.add('visible');
                    valid = false;
                }
            }

            // Verificar selección de unidad (ahora se lee del hidden real)
            const unidadSeleccionada = hiddenIdUnidad && hiddenIdUnidad.value;
            if (!unidadSeleccionada) {
                e.preventDefault();
                showErrorModal('Debes seleccionar una unidad disponible para continuar.');
                return;
            }

            if (!valid) {
                e.preventDefault();
                showErrorModal('Por favor completa todos los campos requeridos.');
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;
        });
    })();
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ============================================================
        // REFERENCIAS AL DOM
        // ============================================================
        const form = document.getElementById("formSolicitud");
        const tipoCliente = document.getElementById("tipoCliente");

        // Secciones / Contenedores
        const datosPersona = document.getElementById("datosPersona");
        const documentoDominicano = document.getElementById("documentoDominicano");
        const documentoExtranjero = document.getElementById("documentoExtranjero");
        const datosJuridico = document.getElementById("datosJuridico");

        // Inputs
        const cedulaInput = document.getElementById("cedulaInput");
        const pasaporteInput = document.getElementById("pasaporteInput");
        const rncInput = document.getElementById("rncInput");
        const nombreInput = document.getElementById("nombreInput");
        const apellidoInput = document.getElementById("apellidoInput");
        const nombreEmpresaInput = document.getElementById("nombreEmpresaInput");
        const personaAlojadaInput = document.getElementById("personaAlojadaInput");

        // Mensajes de Error / Validación
        const errCedula = document.getElementById("err-cedula");
        const cedulaValida = document.getElementById("cedulaValida");
        const errPasaporte = document.getElementById("err-pasaporte");
        const pasaporteValido = document.getElementById("pasaporteValido");
        const errRnc = document.getElementById("err-rnc");
        const rncValido = document.getElementById("rncValido");


        // ============================================================
        // FUNCIONES DE VALIDACIÓN
        // ============================================================

        // Algoritmo Luhn (Módulo 10) para Cédula Dominicana
        function esCedulaValida(cedula) {
            const val = cedula.replace(/\D/g, "");
            if (!/^\d{11}$/.test(val)) return false;
            if (/^(\d)\1{10}$/.test(val)) return false;

            const digitos = val.split("").map(Number);
            let suma = 0;

            for (let i = 0; i < 10; i++) {
                let digito = digitos[i];
                if (i % 2 === 0) {
                    digito *= 1;
                } else {
                    digito *= 2;
                    if (digito > 9) digito -= 9;
                }
                suma += digito;
            }

            const verificador = (10 - (suma % 10)) % 10;
            return verificador === digitos[10];
        }

        // Manejo de UI para Cédula
        function validarCedulaUI() {
            if (!cedulaInput) return true;
            if (documentoDominicano && documentoDominicano.style.display === "none") return true;

            const esValido = esCedulaValida(cedulaInput.value);

            if (!esValido) {
                if (errCedula) errCedula.style.display = "flex";
                if (cedulaValida) cedulaValida.style.display = "none";
                cedulaInput.classList.add("is-invalid");
                cedulaInput.classList.remove("is-valid");
                return false;
            } else {
                if (errCedula) errCedula.style.display = "none";
                if (cedulaValida) cedulaValida.style.display = "block";
                cedulaInput.classList.remove("is-invalid");
                cedulaInput.classList.add("is-valid");
                return true;
            }
        }

        // Validación de Pasaporte Extranjero
        function validarPasaporte() {
            if (!pasaporteInput) return true;
            if (documentoExtranjero && documentoExtranjero.style.display === "none") return true;

            const val = pasaporteInput.value.trim();
            const pasaporteRegex = /^[A-Z0-9]{6,20}$/;

            if (!val || !pasaporteRegex.test(val)) {
                if (errPasaporte) errPasaporte.style.display = "flex";
                if (pasaporteValido) pasaporteValido.style.display = "none";
                pasaporteInput.classList.add("is-invalid");
                pasaporteInput.classList.remove("is-valid");
                return false;
            } else {
                if (errPasaporte) errPasaporte.style.display = "none";
                if (pasaporteValido) pasaporteValido.style.display = "block";
                pasaporteInput.classList.remove("is-invalid");
                pasaporteInput.classList.add("is-valid");
                return true;
            }
        }

        // Validación de RNC
        function validarRNC() {
            if (!rncInput) return true;
            if (datosJuridico && datosJuridico.style.display === "none") return true;

            const val = rncInput.value.replace(/\D/g, "");
            const rncValidoFormato = /^\d{9}$/.test(val) || /^\d{11}$/.test(val);

            if (!val || !rncValidoFormato) {
                if (errRnc) errRnc.style.display = "flex";
                if (rncValido) rncValido.style.display = "none";
                rncInput.classList.add("is-invalid");
                rncInput.classList.remove("is-valid");
                return false;
            } else {
                if (errRnc) errRnc.style.display = "none";
                if (rncValido) rncValido.style.display = "block";
                rncInput.classList.remove("is-invalid");
                rncInput.classList.add("is-valid");
                return true;
            }
        }


        // ============================================================
        // CAMBIO DE TIPO DE CLIENTE
        // ============================================================
        function actualizarFormularioPorTipo() {
            if (!tipoCliente) return;

            // Obtener el valor seleccionado, convertir a minúsculas y remover acentos/tildes
            const tipo = tipoCliente.value
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");

            // 1. Ocultar todas las secciones condicionales
            if (datosPersona) datosPersona.style.display = "none";
            if (documentoDominicano) documentoDominicano.style.display = "none";
            if (documentoExtranjero) documentoExtranjero.style.display = "none";
            if (datosJuridico) datosJuridico.style.display = "none";

            // 2. Arreglo de todos los inputs condicionales para limpiar valores y validaciones
            const camposDinamicos = [
                cedulaInput, pasaporteInput, rncInput,
                nombreInput, apellidoInput, nombreEmpresaInput, personaAlojadaInput
            ];

            // Resetear propiedad required y clases CSS visuales
            camposDinamicos.forEach(input => {
                if (input) {
                    input.required = false;
                    input.classList.remove("is-invalid", "is-valid");
                }
            });

            // Ocultar todos los mensajes de validación
            if (errCedula) errCedula.style.display = "none";
            if (cedulaValida) cedulaValida.style.display = "none";
            if (errPasaporte) errPasaporte.style.display = "none";
            if (pasaporteValido) pasaporteValido.style.display = "none";
            if (errRnc) errRnc.style.display = "none";
            if (rncValido) rncValido.style.display = "none";

            // 3. Activar visualización y flag 'required' únicamente según la selección
            if (tipo === "dominicano") {
                if (datosPersona) datosPersona.style.display = "block";
                if (documentoDominicano) documentoDominicano.style.display = "block";

                if (nombreInput) nombreInput.required = true;
                if (apellidoInput) apellidoInput.required = true;
                if (cedulaInput) cedulaInput.required = true;

            } else if (tipo === "extranjero") {
                if (datosPersona) datosPersona.style.display = "block";
                if (documentoExtranjero) documentoExtranjero.style.display = "block";

                if (nombreInput) nombreInput.required = true;
                if (apellidoInput) apellidoInput.required = true;
                if (pasaporteInput) pasaporteInput.required = true;

            } else if (tipo === "juridico") {
                if (datosPersona) datosPersona.style.display = "block";
                if (datosJuridico) datosJuridico.style.display = "block";

                if (nombreInput) nombreInput.required = true;
                if (apellidoInput) apellidoInput.required = true;
                if (nombreEmpresaInput) nombreEmpresaInput.required = true;
                if (personaAlojadaInput) personaAlojadaInput.required = true;
                if (rncInput) rncInput.required = true;
            }
        }

        if (tipoCliente) {
            tipoCliente.addEventListener("change", actualizarFormularioPorTipo);
            // Sincronizar el formulario de inmediato según la opción inicial
            actualizarFormularioPorTipo();
        }


        // ============================================================
        // EVENTOS DE ENTRADA ( INPUTS )
        // ============================================================
        if (cedulaInput) {
            cedulaInput.addEventListener("input", function () {
                this.value = this.value.replace(/[^\d-]/g, "");
                const tipo = tipoCliente ? tipoCliente.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";
                if (tipo === "dominicano") {
                    validarCedulaUI();
                }
            });
        }

        if (pasaporteInput) {
            pasaporteInput.addEventListener("input", function () {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, "");
                const tipo = tipoCliente ? tipoCliente.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";
                if (tipo === "extranjero") {
                    validarPasaporte();
                }
            });
        }

        if (rncInput) {
            rncInput.addEventListener("input", function () {
                this.value = this.value.replace(/[^\d-]/g, "");
                const tipo = tipoCliente ? tipoCliente.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";
                if (tipo === "juridico") {
                    validarRNC();
                }
            });
        }


        // ============================================================
        // CONTROL DE ENVÍO DE FORMULARIO
        // ============================================================
        if (form) {
            form.addEventListener("submit", function (e) {
                const tipo = tipoCliente ? tipoCliente.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";

                if (tipo === "dominicano") {
                    if (!validarCedulaUI()) {
                        e.preventDefault();
                        if (cedulaInput) cedulaInput.focus();
                        return;
                    }
                } else if (tipo === "extranjero") {
                    if (!validarPasaporte()) {
                        e.preventDefault();
                        if (pasaporteInput) pasaporteInput.focus();
                        return;
                    }
                } else if (tipo === "juridico") {
                    if (!validarRNC()) {
                        e.preventDefault();
                        if (rncInput) rncInput.focus();
                        return;
                    }
                }
            });
        }

    });
</script>

