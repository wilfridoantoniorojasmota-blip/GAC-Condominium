@model PROTOTIPO.Models.Condominio

@{
    ViewData["Title"] = "Eliminar Condominio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f5f7fa;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-soft: #eff6ff;
        --no-bg: #fff1f0;
        --no-ink: #b91c1c;
        --no-bdr: #fecaca;
        --no-acc: #ef4444;
        --no-dk: #dc2626;
        --amber-bg: #fffbeb;
        --amber-ink: #92400e;
        --amber-bdr: #fde68a;
        --amber-acc: #f59e0b;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --tr: .2s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    .del-shell {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 44px 20px 80px;
    }

    .del-panel {
        width: 100%;
        max-width: 560px;
    }

    /* ── Back ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 26px;
        transition: color var(--tr);
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* ── Card ── */
    .del-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ── Danger header ── */
    .del-head {
        background: var(--no-bg);
        border-bottom: 1px solid var(--no-bdr);
        padding: 26px 32px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .del-head-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: #fecaca;
        border: 1px solid #fca5a5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: var(--no-dk);
        flex-shrink: 0;
    }

    .del-head-title {
        font-family: var(--font-d);
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--no-ink);
        letter-spacing: -.03em;
        margin: 0;
    }

    .del-head-sub {
        font-size: .78rem;
        color: #dc2626;
        opacity: .7;
        margin: 3px 0 0;
    }

    /* ── Body ── */
    .del-body {
        padding: 28px 32px 32px;
    }

    /* ── Warning notice ── */
    .del-notice {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--amber-bg);
        border: 1px solid var(--amber-bdr);
        border-radius: var(--r-lg);
        padding: 14px 16px;
        margin-bottom: 24px;
    }

        .del-notice i {
            color: var(--amber-acc);
            font-size: .95rem;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .del-notice p {
            font-size: .825rem;
            color: var(--amber-ink);
            line-height: 1.6;
            margin: 0;
            font-weight: 500;
        }

    /* ── Condominio identity block ── */
    .entity-block {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        overflow: hidden;
        margin-bottom: 28px;
    }

    .entity-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
    }

    .entity-avatar {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        color: var(--accent);
        flex-shrink: 0;
    }

    .entity-name {
        font-family: var(--font-d);
        font-size: 1.05rem;
        font-weight: 800;
        letter-spacing: -.02em;
        color: var(--ink);
        margin: 0;
    }

    .entity-sub {
        font-size: .75rem;
        color: var(--ink-muted);
        margin: 2px 0 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Field rows */
    .field-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 20px;
        border-bottom: 1px solid var(--border);
        gap: 12px;
    }

        .field-row:last-child {
            border-bottom: none;
        }

    .field-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
    }

        .field-label i {
            font-size: .76rem;
            color: var(--accent);
        }

    .field-value {
        font-size: .855rem;
        font-weight: 600;
        color: var(--ink);
        text-align: right;
        word-break: break-all;
    }

        .field-value.muted {
            color: var(--ink-muted);
            font-weight: 400;
            font-style: italic;
            font-size: .8rem;
        }

    .field-link {
        font-size: .855rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        text-align: right;
        word-break: break-all;
    }

    /* ── Divider ── */
    .del-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 24px;
    }

    /* ── Actions ── */
    .action-row {
        display: flex;
        gap: 10px;
    }

    .btn-cancel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px;
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--font-b);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-cancel:hover {
            background: var(--surface-2);
            border-color: #c8d0dc;
            color: var(--ink);
        }

    .btn-delete {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px;
        border-radius: var(--r-lg);
        border: none;
        background: linear-gradient(135deg, var(--no-acc) 0%, var(--no-dk) 100%);
        color: #ffffff;
        font-family: var(--font-b);
        font-weight: 700;
        font-size: .9rem;
        cursor: pointer;
        transition: var(--tr);
        box-shadow: 0 4px 14px rgba(239,68,68,.28);
    }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(239,68,68,.38);
        }

        .btn-delete:active {
            transform: translateY(0);
        }

        .btn-delete.loading {
            opacity: .75;
            pointer-events: none;
        }

        .btn-delete .spinner {
            display: none;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .btn-delete.loading .spinner {
            display: block;
        }

        .btn-delete.loading .btn-icon {
            display: none;
        }

        .btn-delete.loading .btn-txt {
            opacity: .8;
        }
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 480px) {
        .del-head {
            padding: 20px 20px 16px;
        }

        .del-body {
            padding: 22px 20px 26px;
        }

        .action-row {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="del-shell">
    <div class="del-panel">

        <!-- Back -->
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Volver a condominios
        </a>

        <div class="del-card">

            <!-- Danger header -->
            <div class="del-head">
                <div class="del-head-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div>
                    <h1 class="del-head-title">Eliminar condominio</h1>
                    <p class="del-head-sub">Esta acción no se puede deshacer</p>
                </div>
            </div>

            <div class="del-body">

                <!-- Warning -->
                <div class="del-notice">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <p>Estás a punto de eliminar permanentemente el condominio y todos sus datos asociados: unidades habitacionales, áreas comunes, residentes e incidencias vinculadas.</p>
                </div>

                <!-- Entity block -->
                <div class="entity-block">

                    <!-- Identity header -->
                    <div class="entity-head">
                        <div class="entity-avatar">
                            <i class="bi bi-buildings-fill"></i>
                        </div>
                        <div>
                            <p class="entity-name">@Model.Nombre</p>
                            @if (!string.IsNullOrEmpty(Model.Direccion))
                            {
                                <p class="entity-sub">
                                    <i class="bi bi-geo-alt"></i>
                                    @Model.Direccion
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Field rows -->
                    @if (!string.IsNullOrEmpty(Model.Telefono))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-telephone"></i>Teléfono</span>
                            <span class="field-value">@Model.Telefono</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-envelope"></i>Email</span>
                            <span class="field-value">@Model.Email</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Tamano))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-aspect-ratio"></i>Tamaño</span>
                            <span class="field-value">@Model.Tamano</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Rnc))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-card-text"></i>RNC</span>
                            <span class="field-value">@Model.Rnc</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.PaginaWeb))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-globe"></i>Web</span>
                            <a href="@Model.PaginaWeb" target="_blank" rel="noopener noreferrer" class="field-link">@Model.PaginaWeb</a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Instagram))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-instagram"></i>Instagram</span>
                            <span class="field-value">@Model.Instagram</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Facebook))
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-facebook"></i>Facebook</span>
                            <span class="field-value">@Model.Facebook</span>
                        </div>
                    }

                    @if (Model.IdSectorNavigation != null)
                    {
                        <div class="field-row">
                            <span class="field-label"><i class="bi bi-map"></i>Sector</span>
                            <span class="field-value">#@Model.IdSectorNavigation.IdSector</span>
                        </div>
                    }

                </div>

                <hr class="del-divider">

                <!-- Actions -->
                <form asp-action="Delete" method="post" id="delForm">
                    <input type="hidden" asp-for="IdCondominio" />
                    <div class="action-row">
                        <a asp-action="Index" class="btn-cancel">
                            <i class="bi bi-x"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn-delete" id="delBtn">
                            <span class="spinner"></span>
                            <i class="bi bi-trash3-fill btn-icon"></i>
                            <span class="btn-txt">Eliminar condominio</span>
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById('delForm').addEventListener('submit', function () {
        const btn = document.getElementById('delBtn');
        btn.classList.add('loading');
        btn.querySelector('.btn-txt').textContent = 'Eliminando…';
    });
</script>
