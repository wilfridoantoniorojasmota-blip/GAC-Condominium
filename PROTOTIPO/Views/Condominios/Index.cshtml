@model IEnumerable<PROTOTIPO.Models.Condominio>

@{
    ViewData["Title"] = "Condominios";
    var total = Model.Count();
}

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f4f6fb;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-light: #eff4ff;
        --teal: #0fd4b0;
        --teal-light: #e6fdf9;
        --danger: #b91c1c;
        --danger-soft: #fff1f0;
        --danger-bdr: #fecaca;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 26px;
        --r-pill: 999px;
        --shadow-xs: 0 1px 3px rgba(12,18,32,.05);
        --shadow-sm: 0 2px 8px rgba(12,18,32,.07);
        --shadow-md: 0 8px 24px rgba(12,18,32,.09);
        --ease: .22s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* ── Page ── */
    .condo-page {
        padding: 28px 0 60px;
    }

    /* ── Header ── */
    .condo-hd {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .condo-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-light);
        padding: 5px 12px;
        border-radius: var(--r-pill);
        margin-bottom: 10px;
    }

    .condo-title {
        font-family: var(--font-d);
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -.035em;
        color: var(--ink);
        margin: 0 0 4px;
    }

    .condo-sub {
        font-size: .875rem;
        color: var(--ink-muted);
        margin: 0;
    }

    .btn-condo-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-b);
        font-size: .875rem;
        font-weight: 700;
        padding: 10px 22px;
        border-radius: var(--r-lg);
        border: none;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        transition: var(--ease);
        box-shadow: 0 4px 14px rgba(26,86,232,.32);
        white-space: nowrap;
    }

        .btn-condo-new:hover {
            background: #1447d0;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,86,232,.42);
        }

    /* ── Stat strip ── */
    .condo-stat-strip {
        display: flex;
        gap: 14px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .condo-stat {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 140px;
        box-shadow: var(--shadow-xs);
    }

    .condo-stat-ico {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .condo-stat-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 2px;
    }

    .condo-stat-value {
        font-family: var(--font-d);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -.04em;
        line-height: 1;
    }

    /* ── Toolbar ── */
    .condo-toolbar {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .condo-search-wrap {
        position: relative;
    }

    .condo-search {
        padding: 9px 14px 9px 36px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        font-family: var(--font-b);
        font-size: .85rem;
        color: var(--ink);
        background: var(--surface);
        outline: none;
        width: 220px;
        transition: var(--ease);
    }

        .condo-search:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(26,86,232,.1);
            background: #fff;
            width: 260px;
        }

        .condo-search::placeholder {
            color: #b8c4d0;
        }

    .condo-search-ico {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ink-muted);
        font-size: .82rem;
        pointer-events: none;
    }

    .condo-count-text {
        font-size: .78rem;
        color: var(--ink-muted);
        font-weight: 500;
    }

    /* ── Cards grid ── */
    .condo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 18px;
    }

    /* ── Condominio card ── */
    .condo-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: var(--ease);
        position: relative;
    }

        .condo-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: rgba(26,86,232,.2);
        }
        /* top accent bar on hover */
        .condo-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), var(--teal));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s var(--ease);
        }

        .condo-card:hover::before {
            transform: scaleX(1);
        }

    /* Card header */
    .cc-header {
        background: var(--ink);
        padding: 20px 22px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .cc-header::after {
            content: '';
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(26,86,232,.2) 0%, transparent 68%);
            top: -60px;
            right: -40px;
            pointer-events: none;
        }

    .cc-avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(26,86,232,.3);
        border: 1px solid rgba(26,86,232,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #93c5fd;
        font-size: 1.1rem;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .cc-name {
        font-family: var(--font-d);
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -.025em;
        color: #fff;
        position: relative;
        z-index: 1;
        line-height: 1.2;
        margin: 0;
    }

    .cc-rnc {
        font-size: .68rem;
        font-weight: 600;
        color: rgba(255,255,255,.4);
        letter-spacing: .05em;
        margin-top: 1px;
        position: relative;
        z-index: 1;
    }

    /* Card body */
    .cc-body {
        padding: 18px 22px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cc-info-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: .82rem;
    }

        .cc-info-row i {
            color: var(--accent);
            font-size: .85rem;
            margin-top: 1px;
            flex-shrink: 0;
            width: 16px;
            text-align: center;
        }

    .cc-info-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ink-muted);
        margin-bottom: 1px;
    }

    .cc-info-value {
        color: var(--ink-soft);
        font-weight: 500;
        line-height: 1.4;
        word-break: break-all;
    }

        .cc-info-value a {
            color: var(--accent);
            text-decoration: none;
            transition: color var(--ease);
        }

            .cc-info-value a:hover {
                color: #1447d0;
                text-decoration: underline;
            }

    /* Social row */
    .cc-socials {
        display: flex;
        gap: 7px;
        margin-top: 4px;
    }

    .cc-social-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .73rem;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: var(--r-pill);
        text-decoration: none;
        transition: var(--ease);
    }

    .csb--ig {
        background: #fce7f3;
        color: #be185d;
        border: 1px solid #fbcfe8;
    }

        .csb--ig:hover {
            background: #be185d;
            color: #fff;
        }

    .csb--fb {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

        .csb--fb:hover {
            background: #1d4ed8;
            color: #fff;
        }

    /* Tamaño chip */
    .cc-size-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: var(--r-pill);
        background: var(--teal-light);
        color: #0aaa8c;
        border: 1px solid rgba(15,212,176,.3);
    }

    /* Card footer */
    .cc-footer {
        padding: 14px 22px;
        border-top: 1px solid var(--border);
        background: #fafbfc;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
    }

    .btn-cc {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-b);
        font-size: .78rem;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: var(--r-md, 10px);
        border: 1.5px solid var(--border);
        background: transparent;
        color: var(--ink-muted);
        text-decoration: none;
        transition: var(--ease);
        cursor: pointer;
    }

        .btn-cc:hover {
            background: var(--surface);
            color: var(--ink);
            border-color: #c8d2de;
        }

    .btn-cc--edit:hover {
        background: var(--accent-light);
        color: var(--accent);
        border-color: rgba(26,86,232,.3);
    }

    .btn-cc--del:hover {
        background: var(--danger-soft);
        color: var(--danger);
        border-color: var(--danger-bdr);
    }

    /* ── Empty state ── */
    .condo-empty {
        background: var(--surface-2);
        border: 1.5px dashed var(--border);
        border-radius: var(--r-2xl);
        padding: 72px 32px;
        text-align: center;
    }

    .condo-empty-ico {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: var(--ink-muted);
        opacity: .5;
        margin: 0 auto 14px;
    }

    .condo-empty p {
        font-size: .9rem;
        color: var(--ink-muted);
        margin: 0 0 20px;
    }

    @@media (max-width: 575px) {
        .condo-grid {
            grid-template-columns: 1fr;
        }

        .condo-stat-strip {
            flex-direction: column;
        }

        .condo-search {
            width: 100%;
        }

            .condo-search:focus {
                width: 100%;
            }

        .condo-toolbar {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="condo-page">

    <!-- Header -->
    <div class="condo-hd">
        <div>
            <div class="condo-eyebrow"><i class="bi bi-buildings-fill"></i> Administración</div>
            <h1 class="condo-title">Condominios</h1>
            <p class="condo-sub">Gestiona todos los condominios registrados en el sistema.</p>
        </div>
        <a asp-action="Create" class="btn-condo-new">
            <i class="bi bi-plus-lg"></i> Nuevo Condominio
        </a>
    </div>

    <!-- Stat strip -->
    <div class="condo-stat-strip">
        <div class="condo-stat">
            <div class="condo-stat-ico"><i class="bi bi-buildings-fill"></i></div>
            <div>
                <div class="condo-stat-label">Total registrados</div>
                <div class="condo-stat-value">@total</div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="condo-toolbar">
        <div class="condo-search-wrap">
            <i class="bi bi-search condo-search-ico"></i>
            <input type="text" id="condoSearch" class="condo-search" placeholder="Buscar condominio…">
        </div>
        <span class="condo-count-text" id="condoCount">
            Mostrando <strong>@total</strong> condominio@(total != 1 ? "s" : "")
        </span>
    </div>

    <!-- Grid de cards -->
    @if (Model.Any())
    {
        <div class="condo-grid" id="condoGrid">
            @foreach (var item in Model)
            {
                var iniciales = "";
                if (!string.IsNullOrEmpty(item.Nombre))
                {
                    var palabras = item.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    iniciales = palabras.Length >= 2
                        ? $"{palabras[0][0]}{palabras[1][0]}"
                        : $"{palabras[0][0]}";
                    iniciales = iniciales.ToUpper();
                }

                <div class="condo-card" data-nombre="@item.Nombre?.ToLower()">

                    <!-- Card header -->
                    <div class="cc-header">
                        <div class="cc-avatar">@iniciales</div>
                        <div>
                            <div class="cc-name">@item.Nombre</div>
                            @if (!string.IsNullOrEmpty(item.Rnc))
                            {
                                <div class="cc-rnc">RNC: @item.Rnc</div>
                            }
                        </div>
                    </div>

                    <!-- Card body -->
                    <div class="cc-body">

                        @if (!string.IsNullOrEmpty(item.Direccion))
                        {
                            <div class="cc-info-row">
                                <i class="bi bi-geo-alt-fill"></i>
                                <div>
                                    <div class="cc-info-label">Dirección</div>
                                    <div class="cc-info-value">@item.Direccion</div>
                                </div>
                            </div>
                        }

                        <div style="display:flex;gap:16px;flex-wrap:wrap;">
                            @if (!string.IsNullOrEmpty(item.Telefono))
                            {
                                <div class="cc-info-row">
                                    <i class="bi bi-telephone-fill"></i>
                                    <div>
                                        <div class="cc-info-label">Teléfono</div>
                                        <div class="cc-info-value">@item.Telefono</div>
                                    </div>
                                </div>
                            }
                            @if (item.Tamano != null)
                            {
                                <div style="display:flex;align-items:center;gap:6px;margin-top:auto;">
                                    <span class="cc-size-chip">
                                        <i class="bi bi-aspect-ratio-fill"></i>
                                        @item.Tamano unidades
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(item.Email))
                        {
                            <div class="cc-info-row">
                                <i class="bi bi-envelope-fill"></i>
                                <div>
                                    <div class="cc-info-label">Correo</div>
                                    <div class="cc-info-value">
                                        <a href="mailto:@item.Email">@item.Email</a>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.PaginaWeb))
                        {
                            <div class="cc-info-row">
                                <i class="bi bi-globe2"></i>
                                <div>
                                    <div class="cc-info-label">Sitio web</div>
                                    <div class="cc-info-value">
                                        <a href="@item.PaginaWeb" target="_blank" rel="noopener">@item.PaginaWeb</a>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.Instagram) || !string.IsNullOrEmpty(item.Facebook))
                        {
                            <div class="cc-socials">
                                @if (!string.IsNullOrEmpty(item.Instagram))
                                {
                                    <a href="@item.Instagram" target="_blank" rel="noopener" class="cc-social-btn csb--ig">
                                        <i class="bi bi-instagram"></i> Instagram
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(item.Facebook))
                                {
                                    <a href="@item.Facebook" target="_blank" rel="noopener" class="cc-social-btn csb--fb">
                                        <i class="bi bi-facebook"></i> Facebook
                                    </a>
                                }
                            </div>
                        }

                    </div>

                    <!-- Card footer -->
                    <div class="cc-footer">
                        <a asp-action="Details" asp-route-id="@item.IdCondominio" class="btn-cc">
                            <i class="bi bi-eye"></i> Ver
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.IdCondominio" class="btn-cc btn-cc--edit">
                            <i class="bi bi-pencil-fill"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.IdCondominio" class="btn-cc btn-cc--del">
                            <i class="bi bi-trash3-fill"></i> Eliminar
                        </a>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="condo-empty">
            <div class="condo-empty-ico"><i class="bi bi-buildings"></i></div>
            <p>No hay condominios registrados aún.</p>
            <a asp-action="Create" class="btn-condo-new">
                <i class="bi bi-plus-lg"></i> Registrar primer condominio
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        (function () {
            var search  = document.getElementById('condoSearch');
            var cards   = document.querySelectorAll('.condo-card');
            var countEl = document.getElementById('condoCount');

            search?.addEventListener('input', function () {
                var q = this.value.toLowerCase().trim();
                var visible = 0;
                cards.forEach(function (c) {
                    var nombre = c.getAttribute('data-nombre') || '';
                    var show = nombre.includes(q);
                    c.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                if (countEl) {
                    countEl.innerHTML = 'Mostrando <strong>' + visible + '</strong> condominio' + (visible !== 1 ? 's' : '');
                }
            });
        })();
    </script>
}
