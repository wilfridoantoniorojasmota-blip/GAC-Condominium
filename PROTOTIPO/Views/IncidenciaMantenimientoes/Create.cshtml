@model PROTOTIPO.Models.IncidenciaMantenimiento

@{
    ViewData["Title"] = "Nueva Incidencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f5f7fa;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-2: #0fd4b0;
        --accent-soft: #eff6ff;
        --no-bg: #fff1f0;
        --no-ink: #b91c1c;
        --no-bdr: #fecaca;
        --amber-bg: #fffbeb;
        --amber-acc: #f59e0b;
        --amber-bdr: #fde68a;
        --ok-bg: #f0fdf6;
        --ok-ink: #15803d;
        --ok-bdr: #bbf7d0;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --tr: .2s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Shell ── */
    .inc-shell {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 44px 20px 80px;
    }

    .inc-panel {
        width: 100%;
        max-width: 660px;
    }

    /* ── Back ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 26px;
        transition: color var(--tr);
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* ── Card ── */
    .inc-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ── Header ── */
    .inc-head {
        position: relative;
        padding: 30px 36px 26px;
        background: var(--ink);
        overflow: hidden;
    }

        .inc-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .inc-head::after {
            content: '';
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.18) 0%, transparent 70%);
            right: -50px;
            top: -60px;
            pointer-events: none;
        }

    .inc-head-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .inc-head-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #ffffff;
        flex-shrink: 0;
    }

    .inc-head-title {
        font-family: var(--font-d);
        font-size: 1.2rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -.03em;
        margin: 0;
    }

    .inc-head-sub {
        font-size: .78rem;
        color: rgba(255,255,255,.5);
        margin: 3px 0 0;
    }

    /* ── Body ── */
    .inc-body {
        padding: 32px 36px 36px;
    }

    /* ── Validation summary ── */
    .val-summary {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--no-bg);
        border: 1px solid var(--no-bdr);
        border-radius: var(--r-lg);
        padding: 14px 18px;
        margin-bottom: 28px;
        font-size: .855rem;
        color: var(--no-ink);
    }

        .val-summary i {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .val-summary:empty {
            display: none;
        }

    /* ── Section heading ── */
    .sec-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }

        .sec-heading i {
            color: var(--accent);
            font-size: .82rem;
        }

    /* ── Field label ── */
    .f-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 7px;
    }

        .f-label i {
            font-size: .8rem;
            color: var(--accent);
        }

    .f-optional {
        font-size: .62rem;
        font-weight: 600;
        color: var(--accent-2);
        letter-spacing: .05em;
        margin-left: 4px;
    }

    /* ── Inputs & selects ── */
    .f-control {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        font-family: var(--font-b);
        font-size: .9rem;
        color: var(--ink);
        transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
        outline: none;
        appearance: none;
        -webkit-appearance: none;
    }

        .f-control:focus {
            border-color: var(--accent);
            background: var(--surface-2);
            box-shadow: 0 0 0 3px rgba(26,86,232,.1);
        }

        .f-control::placeholder {
            color: var(--border);
        }

    textarea.f-control {
        resize: vertical;
        min-height: 110px;
        line-height: 1.65;
    }

    /* Select with custom arrow */
    .select-wrap {
        position: relative;
    }

        .select-wrap::after {
            content: '\F282';
            font-family: 'bootstrap-icons';
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-size: .9rem;
            color: var(--ink-muted);
            pointer-events: none;
        }

        .select-wrap .f-control {
            padding-right: 36px;
            cursor: pointer;
        }

    /* Date input icon override */
    input[type="date"].f-control::-webkit-calendar-picker-indicator {
        opacity: .4;
        cursor: pointer;
    }

    /* Validation messages */
    .f-error {
        font-size: .77rem;
        color: var(--no-ink);
        font-weight: 600;
        margin-top: 6px;
        display: none;
        align-items: center;
        gap: 5px;
    }

        .f-error:not(:empty) {
            display: flex;
        }

            /* Ícono inyectado via CSS solo cuando hay mensaje */
            .f-error:not(:empty)::before {
                content: '\F332';
                font-family: 'bootstrap-icons';
                font-size: .8rem;
                flex-shrink: 0;
            }

    /* ── Status cards (radio-style selector) ── */
    .status-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    @@media (max-width: 480px) {
        .status-grid {
            grid-template-columns: 1fr;
        }
    }

    .status-opt {
        position: relative;
    }

        .status-opt input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

    .status-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 14px 10px;
        border-radius: var(--r-lg);
        border: 1.5px solid var(--border);
        background: var(--surface);
        cursor: pointer;
        transition: var(--tr);
        text-align: center;
    }

        .status-tile:hover {
            border-color: #c8d0dc;
            background: var(--surface-2);
        }

    .status-tile-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .status-tile-name {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink-soft);
        letter-spacing: .02em;
    }

    /* Checked states */
    .status-opt input:checked + .status-tile.pendiente {
        border-color: var(--amber-acc);
        background: var(--amber-bg);
        box-shadow: 0 0 0 3px rgba(245,158,11,.1);
    }

        .status-opt input:checked + .status-tile.pendiente .status-tile-name {
            color: #92400e;
        }

    .status-opt input:checked + .status-tile.proceso {
        border-color: var(--accent);
        background: var(--accent-soft);
        box-shadow: 0 0 0 3px rgba(26,86,232,.1);
    }

        .status-opt input:checked + .status-tile.proceso .status-tile-name {
            color: var(--accent);
        }

    .status-opt input:checked + .status-tile.resuelta {
        border-color: #22c55e;
        background: var(--ok-bg);
        box-shadow: 0 0 0 3px rgba(34,197,94,.1);
    }

        .status-opt input:checked + .status-tile.resuelta .status-tile-name {
            color: var(--ok-ink);
        }

    .si-pendiente {
        background: var(--amber-bg);
        color: var(--amber-acc);
    }

    .si-proceso {
        background: var(--accent-soft);
        color: var(--accent);
    }

    .si-resuelta {
        background: var(--ok-bg);
        color: #22c55e;
    }

    /* Hidden real select (model binding) */
    #estadoHidden {
        display: none;
    }

    /* ── Divider ── */
    .inc-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 28px 0;
    }

    /* ── Action row ── */
    .action-row {
        display: flex;
        gap: 10px;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 22px;
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--font-b);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        transition: var(--tr);
        white-space: nowrap;
    }

        .btn-cancel:hover {
            background: var(--surface-2);
            border-color: #c8d0dc;
            color: var(--ink);
        }

    .btn-submit {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 24px;
        border-radius: var(--r-lg);
        border: none;
        background: linear-gradient(135deg, var(--accent) 0%, #1647cc 100%);
        color: #ffffff;
        font-family: var(--font-b);
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: var(--tr);
        box-shadow: 0 4px 16px rgba(26,86,232,.3);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(26,86,232,.38);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit.loading {
            opacity: .75;
            pointer-events: none;
        }

        .btn-submit .spinner {
            display: none;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .btn-submit.loading .spinner {
            display: block;
        }

        .btn-submit.loading .btn-icon {
            display: none;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 480px) {
        .inc-head {
            padding: 22px 20px 18px;
        }

        .inc-body {
            padding: 24px 20px 28px;
        }

        .action-row {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="inc-shell">
    <div class="inc-panel">

        <!-- Back -->
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Volver a incidencias
        </a>

        <div class="inc-card">

            <!-- Header -->
            <div class="inc-head">
                <div class="inc-head-inner">
                    <div class="inc-head-icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <h1 class="inc-head-title">Nueva Incidencia</h1>
                        <p class="inc-head-sub">Registra un problema de mantenimiento en el condominio</p>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="inc-body">

                <form asp-action="Create" id="incForm" novalidate>

                    @Html.AntiForgeryToken()

                    <!-- Validation summary -->
                    <div asp-validation-summary="ModelOnly" class="val-summary">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div></div>
                    </div>

                    <!-- ══ SECCIÓN 1: Descripción ══ -->
                    <div class="sec-heading">
                        <i class="bi bi-file-text"></i>
                        Detalle del problema
                    </div>

                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-chat-left-text"></i>
                            Descripción
                        </div>
                        <textarea asp-for="Descripcion"
                                  class="f-control"
                                  rows="4"
                                  placeholder="Describe el problema o incidencia con el mayor detalle posible…"></textarea>
                        <span asp-validation-for="Descripcion" class="f-error"></span>
                    </div>

                    <!-- ══ SECCIÓN 2: Estado ══ -->
                    <div class="sec-heading">
                        <i class="bi bi-activity"></i>
                        Estado de la incidencia
                    </div>

                    <!-- Visual radio tiles -->
                    <div class="mb-4">
                        <div class="status-grid">

                            <label class="status-opt">
                                <input type="radio" name="_estadoRadio" value="Pendiente" checked onchange="syncEstado(this.value)">
                                <div class="status-tile pendiente">
                                    <div class="status-tile-icon si-pendiente">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                    <span class="status-tile-name">Pendiente</span>
                                </div>
                            </label>

                            <label class="status-opt">
                                <input type="radio" name="_estadoRadio" value="En Proceso" onchange="syncEstado(this.value)">
                                <div class="status-tile proceso">
                                    <div class="status-tile-icon si-proceso">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </div>
                                    <span class="status-tile-name">En Proceso</span>
                                </div>
                            </label>

                            <label class="status-opt">
                                <input type="radio" name="_estadoRadio" value="Resuelta" onchange="syncEstado(this.value)">
                                <div class="status-tile resuelta">
                                    <div class="status-tile-icon si-resuelta">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <span class="status-tile-name">Resuelta</span>
                                </div>
                            </label>

                        </div>

                        <!-- Hidden select for model binding -->
                        <select asp-for="Estado" id="estadoHidden" aria-hidden="true">
                            <option value="Pendiente">Pendiente</option>
                            <option value="En Proceso">En Proceso</option>
                            <option value="Resuelta">Resuelta</option>
                        </select>
                        <span asp-validation-for="Estado" class="f-error mt-2"></span>
                    </div>

                    <!-- ══ SECCIÓN 3: Fechas ══ -->
                    <div class="sec-heading">
                        <i class="bi bi-calendar3"></i>
                        Fechas
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="f-label">
                                <i class="bi bi-calendar-plus"></i>
                                Fecha de solicitud
                            </div>
                            <input asp-for="FechaSolicitud"
                                   type="date"
                                   class="f-control" />
                            <span asp-validation-for="FechaSolicitud" class="f-error"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="f-label">
                                <i class="bi bi-calendar-check"></i>
                                Fecha de cierre
                                <span class="f-optional">Opcional</span>
                            </div>
                            <input asp-for="FechaCierre"
                                   type="date"
                                   class="f-control" />
                            <span asp-validation-for="FechaCierre" class="f-error"></span>
                        </div>
                    </div>

                    <!-- ══ SECCIÓN 4: Asignación ══ -->
                    <div class="sec-heading">
                        <i class="bi bi-link-45deg"></i>
                        Asignación
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="f-label">
                                <i class="bi bi-door-open"></i>
                                Unidad habitacional
                            </div>
                            <div class="select-wrap">
                                <select asp-for="IdUnidad"
                                        class="f-control"
                                        asp-items="ViewBag.IdUnidad">
                                    <option value="">Selecciona una unidad…</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="f-label">
                                <i class="bi bi-person"></i>
                                Usuario responsable
                            </div>
                            <div class="select-wrap">
                                <select asp-for="IdUsuario"
                                        class="f-control"
                                        asp-items="ViewBag.IdUsuario">
                                    <option value="">Selecciona un usuario…</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="f-label">
                                <i class="bi bi-tools"></i>
                                Técnico asignado
                            </div>

                            <input asp-for="TecnicoAsignado"
                                   class="f-control"
                                   placeholder="Nombre del técnico asignado..." />

                            <span asp-validation-for="TecnicoAsignado"
                                  class="f-error"></span>
                        </div>
                    </div>

                    <hr class="inc-divider">

                    <!-- Actions -->
                    <div class="action-row">
                        <a asp-action="Index" class="btn-cancel">
                            <i class="bi bi-x"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn-submit" id="submitBtn">
                            <span class="spinner"></span>
                            <i class="bi bi-plus-circle-fill btn-icon"></i>
                            Guardar incidencia
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Sync radio tiles → hidden select (model binding)
        function syncEstado(val) {
            document.getElementById('estadoHidden').value = val;
        }
        // Init with default
        syncEstado('Pendiente');

        // Loading state on submit
        document.getElementById('incForm').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.classList.add('loading');
        });
    </script>
}
