@model PROTOTIPO.Models.Documento

@{
    ViewData["Title"] = "Eliminar Documento";
}

<div class="container py-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="fa-solid fa-trash me-2"></i>
                Eliminar Documento
            </h4>
        </div>


        <div class="card-body">

            <h5 class="fw-bold mb-3">
                ¿Está seguro que desea eliminar este documento?
            </h5>


            <div class="mb-3">

                <p>
                    <strong>Nombre:</strong>
                    @Model.Nombre
                </p>


                <p>
                    <strong>Tipo:</strong>
                    @Model.Tipo
                </p>


                <p>
                    <strong>Fecha subida:</strong>
                    @Model.FechaSubida?.ToString("dd/MM/yyyy")
                </p>


                @if (Model.IdUnidadNavigation != null)
                {
                    <p>
                        <strong>Unidad:</strong>
                        @Model.IdUnidadNavigation.Numero
                    </p>
                }

            </div>


            <div class="alert alert-warning">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                Esta acción eliminará permanentemente el archivo.
                No podrá recuperarse después.

            </div>



            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="IdDocumento" />


                <button type="submit"
                        class="btn btn-danger">

                    <i class="fa-solid fa-trash me-2"></i>
                    Eliminar

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary ms-2">

                    Cancelar

                </a>


            </form>


        </div>

    </div>

</div>