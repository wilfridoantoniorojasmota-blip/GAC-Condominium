@model IEnumerable<PROTOTIPO.Models.IncidenciaMantenimiento>

@{
    ViewData["Title"] = "Mis Incidencias";
}

<style>
    :root {
        --gac-primary: #258cfb;
        --gac-primary-dark: #1a6fd1;
        --gac-navy: #0f1623;
        --gac-success: #22c55e;
        --gac-warning: #f59e0b;
        --gac-danger: #ef4444;
        --gac-purple: #8b5cf6;
        --gac-bg: #f4f6fb;
    }

    .incidencias-page {
        background: var(--gac-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    /* HEADER */
    .page-header {
        background: linear-gradient(135deg, var(--gac-navy) 0%, #1a2436 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #fff;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 24px rgba(15, 22, 35, 0.15);
    }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .page-header p {
            color: rgba(255,255,255,0.65);
        }

    .btn-gac-primary {
        background: var(--gac-primary);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.6rem 1.25rem;
        transition: all 0.2s ease;
    }

        .btn-gac-primary:hover {
            background: var(--gac-primary-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 140, 251, 0.35);
        }

    /* FILTROS */
    .filter-pills {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-pill {
        border-radius: 50px;
        padding: 0.5rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .filter-pill:hover {
            border-color: var(--gac-primary);
            color: var(--gac-primary);
        }

        .filter-pill.active {
            background: var(--gac-primary);
            border-color: var(--gac-primary);
            color: #fff;
        }

        .filter-pill.filter-activas.active {
            background: var(--gac-warning);
            border-color: var(--gac-warning);
            color: #fff;
        }

        .filter-pill.filter-resueltas.active {
            background: var(--gac-success);
            border-color: var(--gac-success);
            color: #fff;
        }

    /* STAT CARDS */
    .stat-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eef1f6;
        padding: 1.25rem;
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15, 22, 35, 0.06);
        }

        .stat-card .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 0.35rem;
        }

        .stat-card .stat-value {
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--gac-navy);
        }

        .stat-card.accent-top {
            border-top: 4px solid var(--gac-primary);
        }

    /* CHART CARD */
    .chart-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .chart-card h5 {
            font-weight: 700;
            color: var(--gac-navy);
        }

    /* BADGES */
    .badge-estado {
        font-weight: 600;
        font-size: 0.78rem;
        padding: 0.4rem 0.85rem;
        border-radius: 50px;
        letter-spacing: 0.02em;
    }

    .badge-pendiente {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .badge-proceso {
        background: rgba(37, 140, 251, 0.12);
        color: var(--gac-primary-dark);
    }

    .badge-resuelta {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
    }

    .badge-cancelada {
        background: rgba(148, 163, 184, 0.15);
        color: #475569;
    }

    .badge-default {
        background: rgba(15, 22, 35, 0.08);
        color: var(--gac-navy);
    }

    /* INCIDENT CARDS */
    .incidencia-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eef1f6;
        height: 100%;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        overflow: hidden;
        position: relative;
    }

        .incidencia-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
            background: var(--gac-primary);
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .incidencia-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(15, 22, 35, 0.08);
            border-color: transparent;
        }

            .incidencia-card:hover::before {
                opacity: 1;
            }

        .incidencia-card .card-body {
            padding: 1.5rem;
        }

    .incidencia-desc {
        color: #334155;
        line-height: 1.65;
        font-size: 0.95rem;
        margin-bottom: 1.25rem;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .incidencia-fecha {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 500;
        padding-top: 0.75rem;
        border-top: 1px solid #f1f4f9;
    }

    .incidencia-card .card-footer {
        background: #fafbfd;
        border-top: 1px solid #eef1f6;
        padding: 1.1rem 1.5rem;
    }

    .btn-action {
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .btn-outline-primary.btn-action {
        border-color: var(--gac-primary);
        color: var(--gac-primary);
    }

        .btn-outline-primary.btn-action:hover {
            background: var(--gac-primary);
            color: #fff;
        }

    .btn-outline-warning.btn-action {
        border-color: var(--gac-warning);
        color: #b45309;
    }

        .btn-outline-warning.btn-action:hover {
            background: var(--gac-warning);
            color: #fff;
        }

    .btn-outline-danger.btn-action {
        border-color: var(--gac-danger);
        color: var(--gac-danger);
    }

        .btn-outline-danger.btn-action:hover {
            background: var(--gac-danger);
            color: #fff;
        }

    /* EMPTY STATE */
    .empty-state {
        background: #fff;
        border-radius: 16px;
        border: 1px dashed #d8e0ee;
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

        .empty-state i {
            font-size: 2.75rem;
            color: #cbd5e1;
            margin-bottom: 1rem;
        }

        .empty-state h5 {
            color: #64748b;
            font-weight: 600;
        }

    /* ALERT */
    .alert-gac-success {
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.25);
        color: #15803d;
        border-radius: 12px;
        font-weight: 500;
    }
</style>

<div class="incidencias-page">
    <div class="container py-4">

        <!-- HEADER -->
        <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="mb-1">Mis Incidencias</h3>
                <p class="mb-0">Reportes de mantenimiento realizados</p>
            </div>

            <a asp-action="Create" class="btn btn-gac-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Nueva Incidencia
            </a>
        </div>

        <!-- FILTROS -->
        <div class="filter-pills">
            <a asp-action="Index"
               class="filter-pill @(ViewBag.EstadoActual == null ? "active" : "")">
                Todas
            </a>

            <a asp-action="Index"
               asp-route-estado="Activas"
               class="filter-pill filter-activas @(ViewBag.EstadoActual == "Activas" ? "active" : "")">
                Activas
            </a>

            <a asp-action="Index"
               asp-route-estado="Resueltas"
               class="filter-pill filter-resueltas @(ViewBag.EstadoActual == "Resueltas" ? "active" : "")">
                Resueltas
            </a>
        </div>

        <!-- DASHBOARD POR ESTADO -->
        @if (ViewBag.PorEstado != null)
        {
            <div class="row mb-4 g-3">
                @foreach (var item in ViewBag.PorEstado)
                {
                    <div class="col-6 col-md-3">
                        <div class="stat-card accent-top">
                            <div class="stat-label">@item.Estado</div>
                            <div class="stat-value">@item.Total</div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- GRÁFICO POR MES -->
        @if (ViewBag.PorMes != null)
        {
            <div class="chart-card">
                <h5 class="mb-3">Evolución de incidencias</h5>
                @await Html.PartialAsync("_IncidenciasChart", (object)ViewBag.PorMes)
            </div>
        }

        <!-- SUCCESS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-gac-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        <!-- LISTADO -->
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-regular fa-clipboard"></i>
                <h5 class="mb-0">No tienes incidencias registradas</h5>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="incidencia-card d-flex flex-column">

                            <div class="card-body">
                                <!-- ESTADO -->
                                <div class="mb-2">
                                    @switch (item.Estado)
                                    {
                                        case "Pendiente":
                                            <span class="badge-estado badge-pendiente">Pendiente</span>
                                            break;
                                        case "En Proceso":
                                            <span class="badge-estado badge-proceso">En Proceso</span>
                                            break;
                                        case "Resuelta":
                                            <span class="badge-estado badge-resuelta">Resuelta</span>
                                            break;
                                        case "Cancelada":
                                            <span class="badge-estado badge-cancelada">Cancelada</span>
                                            break;
                                        default:
                                            <span class="badge-estado badge-default">@item.Estado</span>
                                            break;
                                    }
                                </div>

                                <!-- DESCRIPCIÓN -->
                                <p class="incidencia-desc mb-0">
                                    @item.Descripcion
                                </p>

                                <!-- FECHA -->
                                <div class="incidencia-fecha">
                                    <i class="fa-regular fa-clock"></i>
                                    @item.FechaSolicitud?.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                            <!-- ACCIONES -->
                            <div class="card-footer mt-auto">
                                <div class="d-flex gap-2 mb-2">
                                    <a asp-action="Details"
                                       asp-route-id="@item.IdIncidencia"
                                       class="btn btn-sm btn-outline-primary btn-action w-50">
                                        <i class="fa-regular fa-eye me-1"></i> Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdIncidencia"
                                       class="btn btn-sm btn-outline-warning btn-action w-50">
                                        <i class="fa-solid fa-pen me-1"></i> Editar
                                    </a>
                                </div>

                                <form asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@item.IdIncidencia" />
                                    <button class="btn btn-sm btn-outline-danger btn-action w-100"
                                            onclick="return confirm('¿Eliminar incidencia?')">
                                        <i class="fa-solid fa-trash me-1"></i> Eliminar
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
