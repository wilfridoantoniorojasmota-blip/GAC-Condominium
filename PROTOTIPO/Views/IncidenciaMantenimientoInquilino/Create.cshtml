@{
    ViewData["Title"] = "Reportar Incidencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0c1220;
        --ink-soft: #3d4a5c;
        --ink-muted: #7a8799;
        --surface: #f5f7fa;
        --surface-2: #ffffff;
        --border: #e4e9f0;
        --accent: #1a56e8;
        --accent-2: #0fd4b0;
        --accent-soft: #eff6ff;
        --amber-bg: #fffbeb;
        --amber-ink: #92400e;
        --amber-bdr: #fde68a;
        --amber-acc: #f59e0b;
        --no-bg: #fff1f0;
        --no-ink: #b91c1c;
        --no-bdr: #fecaca;
        --r-lg: 14px;
        --r-xl: 20px;
        --r-2xl: 28px;
        --r-pill: 999px;
        --shadow-lg: 0 20px 48px rgba(12,18,32,.13), 0 6px 16px rgba(12,18,32,.07);
        --tr: .2s cubic-bezier(.4,0,.2,1);
        --font-d: 'Sora', system-ui, sans-serif;
        --font-b: 'Inter', system-ui, sans-serif;
    }

    body {
        font-family: var(--font-b);
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Shell ── */
    .rep-shell {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 44px 20px 80px;
    }

    .rep-panel {
        width: 100%;
        max-width: 580px;
    }

    /* ── Back ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 26px;
        transition: color var(--tr);
    }

        .back-link:hover {
            color: var(--ink);
        }

    /* ── Card ── */
    .rep-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--r-2xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ── Header ── */
    .rep-head {
        position: relative;
        padding: 30px 36px 26px;
        background: var(--ink);
        overflow: hidden;
    }

        .rep-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 20px 20px;
            pointer-events: none;
        }

        .rep-head::after {
            content: '';
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15,212,176,.18) 0%, transparent 70%);
            right: -50px;
            top: -60px;
            pointer-events: none;
        }

    .rep-head-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .rep-head-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        flex-shrink: 0;
    }

    .rep-head-title {
        font-family: var(--font-d);
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.03em;
        margin: 0;
    }

    .rep-head-sub {
        font-size: .78rem;
        color: rgba(255,255,255,.5);
        margin: 3px 0 0;
    }

    /* ── Body ── */
    .rep-body {
        padding: 32px 36px 36px;
    }

    /* ── Error summary ── */
    .err-summary {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--no-bg);
        border: 1px solid var(--no-bdr);
        border-radius: var(--r-lg);
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: .855rem;
        color: var(--no-ink);
        font-weight: 500;
    }

        .err-summary i {
            flex-shrink: 0;
            margin-top: 1px;
            font-size: .95rem;
        }

    /* ── Field label ── */
    .f-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 8px;
    }

        .f-label i {
            font-size: .78rem;
            color: var(--accent);
        }

    .f-optional {
        font-size: .62rem;
        font-weight: 600;
        color: var(--accent-2);
        letter-spacing: .04em;
        margin-left: 4px;
    }

    /* ── Textarea ── */
    .f-textarea {
        width: 100%;
        padding: 14px 16px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        font-family: var(--font-b);
        font-size: .9rem;
        color: var(--ink);
        line-height: 1.7;
        resize: vertical;
        min-height: 130px;
        outline: none;
        transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
    }

        .f-textarea:focus {
            border-color: var(--accent);
            background: var(--surface-2);
            box-shadow: 0 0 0 3px rgba(26,86,232,.1);
        }

        .f-textarea::placeholder {
            color: var(--border);
        }

    /* Char counter */
    .char-counter {
        font-size: .72rem;
        color: var(--ink-muted);
        text-align: right;
        margin-top: 5px;
        transition: color var(--tr);
    }

        .char-counter.warn {
            color: var(--amber-acc);
        }

        .char-counter.limit {
            color: var(--no-ink);
            font-weight: 600;
        }

    /* ── Upload zone ── */
    .upload-zone {
        position: relative;
        border: 1.5px dashed var(--border);
        border-radius: var(--r-xl);
        padding: 28px 20px;
        text-align: center;
        background: var(--surface);
        cursor: pointer;
        transition: var(--tr);
    }

        .upload-zone:hover,
        .upload-zone.dragover {
            border-color: var(--accent);
            background: var(--accent-soft);
        }

        .upload-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

    .upload-icon-wrap {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--ink-muted);
        margin: 0 auto 11px;
        transition: var(--tr);
    }

    .upload-zone:hover .upload-icon-wrap,
    .upload-zone.dragover .upload-icon-wrap {
        background: #fff;
        border-color: #bfdbfe;
        color: var(--accent);
    }

    .upload-title {
        font-size: .875rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 3px;
    }

    .upload-sub {
        font-size: .77rem;
        color: var(--ink-muted);
    }

    /* Previews grid */
    .preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
        gap: 8px;
        margin-top: 12px;
    }

    .preview-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--surface);
    }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .preview-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(12,18,32,.6);
        border: none;
        color: #fff;
        font-size: .65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background var(--tr);
    }

        .preview-remove:hover {
            background: var(--no-acc);
        }

    /* ── Info notice ── */
    .info-notice {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--amber-bg);
        border: 1px solid var(--amber-bdr);
        border-radius: var(--r-lg);
        padding: 14px 16px;
        margin-bottom: 28px;
    }

        .info-notice i {
            color: var(--amber-acc);
            font-size: .95rem;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .info-notice p {
            font-size: .82rem;
            color: var(--amber-ink);
            line-height: 1.6;
            margin: 0;
        }

        .info-notice strong {
            font-weight: 700;
        }

    /* ── Steps indicator ── */
    .steps {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 28px;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

    .step-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .step.done .step-dot {
        background: var(--accent);
        color: #fff;
    }

    .step.active .step-dot {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 0 0 4px rgba(26,86,232,.15);
    }

    .step.idle .step-dot {
        background: var(--surface);
        border: 1.5px solid var(--border);
        color: var(--ink-muted);
    }

    .step-text {
        font-size: .75rem;
        font-weight: 600;
    }

    .step.done .step-text {
        color: var(--ink-soft);
    }

    .step.active .step-text {
        color: var(--accent);
    }

    .step.idle .step-text {
        color: var(--ink-muted);
    }

    .step-line {
        flex: 1;
        height: 1.5px;
        background: var(--border);
        margin: 0 6px;
    }

        .step-line.done {
            background: var(--accent);
        }

    /* ── Divider ── */
    .rep-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 24px;
    }

    /* ── Action row ── */
    .action-row {
        display: flex;
        gap: 10px;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 13px 20px;
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--font-b);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        transition: var(--tr);
        white-space: nowrap;
    }

        .btn-cancel:hover {
            background: var(--surface-2);
            border-color: #c8d0dc;
            color: var(--ink);
        }

    .btn-submit {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 24px;
        border-radius: var(--r-lg);
        border: none;
        background: linear-gradient(135deg, var(--accent) 0%, #1647cc 100%);
        color: #fff;
        font-family: var(--font-b);
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: var(--tr);
        box-shadow: 0 4px 16px rgba(26,86,232,.3);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(26,86,232,.38);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit.loading {
            opacity: .75;
            pointer-events: none;
        }

        .btn-submit .spinner {
            display: none;
            width: 15px;
            height: 15px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .btn-submit.loading .spinner {
            display: block;
        }

        .btn-submit.loading .btn-icon {
            display: none;
        }
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 480px) {
        .rep-head {
            padding: 22px 20px 18px;
        }

        .rep-body {
            padding: 22px 20px 26px;
        }

        .action-row {
            flex-direction: column-reverse;
        }

        .steps .step-text {
            display: none;
        }
    }
</style>

<div class="rep-shell">
    <div class="rep-panel">

        <!-- Back -->
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>

        <div class="rep-card">

            <!-- Header -->
            <div class="rep-head">
                <div class="rep-head-inner">
                    <div class="rep-head-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h1 class="rep-head-title">Reportar incidencia</h1>
                        <p class="rep-head-sub">Describe el problema para que el equipo de mantenimiento pueda atenderte</p>
                    </div>
                </div>
            </div>

            <div class="rep-body">

                <!-- Steps indicator -->
                <div class="steps">
                    <div class="step active">
                        <div class="step-dot">1</div>
                        <span class="step-text">Descripción</span>
                    </div>
                    <div class="step-line"></div>
                    <div class="step idle">
                        <div class="step-dot">2</div>
                        <span class="step-text">Revisión</span>
                    </div>
                    <div class="step-line"></div>
                    <div class="step idle">
                        <div class="step-dot">3</div>
                        <span class="step-text">Resolución</span>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="err-summary">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Create" method="post" enctype="multipart/form-data" id="repForm" novalidate>

                    @Html.AntiForgeryToken()

                    <!-- Description -->
                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-chat-left-text"></i>
                            Descripción del problema
                        </div>
                        <textarea name="descripcion"
                                  id="descTextarea"
                                  class="f-textarea"
                                  rows="5"
                                  maxlength="600"
                                  placeholder="Describe con detalle qué está ocurriendo, dónde y desde cuándo…"
                                  required></textarea>
                        <div class="char-counter" id="charCounter">0 / 600 caracteres</div>
                    </div>

                    <!-- Image upload -->
                    <div class="mb-4">
                        <div class="f-label">
                            <i class="bi bi-image"></i>
                            Fotografía del problema
                            <span class="f-optional">Opcional</span>
                        </div>

                        <div class="upload-zone" id="uploadZone">
                            <input type="file"
                                   name="imagenes"
                                   id="imageInput"
                                   accept="image/png,image/jpeg,image/webp"
                                   multiple>
                            <div class="upload-icon-wrap">
                                <i class="bi bi-camera-fill"></i>
                            </div>
                            <div class="upload-title">Toca aquí o arrastra una foto</div>
                            <div class="upload-sub">PNG, JPG o WEBP · Máx. 5 MB por imagen</div>
                        </div>

                        <div class="preview-grid" id="previewGrid"></div>
                    </div>

                    <!-- Info notice -->
                    <div class="info-notice">
                        <i class="bi bi-info-circle-fill"></i>
                        <p>Tu reporte será enviado al equipo de mantenimiento y quedará en estado <strong>Pendiente</strong> hasta que un técnico lo atienda.</p>
                    </div>

                    <hr class="rep-divider">

                    <!-- Actions -->
                    <div class="action-row">
                        <a asp-action="Index" class="btn-cancel">
                            <i class="bi bi-x"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn-submit" id="submitBtn">
                            <span class="spinner"></span>
                            <i class="bi bi-send-fill btn-icon"></i>
                            Enviar reporte
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        /* ── Char counter ── */
        const textarea = document.getElementById('descTextarea');
        const counter  = document.getElementById('charCounter');
        const MAX      = 600;

        textarea?.addEventListener('input', function () {
            const len = this.value.length;
            counter.textContent = `${len} / ${MAX} caracteres`;
            counter.className = 'char-counter' +
                (len >= MAX ? ' limit' : len >= MAX * .85 ? ' warn' : '');
        });

        /* ── Image previews ── */
        const zone    = document.getElementById('uploadZone');
        const input   = document.getElementById('imageInput');
        const grid    = document.getElementById('previewGrid');
        let   files   = [];

        zone?.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
        zone?.addEventListener('dragleave', () => zone.classList.remove('dragover'));
        zone?.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('dragover');
            addFiles([...e.dataTransfer.files]);
        });

            input?.addEventListener('change', function () {
        if (this.files.length === 0) return; // Evitar ciclos vacíos

        addFiles([...this.files]);

        // En lugar de vaciarlo inmediatamente, dejamos que 'renderPreviews'
        // tome el control absoluto del estado del input.
    });

    function addFiles(newFiles) {
        newFiles.forEach(f => {
            // Validación de tipo y tamaño (5MB)
            if (!f.type.startsWith('image/') || f.size > 5 * 1024 * 1024) return;

            // Evitar duplicados exactos (Opcional pero muy recomendado)
            if (!files.some(existing => existing.name === f.name && existing.size === f.size)) {
                files.push(f);
            }
        });
        renderPreviews();
    }

    function renderPreviews() {
        grid.innerHTML = '';
        if (!files.length) {
            input.value = ''; // Si no hay archivos, limpiamos el input por completo
            return;
        }

        files.forEach((f, i) => {
            const wrap = document.createElement('div');
            wrap.className = 'preview-item';

            const img = document.createElement('img');
            const reader = new FileReader();
            reader.onload = e => { img.src = e.target.result; };
            reader.readAsDataURL(f);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'preview-remove';
            btn.innerHTML = '<i class="bi bi-x"></i>';
            btn.title = 'Quitar imagen';
            btn.addEventListener('click', () => {
                files.splice(i, 1);
                renderPreviews(); // Esto volverá a actualizar el DataTransfer con el array reducido
            });

            wrap.appendChild(img);
            wrap.appendChild(btn);
            grid.appendChild(wrap);
        });

        // ── AQUÍ SINCROZAMOS DE FORMA SEGURA ──
        const dt = new DataTransfer();
        files.forEach(f => dt.items.add(f));

        // Forzamos al input a tener exactamente lo que está en nuestro array 'files'
        input.files = dt.files;
    }

        /* ── Submit loading ── */
        document.getElementById('repForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.classList.add('loading');
        });
    })();
</script>
